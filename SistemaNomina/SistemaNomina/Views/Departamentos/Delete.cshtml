@model SistemaNomina.Departamentos

@{
    ViewBag.Title = "Eliminar Departamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .delete-card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .warning-alert {
        background: rgba(220, 53, 69, 0.1);
        border-left: 4px solid #dc3545;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 8px;
    }

        .warning-alert h4 {
            color: #dc3545;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .warning-alert p {
            margin: 0;
            color: #721c24;
            line-height: 1.5;
        }

    .detail-row {
        display: flex;
        padding: 1.5rem;
        border-bottom: 1px solid #e7e8eb;
        background: #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        flex: 0 0 200px;
        font-weight: 600;
        color: #221d42;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        flex: 1;
        color: #495057;
        font-size: 1.1rem;
    }

    .badge-custom {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .badge-primary {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        color: white;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-danger-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
            color: white;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .dept-preview {
        background: rgba(220, 53, 69, 0.05);
        border: 1px solid rgba(220, 53, 69, 0.2);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .dept-icon-danger {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
            gap: 0.5rem;
        }

        .detail-label {
            flex: none;
        }

        .btn-danger-custom, .btn-secondary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }

        .dept-preview {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-trash-alt"></i> Eliminar Departamento</h1>
                <p class="mb-0">Confirma la eliminación del departamento seleccionado</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 900px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="warning-alert">
                <h4><i class="fas fa-exclamation-triangle"></i> ¿Estás seguro de que deseas eliminar este departamento?</h4>
                <p><strong>Esta acción no se puede deshacer.</strong> El departamento será eliminado permanentemente del sistema. Asegúrate de que no existan empleados asignados a este departamento antes de continuar.</p>
            </div>

            <div class="dept-preview">
                <div class="dept-icon-danger">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h4 style="color: #dc3545; margin-bottom: 0.5rem;">@Model.nombre</h4>
                    <p style="color: #6c757d; margin: 0;">Departamento que será eliminado</p>
                </div>
            </div>

            <div class="delete-card-custom">
                <div class="card-header bg-light p-4">
                    <h4 class="mb-0" style="color: #221d42; font-weight: 600;">
                        <i class="fas fa-info-circle"></i>
                        Información del departamento a eliminar
                    </h4>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-tag"></i>
                        Nombre del Departamento
                    </div>
                    <div class="detail-value">
                        <strong>@Html.DisplayFor(model => model.nombre)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-hashtag"></i>
                        ID del Departamento
                    </div>
                    <div class="detail-value">
                        <span class="badge-custom badge-primary">
                            <i class="fas fa-id-badge"></i>
                            @Html.DisplayFor(model => model.id_departamento)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        Fecha de Creación
                    </div>
                    <div class="detail-value">
                        @if (Model.fecha_creacion!= null)
                        {
                            <div>
                                <i class="fas fa-clock"></i>
                                @Model.fecha_creacion.Value.ToString("dddd, dd 'de' MMMM 'de' yyyy 'a las' HH:mm", new System.Globalization.CultureInfo("es-ES"))
                            </div>
                        }
                        else
                        {
                            <span style="color: #6c757d; font-style: italic;">No registrada</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-history"></i>
                        Última Actualización
                    </div>
                    <div class="detail-value">
                        @if (Model.fecha_actualizacion!= null)
                        {
                            <div>
                                <i class="fas fa-sync-alt"></i>
                                @Model.fecha_actualizacion.Value.ToString("dddd, dd 'de' MMMM 'de' yyyy 'a las' HH:mm", new System.Globalization.CultureInfo("es-ES"))
                            </div>
                        }
                        else
                        {
                            <span style="color: #6c757d; font-style: italic;">No registrada</span>
                        }
                    </div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn-danger-custom" onclick="return confirm('⚠️ CONFIRMACIÓN FINAL\n\n¿Estás completamente seguro de eliminar el departamento \" @Model.nombre \"?\n\nEsta acción es irreversible.');">
                        <i class="fas fa-trash-alt"></i> Eliminar Definitivamente
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-secondary-custom" })
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Agregar confirmación adicional para móviles
    $(document).ready(function() {
        $('form').on('submit', function(e) {
            if (!confirm('⚠️ ÚLTIMA CONFIRMACIÓN\n\n¿Realmente deseas eliminar el departamento "@Model.nombre"?\n\nEsta acción es irreversible y puede afectar a empleados asociados.')) {
                e.preventDefault();
                return false;
            }
        });
    });
</script>
