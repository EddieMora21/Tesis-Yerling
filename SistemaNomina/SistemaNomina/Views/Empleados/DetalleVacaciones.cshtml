@model SistemaNomina.Models.Empleados

@{
    ViewBag.Title = "Detalle de Vacaciones";
}

<style>
    .header-vacaciones {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin: -15px -15px 30px -15px;
        border-radius: 0 0 15px 15px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .vacaciones-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 30px;
    }

    .employee-info-header {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 30px;
        text-align: center;
    }

    .info-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #1788ca;
    }

    .alert-custom {
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        border: none;
    }

    .alert-danger-custom {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border-left: 4px solid #dc3545;
        color: #721c24;
    }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border-left: 4px solid #ffc107;
        color: #856404;
    }

    .detail-item {
        display: flex;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid #e7e8eb;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #221d42;
        width: 220px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #495057;
        font-weight: 500;
        font-size: 16px;
    }

        .detail-value.highlight {
            color: #28a745;
            font-weight: 700;
            font-size: 18px;
        }

    .detail-icon {
        margin-right: 10px;
        color: #1788ca;
        width: 25px;
        text-align: center;
    }

    .btn-secondary-custom {
        background: white;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 12px 24px;
        color: #221d42;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-secondary-custom:hover {
            background: #f8f9fa;
            border-color: #1788ca;
            color: #1788ca;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .vacation-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border: 2px solid #e7e8eb;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.15);
            border-color: #1788ca;
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #1788ca;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 500;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .vacaciones-card {
            padding: 20px 15px;
        }

        .header-vacaciones {
            padding: 1.5rem 0;
            margin: -15px -15px 20px -15px;
        }

        .detail-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            width: 100%;
            margin-bottom: 8px;
        }

        .vacation-stats {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .employee-info-header h4 {
            font-size: 1.2rem;
        }
    }
</style>

<div class="container" style="max-width: 900px;">
    <div class="header-vacaciones">
        <div class="container">
            <h2 class="mb-0">
                <i class="fa fa-calendar-check" style="font-size: 2rem; margin-right: 15px;"></i>
                Detalle de Vacaciones
            </h2>
            <p class="mb-0 mt-2" style="opacity: 0.9;">Información sobre el saldo y períodos vacacionales</p>
        </div>
    </div>

    <div class="vacaciones-card">
        @if (ViewBag.Error != null)
        {
            <div class="alert-custom alert-danger-custom">
                <h5>
                    <i class="fa fa-exclamation-circle" style="margin-right: 10px;"></i>
                    Error al consultar las vacaciones
                </h5>
                <p style="margin: 0;">@ViewBag.Error</p>
            </div>
        }
        else if (ViewBag.Mensaje != null)
        {
            <div class="alert-custom alert-warning-custom">
                <h5>
                    <i class="fa fa-info-circle" style="margin-right: 10px;"></i>
                    Información sobre vacaciones
                </h5>
                <p style="margin: 0;">@ViewBag.Mensaje</p>
            </div>
        }
        else
        {
            <div class="employee-info-header">
                <h4 class="mb-1">
                    <i class="fa fa-user" style="margin-right: 15px; font-size: 1.5rem;"></i>
                    @ViewBag.NombreEmpleado
                </h4>
                <p class="mb-0" style="opacity: 0.9;">
                    Resumen de vacaciones - Período @ViewBag.Periodo
                </p>
            </div>

            <div class="vacation-stats">
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.DiasAcumuladosPorLey</div>
                    <div class="stat-label">
                        <i class="fa fa-calendar-plus" style="margin-right: 5px;"></i>
                        Días Acumulados por Ley
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" style="color: #28a745;">@ViewBag.SaldoActual</div>
                    <div class="stat-label">
                        <i class="fa fa-calendar-check" style="margin-right: 5px;"></i>
                        Saldo Disponible
                    </div>
                </div>
            </div>

            <div class="info-section">
                <h4 style="color: #221d42; font-weight: 600; margin-bottom: 20px;">
                    <i class="fa fa-info-circle" style="margin-right: 10px; color: #1788ca;"></i>
                    Información Detallada
                </h4>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fa fa-user detail-icon"></i>
                        Nombre del Empleado:
                    </div>
                    <div class="detail-value">@ViewBag.NombreEmpleado</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fa fa-calendar detail-icon"></i>
                        Fecha de Ingreso:
                    </div>
                    <div class="detail-value">@ViewBag.FechaIngreso</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fa fa-calendar-alt detail-icon"></i>
                        Periodo de Vacaciones:
                    </div>
                    <div class="detail-value">@ViewBag.Periodo</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fa fa-plus-circle detail-icon"></i>
                        Días Acumulados por Ley:
                    </div>
                    <div class="detail-value">@ViewBag.DiasAcumuladosPorLey días</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fa fa-check-circle detail-icon" style="color: #28a745;"></i>
                        Saldo Actual Disponible:
                    </div>
                    <div class="detail-value highlight">@ViewBag.SaldoActual días</div>
                </div>
            </div>

            <div style="background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%); border-left: 4px solid #17a2b8; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                <h6 style="color: #0c5460; font-weight: 600; margin-bottom: 10px;">
                    <i class="fa fa-lightbulb" style="margin-right: 8px;"></i>
                    Información Importante
                </h6>
                <p style="color: #0c5460; margin: 0; font-size: 14px;">
                    • Los días de vacaciones se acumulan según la legislación laboral costarricense<br>
                    • El saldo disponible puede ser utilizado previa aprobación del supervisor<br>
                    • Para solicitar vacaciones, utilice el módulo correspondiente en el sistema
                </p>
            </div>
        }

        <div class="text-center" style="margin-top: 30px; padding-top: 20px; border-top: 2px solid #e7e8eb;">
            <a href="@Url.Action("Index", "Empleados")" class="btn-secondary-custom">
                <i class="fa fa-arrow-left" style="margin-right: 8px;"></i>
                Volver a la Lista
            </a>
        </div>
    </div>
</div>