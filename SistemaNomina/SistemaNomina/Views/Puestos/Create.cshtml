@model SistemaNomina.Puestos

@{
    ViewBag.Title = "Crear Puesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.2);
    }

    .page-header-custom h1 {
        margin: 0;
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .form-card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        width: 100%;
    }

    .form-control-custom:focus {
        border-color: #1788ca;
        box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
        outline: none;
    }

    .checkbox-custom {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        background: #f8f9fa;
        transition: all 0.3s ease;
    }

    .checkbox-custom:hover {
        border-color: #1788ca;
        background: rgba(23, 136, 202, 0.05);
    }

    .checkbox-custom input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #1788ca;
    }

    .checkbox-custom label {
        margin: 0;
        font-weight: 500;
        color: #221d42;
        cursor: pointer;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(23, 136, 202, 0.4);
        color: white;
    }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
        color: white;
        text-decoration: none;
    }

    .help-text {
        font-size: 0.875rem;
        color: #6c757d;
        font-style: italic;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-box {
        background: rgba(23, 136, 202, 0.1);
        border-left: 4px solid #1788ca;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .info-box h5 {
        color: #221d42;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .info-box p {
        margin: 0;
        color: #6c757d;
    }

    .alert {
        border-radius: 8px;
        border: none;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border-left: 4px solid #ffc107;
        color: #856404;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.1);
        border-left: 4px solid #dc3545;
        color: #721c24;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }

        .btn-primary-custom, .btn-secondary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-plus-circle"></i> Crear Puesto</h1>
                <p class="mb-0">Registra un nuevo puesto de trabajo en la organización</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 900px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="info-box">
                <h5><i class="fas fa-briefcase"></i> Nuevo Puesto de Trabajo</h5>
                <p>Complete toda la información para crear un nuevo puesto. Los campos marcados con * son obligatorios.</p>
            </div>

            <div class="form-card-custom">
                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.nombre_puesto, "Nombre del Puesto *", new { @class = "form-label-custom" })
                            @Html.EditorFor(model => model.nombre_puesto, new { htmlAttributes = new { @class = "form-control-custom", @placeholder = "Ej: Desarrollador Senior, Analista de Sistemas, Gerente de Ventas..." } })
                            @Html.ValidationMessageFor(model => model.nombre_puesto, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-info-circle"></i>
                                Ingresa un nombre descriptivo y específico para el puesto
                            </div>
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.id_departamento, "Departamento *", new { @class = "form-label-custom" })
                            @Html.DropDownList("id_departamento", null, "-- Seleccione Departamento --", new { @class = "form-control-custom", id = "departamentoSelect" })
                            @Html.ValidationMessageFor(model => model.id_departamento, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-building"></i>
                                Selecciona el departamento al que pertenecerá este puesto
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.salario_base, "Salario Base *", new { @class = "form-label-custom" })
                                @Html.EditorFor(model => model.salario_base, new { htmlAttributes = new { @class = "form-control-custom", @placeholder = "0.00", @type = "number", @step = "0.01", @min = "0", id = "salario_base" } })
                                @Html.ValidationMessageFor(model => model.salario_base, "", new { @class = "text-danger" })
                                <div class="help-text">
                                    <i class="fas fa-dollar-sign"></i>
                                    Salario base mensual en colones
                                </div>
                            </div>

                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.horas_jornada, "Horas de Jornada *", new { @class = "form-label-custom" })
                                @Html.EditorFor(model => model.horas_jornada, new { htmlAttributes = new { @class = "form-control-custom", @type = "number", @min = "1", @max = "24", @placeholder = "8", id = "horas_jornada" } })
                                @Html.ValidationMessageFor(model => model.horas_jornada, "", new { @class = "text-danger" })
                                <div class="help-text">
                                    <i class="fas fa-clock"></i>
                                    Horas diarias de trabajo (máximo 24)
                                </div>
                            </div>
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.descripcion, "Descripción del Puesto", new { @class = "form-label-custom" })
                            @Html.TextAreaFor(model => model.descripcion, new { @class = "form-control-custom", @rows = "4", @placeholder = "Describe las responsabilidades, funciones y requisitos del puesto..." })
                            @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-align-left"></i>
                                Detalla las responsabilidades y funciones principales
                            </div>
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.es_jefe, "Configuración de Jefatura", new { @class = "form-label-custom" })
                            <div class="checkbox-custom">
                                @Html.EditorFor(model => model.es_jefe, new { htmlAttributes = new { id = "esJefeCheckbox" } })
                                <label for="esJefeCheckbox">¿Este puesto tiene funciones de jefatura?</label>
                            </div>
                            @Html.ValidationMessageFor(model => model.es_jefe, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-crown"></i>
                                Solo puede haber un jefe por departamento
                            </div>

                            <!-- Alerta que aparece si ya hay un jefe en ese departamento -->
                            <div id="jefeExistenteAlert" class="alert alert-warning" style="display:none;">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Advertencia:</strong> Este departamento ya tiene un jefe asignado (<span id="nombreJefeActual"></span>).
                            </div>
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.id_horario, "Horario de Trabajo", new { @class = "form-label-custom" })
                            @Html.DropDownList("id_horario", null, "-- Seleccione Horario (Opcional) --", new { @class = "form-control-custom" })
                            @Html.ValidationMessageFor(model => model.id_horario, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-schedule"></i>
                                Horario específico para este puesto (opcional)
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mt-4">
                            <button type="submit" class="btn-primary-custom" id="submitButton">
                                <i class="fas fa-save"></i> Crear Puesto
                            </button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-secondary-custom" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function() {
            // Permite solo números y un punto en el campo de salario
            $('#salario_base').on('input', function() {
                this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');
            });

            // Permite solo números enteros en el campo de horas de jornada, máximo 24
            $('#horas_jornada').on('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (parseInt(this.value) > 24) this.value = '24';
            });

            // Verifica si ya hay un jefe en el departamento seleccionado
            $('#departamentoSelect, #esJefeCheckbox').change(function() {
                verificarJefatura();
            });

            function verificarJefatura() {
                var departamentoId = $('#departamentoSelect').val();
                var esJefe = $('#esJefeCheckbox').is(':checked');

                // Solo realiza la verificación si se seleccionó jefe y un departamento
                if (esJefe && departamentoId) {
                    $.get('@Url.Action("CheckJefeDepartamento", "Puestos")', {
                        departamentoId: departamentoId
                    }, function(data) {
                        if (data.existe) {
                            // Muestra advertencia y desmarca la casilla de jefe si ya existe uno
                            $('#jefeExistenteAlert').show();
                            $('#nombreJefeActual').text(data.nombreJefe);
                            $('#esJefeCheckbox').prop('checked', false);
                            $('#submitButton').prop('disabled', false);
                        } else {
                            // Oculta la advertencia si no existe jefe
                            $('#jefeExistenteAlert').hide();
                            $('#submitButton').prop('disabled', false);
                        }
                    }).fail(function() {
                        // Si falla la consulta, oculta la advertencia y permite guardar
                        $('#jefeExistenteAlert').hide();
                        $('#submitButton').prop('disabled', false);
                    });
                } else {
                    $('#jefeExistenteAlert').hide();
                    $('#submitButton').prop('disabled', false);
                }
            }

            // Validación final antes de enviar el formulario
            $('form').submit(function(e) {
                var departamentoId = $('#departamentoSelect').val();
                var esJefe = $('#esJefeCheckbox').is(':checked');

                // Si se marcó como jefe, hace verificación sincronizada
                if (esJefe && departamentoId) {
                    $('#submitButton').prop('disabled', true);

                    var existeJefe = false;

                    $.ajax({
                        url: '@Url.Action("CheckJefeDepartamento", "Puestos")',
                        data: { departamentoId: departamentoId },
                        async: false, // La solicitud es síncrona para detener el envío del formulario
                        success: function(data) {
                            existeJefe = data.existe;
                            if (existeJefe) {
                                $('#jefeExistenteAlert').show();
                                $('#nombreJefeActual').text(data.nombreJefe);
                                $('#esJefeCheckbox').prop('checked', false);
                                e.preventDefault(); // Detiene el envío
                            }
                        },
                        complete: function() {
                            $('#submitButton').prop('disabled', false);
                        }
                    });

                    if (existeJefe) {
                        return false;
                    }
                }
                return true;
            });
        });
    </script>
}
