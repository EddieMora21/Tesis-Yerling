@model SistemaNomina.Puestos

@{
    ViewBag.Title = "Detalles del Puesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.2);
    }

    .page-header-custom h1 {
        margin: 0;
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .details-card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .detail-header {
        background: rgba(23, 136, 202, 0.1);
        border-left: 4px solid #1788ca;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .job-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #1788ca 0%, #221d42 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .job-info h4 {
        color: #221d42;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .job-info p {
        margin: 0;
        color: #6c757d;
    }

    .detail-row {
        display: flex;
        padding: 1.5rem;
        border-bottom: 1px solid #e7e8eb;
        transition: all 0.3s ease;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-row:hover {
        background-color: rgba(23, 136, 202, 0.02);
    }

    .detail-label {
        flex: 0 0 200px;
        font-weight: 600;
        color: #221d42;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        flex: 1;
        color: #495057;
        font-size: 1.1rem;
    }

    .badge-custom {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .badge-primary {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        color: white;
    }

    .badge-success {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        color: white;
    }

    .badge-warning {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
    }

    .badge-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        color: white;
    }

    .salary-display {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 15px;
        font-size: 1.2rem;
        font-weight: 600;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .hours-display {
        background: rgba(23, 136, 202, 0.1);
        border: 1px solid rgba(23, 136, 202, 0.2);
        padding: 1rem;
        border-radius: 10px;
        text-align: center;
    }

    .hours-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1788ca;
    }

    .hours-label {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    .description-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1.5rem;
        border-left: 4px solid #1788ca;
        font-style: italic;
        line-height: 1.6;
    }

    .empty-description {
        color: #6c757d;
        font-style: italic;
        opacity: 0.7;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(250, 182, 27, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
            gap: 0.5rem;
        }

        .detail-label {
            flex: none;
        }

        .btn-primary-custom, .btn-secondary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }

        .detail-header {
            flex-direction: column;
            text-align: center;
        }

        .salary-display {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-eye"></i> Detalles del Puesto</h1>
                <p class="mb-0">Información completa del puesto seleccionado</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 900px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="detail-header">
                <div class="job-icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="job-info">
                    <h4>@Model.nombre_puesto</h4>
                    <p>Puesto ID: @Model.id_puesto | Departamento: @Html.DisplayFor(model => model.Departamentos.nombre)</p>
                </div>
            </div>

            <div class="details-card-custom">
                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-briefcase"></i>
                        Nombre del Puesto
                    </div>
                    <div class="detail-value">
                        <strong>@Html.DisplayFor(model => model.nombre_puesto)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-building"></i>
                        Departamento
                    </div>
                    <div class="detail-value">
                        <span class="badge-custom badge-primary">
                            <i class="fas fa-building"></i>
                            @Html.DisplayFor(model => model.Departamentos.nombre)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-dollar-sign"></i>
                        Salario Base
                    </div>
                    <div class="detail-value">
                        <div class="salary-display">
                            <i class="fas fa-money-bill-wave"></i>
                            ₡@Html.DisplayFor(model => model.salario_base)
                            <span style="font-size: 0.875rem; opacity: 0.9;">mensual</span>
                        </div>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-clock"></i>
                        Horas de Jornada
                    </div>
                    <div class="detail-value">
                        <div class="hours-display">
                            <div class="hours-number">@Html.DisplayFor(model => model.horas_jornada)</div>
                            <div class="hours-label">horas diarias</div>
                        </div>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-crown"></i>
                        Función de Jefatura
                    </div>
                    <div class="detail-value">
                        @if (Model.es_jefe == true)
                        {
                            <span class="badge-custom badge-warning">
                                <i class="fas fa-crown"></i>
                                Puesto de Jefatura
                            </span>
                        }
                        else
                        {
                            <span class="badge-custom badge-secondary">
                                <i class="fas fa-user"></i>
                                Puesto Operativo
                            </span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-schedule"></i>
                        Horario Asignado
                    </div>
                    <div class="detail-value">
                        @if (Model.Horarios != null)
                        {
                            <span class="badge-custom badge-success">
                                <i class="fas fa-clock"></i>
                                @Html.DisplayFor(model => model.Horarios.nombre)
                            </span>
                        }
                        else
                        {
                            <span style="color: #6c757d; font-style: italic;">
                                <i class="fas fa-exclamation-circle"></i>
                                Sin horario específico asignado
                            </span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-align-left"></i>
                        Descripción
                    </div>
                    <div class="detail-value">
                        @if (!string.IsNullOrEmpty(Model.descripcion))
                        {
                            <div class="description-box">
                                @Html.DisplayFor(model => model.descripcion)
                            </div>
                        }
                        else
                        {
                            <span class="empty-description">Sin descripción proporcionada</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        Fecha de Creación
                    </div>
                    <div class="detail-value">
                        @if (Model.fecha_creacion!= null)
                        {
                            <div>
                                <i class="fas fa-clock"></i>
                                @Model.fecha_creacion.Value.ToString("dddd, dd 'de' MMMM 'de' yyyy 'a las' HH:mm", new System.Globalization.CultureInfo("es-ES"))
                            </div>
                        }
                        else
                        {
                            <span style="color: #6c757d; font-style: italic;">No registrada</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-history"></i>
                        Última Actualización
                    </div>
                    <div class="detail-value">
                        @if (Model.fecha_actualizacion!= null)
                        {
                            <div>
                                <i class="fas fa-sync-alt"></i>
                                @Model.fecha_actualizacion.Value.ToString("dddd, dd 'de' MMMM 'de' yyyy 'a las' HH:mm", new System.Globalization.CultureInfo("es-ES"))
                            </div>
                        }
                        else
                        {
                            <span style="color: #6c757d; font-style: italic;">No registrada</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mt-4">
                @Html.ActionLink("Editar", "Edit", new { id = Model.id_puesto }, new { @class = "btn-primary-custom" })
                @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn-secondary-custom" })
            </div>
        </div>
    </div>
</div>
