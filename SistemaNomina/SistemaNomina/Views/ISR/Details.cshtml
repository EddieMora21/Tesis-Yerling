@model SistemaNomina.ISR
@{
    ViewBag.Title = "Detalles del Tramo ISR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #fd7e14;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .page-header-custom {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        box-shadow: var(--shadow-main);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .card-custom {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        border: 1px solid var(--neutral-color);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: flex-start;
        padding: 1rem 0;
        border-bottom: 1px solid var(--neutral-color);
        transition: var(--transition);
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background: rgba(23, 136, 202, 0.03);
            border-radius: var(--border-radius-sm);
            margin: 0 -1rem;
            padding-left: 2rem;
            padding-right: 2rem;
        }

    .detail-label {
        font-weight: 600;
        color: var(--primary-color);
        min-width: 220px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        flex: 1;
        color: var(--text-color);
        font-size: 1.1rem;
    }

        .detail-value strong {
            color: var(--primary-color);
        }

    .badge-year {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        color: var(--white);
        padding: 12px 20px;
        border-radius: 25px;
        font-size: 1.3rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .badge-percentage {
        background: linear-gradient(135deg, var(--success-color) 0%, #20a53a 100%);
        color: var(--white);
        padding: 10px 16px;
        border-radius: 25px;
        font-size: 1.2rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .currency-highlight {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        color: var(--secondary-color);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 1.1rem;
        font-weight: 600;
        border: 2px solid var(--secondary-color);
        display: inline-block;
    }

    .date-badge {
        background: linear-gradient(135deg, var(--neutral-color) 0%, #d6d8db 100%);
        color: var(--text-muted);
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-block;
    }

    .description-box {
        background: #f8f9fa;
        border-left: 4px solid var(--secondary-color);
        padding: 1.5rem;
        border-radius: var(--border-radius-sm);
        font-style: italic;
        line-height: 1.6;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--secondary-color) 0%, #0f6da3 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        font-weight: 600;
        color: var(--white);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 1rem;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        font-weight: 600;
        color: var(--white);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 117, 125, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .stats-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        text-align: center;
        border: 1px solid var(--neutral-color);
        margin-bottom: 1rem;
    }

    .stats-icon {
        font-size: 2.5rem;
        color: var(--accent-color);
        margin-bottom: 1rem;
    }

    .stats-title {
        font-size: 0.875rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }

    .stats-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary-color);
    }

    .calculation-example {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border-left: 4px solid var(--accent-color);
        padding: 1.5rem;
        border-radius: var(--border-radius-sm);
        margin-top: 1rem;
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

            .page-header-custom h1 {
                font-size: 1.8rem;
            }

        .card-custom {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            min-width: auto;
            margin-bottom: 0.5rem;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
            margin-bottom: 0.5rem;
            justify-content: center;
            margin-right: 0;
        }

        .stats-card {
            margin-bottom: 1rem;
        }
    }
</style>

<!-- Header de la página -->
<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-info-circle" style="font-size: 2rem; margin-right: 15px;"></i>
                    Detalles del Tramo ISR
                </h1>
                <p class="mb-0" style="opacity: 0.9; margin-top: 0.5rem;">
                    Información completa del tramo fiscal seleccionado
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Contenido principal -->
<div class="container" style="max-width: 1200px;">
    <div class="row">
        <!-- Información principal -->
        <div class="col-lg-8">
            <div class="card-custom">
                <h4 style="color: var(--primary-color); margin-bottom: 1.5rem; font-weight: 600;">
                    <i class="fas fa-clipboard-list"></i>
                    Información del Tramo Fiscal
                </h4>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-alt"></i>
                        Año Fiscal
                    </div>
                    <div class="detail-value">
                        <span class="badge-year">
                            <i class="fas fa-calendar"></i>
                            @Html.DisplayFor(model => model.anio)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-arrows-alt-h"></i>
                        Rango Salarial
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.limite_inferior) - ¢@Html.DisplayFor(model => model.limite_superior)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-percentage"></i>
                        Porcentaje de Impuesto
                    </div>
                    <div class="detail-value">
                        <span class="badge-percentage">
                            <i class="fas fa-calculator"></i>
                            @Html.DisplayFor(model => model.porcentaje)%
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-plus-circle"></i>
                        Exceso Base
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.exceso)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-child"></i>
                        Crédito por Hijo
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.credito_hijo)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-heart"></i>
                        Crédito por Cónyuge
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.credito_conyuge)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        Fecha de Creación
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_creacion)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-edit"></i>
                        Última Actualización
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_actualizacion)
                        </span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.descripcion))
            {
                <div class="card-custom">
                    <h4 style="color: var(--primary-color); margin-bottom: 1.5rem; font-weight: 600;">
                        <i class="fas fa-align-left"></i>
                        Descripción del Tramo
                    </h4>
                    <div class="description-box">
                        @Html.DisplayFor(model => model.descripcion)
                    </div>
                </div>
            }

            <!-- Ejemplo de cálculo -->
            
        </div>

        
    </div>

    <!-- Botones de acción -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            <hr style="margin: 2rem 0; border-color: var(--neutral-color);">
            @Html.ActionLink("Editar Tramo", "Edit", new { id = Model.id_isr }, new
            {
                @class = "btn btn-primary-custom"
            })
            @Html.ActionLink("Volver al Listado", "Index", null, new
            {
                @class = "btn btn-secondary-custom"
            })
        </div>
    </div>

    <!-- Información adicional -->
    <div class="mt-4 p-3" style="background: #e7f3ff; border-radius: 10px; border-left: 4px solid var(--secondary-color);">
        <h6 style="color: var(--primary-color); margin-bottom: 0.5rem;">
            <i class="fas fa-lightbulb text-info"></i>
            Información sobre este tramo de ISR
        </h6>
        <ul class="mb-0" style="font-size: 0.875rem; color: var(--text-muted);">
            <li>Este tramo aplica a salarios entre ¢@Html.DisplayFor(model => model.limite_inferior) y ¢@Html.DisplayFor(model => model.limite_superior)</li>
            <li>Se aplica un @Html.DisplayFor(model => model.porcentaje)% sobre el excedente del límite inferior</li>
            <li>Los créditos familiares reducen el impuesto final calculado</li>
            <li>Este tramo es válido para el año fiscal @Html.DisplayFor(model => model.anio)</li>
        </ul>
    </div>
</div>