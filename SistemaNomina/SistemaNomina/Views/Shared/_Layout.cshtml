                                <a href="/Nominas/Create" class="menu-link">
                                    <i class="fas fa-edit menu-icon"></i>
                                    <span>Crear Manual</span>
                                </a>
                            </div>

                            <a href="/TipoLiquidacion" class="menu-link">
                                <i class="fas fa-handshake menu-icon"></i>
                                <span>Tipos de Liquidación</span>
                            </a>
                            <a href="/Liquidaciones" class="menu-link">
                                <i class="fas fa-calculator menu-icon"></i>
                                <span>Cálculo de Liquidaciones</span>
                            </a>
                        </div>
                    </div>
                }

                <!-- Solicitudes - Para varios roles -->
                @if (RoleHelper.UserHasAnyRole("Admin", "RRHH", "Supervisor", "Empleado", "IT"))
                {
                    <div class="menu-item">
                        <a data-bs-toggle="collapse" href="#solicitudesMenu" role="button"
                           class="menu-link" aria-expanded="false" aria-controls="solicitudesMenu">
                            <i class="fas fa-file-alt menu-icon"></i>
                            <span>Solicitudes</span>
                            <i class="bi bi-chevron-down menu-toggle-icon"></i>
                        </a>
                        <div class="submenu collapse" id="solicitudesMenu">
                            <a href="/SolicitudesVacaciones" class="menu-link">
                                <i class="fas fa-paper-plane menu-icon"></i>
                                <span>Solicitud de Vacaciones</span>
                            </a>

                            @if (RoleHelper.UserHasAnyRole("Admin", "RRHH", "Empleado", "IT"))
                            {
                                <a href="/Incapacidades" class="menu-link">
                                    <i class="fas fa-notes-medical menu-icon"></i>
                                    <span>Solicitud de Incapacidad</span>
                                </a>
                            }

                            @if (RoleHelper.UserHasAnyRole("Admin", "RRHH", "Supervisor", "IT"))
                            {
                                <a href="/SolicitudesVacaciones/SolicitudesPendientes" class="menu-link">
                                    <i class="fas fa-hourglass-half menu-icon"></i>
                                    <span>Solicitudes Pendientes</span>
                                    <span class="menu-badge">3</span>
                                </a>
