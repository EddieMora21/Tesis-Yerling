@model SistemaNomina.TipoLiquidacion

@{
    ViewBag.Title = "Eliminar Tipo de Liquidación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Confirmar Eliminación
                    </h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning border-warning">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fa-2x text-warning me-3"></i>
                            <div>
                                <h5 class="alert-heading mb-1">¿Está seguro que desea eliminar este tipo de liquidación?</h5>
                                <p class="mb-0">Esta acción no se puede deshacer.</p>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-light">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-file-contract me-2"></i>
                                Información del Tipo de Liquidación
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <strong class="text-primary">
                                            <i class="fas fa-hashtag me-1"></i>
                                            ID:
                                        </strong>
                                        <span class="badge bg-primary ms-2">@Model.id_tipo</span>
                                    </div>

                                    <div class="mb-3">
                                        <strong class="text-success">
                                            <i class="fas fa-tag me-1"></i>
                                            @Html.DisplayNameFor(model => model.nombre):
                                        </strong>
                                        <br>
                                        <span class="h5 text-success">@Html.DisplayFor(model => model.nombre)</span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <strong class="text-info">
                                            <i class="fas fa-info-circle me-1"></i>
                                            @Html.DisplayNameFor(model => model.descripcion):
                                        </strong>
                                        <br>
                                        <span class="text-muted">
                                            @if (string.IsNullOrEmpty(Model.descripcion))
                                            {
                                                <text>Sin descripción</text>
                                            }
                                            else
                                            {
                                                @Model.descripcion
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar-plus me-1"></i>
                                        <strong>Creado:</strong> @Html.DisplayFor(model => model.fecha_creacion)
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar-edit me-1"></i>
                                        <strong>Actualizado:</strong> @Html.DisplayFor(model => model.fecha_actualizacion)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    @using (Html.BeginForm("Delete", "TipoLiquidacion", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>
                                Cancelar
                            </a>
                            <div>
                                <a href="@Url.Action("Details", new { id = Model.id_tipo })" class="btn btn-info me-2">
                                    <i class="fas fa-eye me-1"></i>
                                    Ver Detalles
                                </a>
                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está completamente seguro?')">
                                    <i class="fas fa-trash me-1"></i>
                                    Confirmar Eliminación
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>