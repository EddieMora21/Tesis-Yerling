@model SistemaNomina.TiposPermiso

@{
    ViewBag.Title = "Detalles del Tipo de Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .details-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        overflow: hidden;
        border: 1px solid #e7e8eb;
    }

    .details-header {
        background: linear-gradient(135deg, #1788ca 0%, #0f6da3 100%);
        padding: 1.5rem;
        border-bottom: 1px solid #e7e8eb;
        color: white;
    }

        .details-header h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
        }

    .details-body {
        padding: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid #e7e8eb;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #221d42;
        font-size: 1rem;
        min-width: 140px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        font-size: 1rem;
        color: #495057;
        margin-left: 2rem;
        flex: 1;
    }

    .permiso-name-display {
        font-size: 1.2rem;
        font-weight: 600;
        color: #221d42;
        background: linear-gradient(135deg, #e7e8eb, #f8f9fa);
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid #1788ca;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .permiso-icon-large {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        font-weight: bold;
    }

    .icon-con-goce {
        background: linear-gradient(135deg, #28a745, #20a53a);
    }

    .icon-sin-goce {
        background: linear-gradient(135deg, #dc3545, #c82333);
    }

    .badge-goce-large {
        padding: 10px 20px;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .goce-si {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .goce-no {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
    }

    .descripcion-display {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #1788ca;
        font-style: italic;
        line-height: 1.6;
    }

    .fecha-display {
        background: linear-gradient(135deg, #e7e8eb, #f8f9fa);
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 500;
        color: #495057;
        display: inline-block;
    }

    .button-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e7e8eb;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #fab61b 0%, #e09f15 100%);
        border: none;
        color: #221d42;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #e09f15 0%, #c8890f 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(250, 182, 27, 0.4);
            color: #221d42;
            text-decoration: none;
        }

    .btn-secondary-custom {
        background: #e7e8eb;
        border: 2px solid #e7e8eb;
        color: #221d42;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            background: #d6d8db;
            border-color: #d6d8db;
            color: #221d42;
            text-decoration: none;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem 0;
        }

        .page-title {
            font-size: 1.6rem;
        }

        .details-body {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .detail-label {
            min-width: auto;
        }

        .detail-value {
            margin-left: 0;
            width: 100%;
        }

        .button-group {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }

        .permiso-icon-large {
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
        }
    }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-eye me-3"></i>
            Detalles del Tipo de Permiso
        </h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="details-card">
                <div class="details-header">
                    <h4>
                        <i class="fas fa-info-circle me-2"></i>
                        Información Completa
                    </h4>
                </div>

                <div class="details-body">
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-tag"></i>
                            Nombre:
                        </div>
                        <div class="detail-value">
                            <div class="permiso-name-display">
                                <div class="permiso-icon-large @(Model.con_goce ? "icon-con-goce" : "icon-sin-goce")">
                                    @(Model.con_goce ? "CG" : "SG")
                                </div>
                                @Model.nombre
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-money-bill"></i>
                            Con Goce:
                        </div>
                        <div class="detail-value">
                            <span class="badge-goce-large @(Model.con_goce ? "goce-si" : "goce-no")">
                                <i class="fas @(Model.con_goce ? "fa-check" : "fa-times")"></i>
                                @(Model.con_goce ? "Con Goce de Salario" : "Sin Goce de Salario")
                            </span>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-align-left"></i>
                            Descripción:
                        </div>
                        <div class="detail-value">
                            <div class="descripcion-display">
                                @(Model.descripcion ?? "Sin descripción proporcionada")
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-calendar-plus"></i>
                            Fecha de Creación:
                        </div>
                        <div class="detail-value">
                            <div class="fecha-display">
                                @Model.fecha_creacion?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-calendar-edit"></i>
                            Última Actualización:
                        </div>
                        <div class="detail-value">
                            <div class="fecha-display">
                                @Model.fecha_actualizacion?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="button-group">
                        <a href="@Url.Action("Edit", new { id = Model.id_tipo_permiso })" class="btn-primary-custom">
                            <i class="fas fa-edit"></i>
                            Editar Tipo de Permiso
                        </a>
                        <a href="@Url.Action("Index")" class="btn-secondary-custom">
                            <i class="fas fa-arrow-left"></i>
                            Volver al Listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>