@model SistemaNomina.Models.CalculoLiquidacionViewModel

@{
    ViewBag.Title = "Calcular Liquidación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-calculator me-2"></i>
                            Calcular Liquidación Laboral
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver al Listado
                        </a>
                    </div>
                    <p class="mb-0 mt-2">
                        <small>Cálculo automático según el Código de Trabajo de Costa Rica</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
    </div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-user-plus me-2"></i>Datos del Empleado
                </h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("CalcularLiquidacion", "Liquidaciones", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label for="idEmpleado" class="form-label fw-bold">
                            <i class="fas fa-user me-1"></i>Empleado
                        </label>
                        @Html.DropDownList("idEmpleado", ViewBag.IdEmpleado as SelectList, "Seleccione un empleado...",
                            new { @class = "form-select", @required = "required" })
                        <div class="invalid-feedback">
                            Por favor seleccione un empleado.
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label for="idTipo" class="form-label fw-bold">
                            <i class="fas fa-tag me-1"></i>Tipo de Liquidación
                        </label>
                        @Html.DropDownList("idTipo", ViewBag.IdTipo as SelectList, "Seleccione el tipo...",
                            new { @class = "form-select", @required = "required" })
                        <div class="invalid-feedback">
                            Por favor seleccione el tipo de liquidación.
                        </div>
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Define qué conceptos aplican según el motivo de salida
                        </small>
                    </div>

                    <div class="form-group mb-3">
                        <label for="fechaSalida" class="form-label fw-bold">
                            <i class="fas fa-calendar me-1"></i>Fecha de Salida
                        </label>
                        <input type="date" name="fechaSalida" id="fechaSalida"
                               class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <div class="invalid-feedback">
                            Por favor ingrese la fecha de salida.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-calculator me-1"></i>Calcular Liquidación
                    </button>
                }
            </div>
        </div>

        @if (Model?.Calculo != null)
        {
            <div class="card mt-3 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Información del Empleado
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <p class="mb-2"><strong>Nombre:</strong> @Model.Calculo.NombreCompleto</p>
                            <p class="mb-2"><strong>Cédula:</strong> @Model.Calculo.Cedula</p>
                            <p class="mb-2"><strong>Fecha de Ingreso:</strong> @Model.Calculo.FechaIngreso.ToString("dd/MM/yyyy")</p>
                            <p class="mb-2"><strong>Fecha de Salida:</strong> @Model.Calculo.FechaSalida.ToString("dd/MM/yyyy")</p>
                            <p class="mb-0"><strong>Años Laborados:</strong> @Model.Calculo.AniosLaborados.ToString("F2")</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        @if (Model?.Calculo != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Cálculo de Liquidación
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Conceptos Positivos -->
                    <div class="table-responsive mb-4">
                        <table class="table-bordered table">
                            <thead class="table-success">
                                <tr>
                                    <th colspan="2" class="text-center">
                                        <i class="fas fa-plus-circle me-1"></i>CONCEPTOS A FAVOR
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Calculo.Preaviso > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-clock me-1"></i>Preaviso</td>
                                        <td class="fw-bold text-success text-end">
                                            ₡@Model.Calculo.Preaviso.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                @if (Model.Calculo.Cesantia > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-briefcase me-1"></i>Cesantía</td>
                                        <td class="fw-bold text-success text-end">
                                            ₡@Model.Calculo.Cesantia.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                @if (Model.Calculo.VacacionesPendientes > 0)
                                {
                                    <tr>
                                        <td>
                                            <i class="fas fa-umbrella-beach me-1"></i>
                                            Vacaciones Pendientes (@Model.Calculo.DiasVacacionesPendientes días)
                                        </td>
                                        <td class="fw-bold text-success text-end">
                                            ₡@Model.Calculo.VacacionesPendientes.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                @if (Model.Calculo.AguinaldoProporcional > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-gift me-1"></i>Aguinaldo Proporcional</td>
                                        <td class="fw-bold text-success text-end">
                                            ₡@Model.Calculo.AguinaldoProporcional.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                <tr class="table-success">
                                    <td class="fw-bold">
                                        <i class="fas fa-calculator me-1"></i>SUBTOTAL
                                    </td>
                                    <td class="fw-bold text-end">
                                        ₡@Model.Calculo.SalarioBruto.ToString("N2")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Deducciones -->
                    <div class="table-responsive mb-4">
                        <table class="table-bordered table">
                            <thead class="table-warning">
                                <tr>
                                    <th colspan="2" class="text-center">
                                        <i class="fas fa-minus-circle me-1"></i>DEDUCCIONES LEGALES
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Calculo.CCSS > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-heart me-1"></i>CCSS (10.67%)</td>
                                        <td class="fw-bold text-warning text-end">
                                            -₡@Model.Calculo.CCSS.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                @if (Model.Calculo.IVM > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-user-shield me-1"></i>IVM (4.17%)</td>
                                        <td class="fw-bold text-warning text-end">
                                            -₡@Model.Calculo.IVM.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                @if (Model.Calculo.ISR > 0)
                                {
                                    <tr>
                                        <td><i class="fas fa-percentage me-1"></i>Impuesto sobre la Renta</td>
                                        <td class="fw-bold text-warning text-end">
                                            -₡@Model.Calculo.ISR.ToString("N2")
                                        </td>
                                    </tr>
                                }

                                <tr class="table-warning">
                                    <td class="fw-bold">
                                        <i class="fas fa-calculator me-1"></i>TOTAL DEDUCCIONES
                                    </td>
                                    <td class="fw-bold text-end">
                                        -₡@Model.Calculo.TotalDeducciones.ToString("N2")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Total Final -->
                    <div class="table-responsive">
                        <table class="table-bordered table">
                            <tbody>
                                <tr class="table-dark">
                                    <td class="fw-bold h5 mb-0">
                                        <i class="fas fa-money-bill-wave me-1"></i>TOTAL A PAGAR
                                    </td>
                                    <td class="fw-bold h4 mb-0 text-primary text-end">
                                        ₡@Model.Calculo.TotalLiquidacion.ToString("N2")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Acciones -->
                    <div class="mt-4 text-center">
                        @using (Html.BeginForm("GuardarLiquidacion", "Liquidaciones", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Calculo.IdEmpleado)
                            @Html.HiddenFor(m => m.Calculo.IdTipo)
                            @Html.HiddenFor(m => m.Calculo.FechaSalida)
                            @Html.HiddenFor(m => m.Calculo.Preaviso)
                            @Html.HiddenFor(m => m.Calculo.Cesantia)
                            @Html.HiddenFor(m => m.Calculo.VacacionesPendientes)
                            @Html.HiddenFor(m => m.Calculo.DiasVacacionesPendientes)
                            @Html.HiddenFor(m => m.Calculo.AguinaldoProporcional)
                            @Html.HiddenFor(m => m.Calculo.TotalLiquidacion)
                            @Html.HiddenFor(m => m.Calculo.ISR)
                            @Html.HiddenFor(m => m.Calculo.CCSS)
                            @Html.HiddenFor(m => m.Calculo.IVM)

                            <button type="submit" class="btn btn-success btn-lg me-2" onclick="return confirm('¿Está seguro de guardar esta liquidación? Esta acción no se puede deshacer.')">
                                <i class="fas fa-save me-1"></i>Guardar Liquidación
                            </button>
                        }

                        <a href="@Url.Action("CalcularLiquidacion")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-redo me-1"></i>Calcular Otra
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body py-5 text-center">
                    <i class="fas fa-calculator fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">Calculadora de Liquidaciones</h5>
                    <p class="text-muted">
                        Completa los datos del empleado en el panel izquierdo para iniciar el cálculo automático
                        de la liquidación laboral según la legislación costarricense.
                    </p>
                    <div class="mt-4">
                        <h6 class="text-primary">El cálculo incluye:</h6>
                        <ul class="list-unstyled d-inline-block text-start">
                            <li><i class="fas fa-check text-success me-1"></i>Preaviso (según tipo)</li>
                            <li><i class="fas fa-check text-success me-1"></i>Cesantía (según años laborados)</li>
                            <li><i class="fas fa-check text-success me-1"></i>Vacaciones pendientes</li>
                            <li><i class="fas fa-check text-success me-1"></i>Aguinaldo proporcional</li>
                            <li><i class="fas fa-check text-success me-1"></i>Deducciones legales (CCSS, IVM, ISR)</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Validación: Solo números para campos monetarios
            $('.only-numbers').on('input', function () {
                var value = $(this).val();
                var regex = /^[0-9]*\.?[0-9]*$/;

                if (!regex.test(value)) {
                    var newValue = value.replace(/[^0-9\.]/g, '');
                    $(this).val(newValue);

                    if (!$(this).next('.validation-error').length) {
                        $(this).after('<div class="validation-error text-danger small">Solo se permiten números</div>');
                        setTimeout(function () {
                            $('.validation-error').fadeOut(function () {
                                $(this).remove();
                            });
                        }, 3000);
                    }
                }
            });

            // Validación del formulario
            $('.needs-validation').on('submit', function (e) {
                var isValid = true;

                // Validar empleado
                var empleado = $('#idEmpleado').val();
                if (!empleado || empleado === '') {
                    isValid = false;
                    $('#idEmpleado').addClass('is-invalid');
                    mostrarError('Por favor seleccione un empleado');
                } else {
                    $('#idEmpleado').removeClass('is-invalid').addClass('is-valid');
                }

                // Validar tipo
                var tipo = $('#idTipo').val();
                if (!tipo || tipo === '') {
                    isValid = false;
                    $('#idTipo').addClass('is-invalid');
                    mostrarError('Por favor seleccione un tipo de liquidación');
                } else {
                    $('#idTipo').removeClass('is-invalid').addClass('is-valid');
                }

                // Validar fecha
                var fecha = $('#fechaSalida').val();
                if (!fecha || fecha === '') {
                    isValid = false;
                    $('#fechaSalida').addClass('is-invalid');
                    mostrarError('Por favor ingrese una fecha de salida');
                } else {
                    var fechaSeleccionada = new Date(fecha);
                    var fechaHoy = new Date();

                    if (fechaSeleccionada > fechaHoy) {
                        isValid = false;
                        $('#fechaSalida').addClass('is-invalid');
                        mostrarError('La fecha de salida no puede ser mayor a hoy');
                    } else {
                        $('#fechaSalida').removeClass('is-invalid').addClass('is-valid');
                    }
                }

                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                // Mostrar loading
                $(this).find('button[type="submit"]').prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-1"></i>Calculando...');

                $(this).addClass('was-validated');
            });

            // Confirmación para guardar liquidación
            $('form[action*="GuardarLiquidacion"]').on('submit', function (e) {
                if (!confirm('¿Está seguro de guardar esta liquidación?\n\nEsta acción:\n• Guardará la liquidación permanentemente\n• Cambiará el estado del empleado a "Inactivo"\n• No se puede deshacer\n\n¿Continuar?')) {
                    e.preventDefault();
                    return false;
                }

                // Mostrar loading
                $(this).find('button[type="submit"]').prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-1"></i>Guardando...');
            });

            // Limpiar validación al cambiar valores
            $('#idEmpleado, #idTipo, #fechaSalida').on('change', function () {
                $(this).removeClass('is-invalid is-valid');
                $('.alert-danger').hide();
            });
        });

        function mostrarError(mensaje) {
            // Remover alertas anteriores
            $('.alert-danger').remove();

            // Crear nueva alerta
            var alerta = '<div class="alert alert-danger alert-dismissible fade show">' +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '<i class="fas fa-exclamation-triangle me-2"></i>' + mensaje +
                '</div>';

            $('.container-fluid').first().after(alerta);

            // Auto-hide después de 5 segundos
            setTimeout(function () {
                $('.alert-danger').fadeOut();
            }, 5000);
        }
    </script>
}