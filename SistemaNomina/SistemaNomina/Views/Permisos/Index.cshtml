@model IEnumerable<SistemaNomina.Permisos>

@{
    ViewBag.Title = "Gestión de Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(34, 29, 66, 0.2);
    }

    .page-header-custom h1 {
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .page-header-custom p {
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .filters-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .filter-label {
        font-weight: 600;
        color: #221d42;
    }

    .filter-select, .filter-input {
        padding: 0.75rem 1rem;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .filter-select:focus, .filter-input:focus {
        outline: none;
        border-color: #1788ca;
        box-shadow: 0 0 0 3px rgba(23, 136, 202, 0.1);
    }

    .btn-filter {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.4);
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(23, 136, 202, 0.3);
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.4);
        color: white;
        text-decoration: none;
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    /* ✅ TABLA MEJORADA */
    .table-container {
        overflow-x: auto;
        border-radius: 15px;
    }

    .table-custom {
        margin: 0;
        width: 100%;
        min-width: 1200px; /* Ancho mínimo para evitar compresión */
        table-layout: fixed; /* Fija las columnas */
    }

    .table-custom thead {
        background: #221d42;
        color: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .table-custom thead th {
        border: none;
        padding: 1rem 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    /* ✅ ANCHOS ESPECÍFICOS DE COLUMNAS */
    .table-custom .col-empleado { width: 200px; }
    .table-custom .col-fecha { width: 110px; }
    .table-custom .col-horas { width: 80px; }
    .table-custom .col-tipo { width: 150px; }
    .table-custom .col-motivo { width: 200px; }
    .table-custom .col-estado { width: 120px; }
    .table-custom .col-aprobado { width: 130px; }
    .table-custom .col-acciones { width: 200px; }

    .table-custom tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid #e7e8eb;
    }

    .table-custom tbody tr:hover {
        background-color: rgba(23, 136, 202, 0.05);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .table-custom td {
        padding: 1rem 0.75rem;
        border: none;
        vertical-align: middle;
        word-wrap: break-word;
        overflow: hidden;
    }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .employee-avatar {
        width: 35px;
        height: 35px;
        background: linear-gradient(135deg, #1788ca 0%, #221d42 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.9rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .employee-details {
        min-width: 0;
        flex: 1;
    }

    .employee-details h6 {
        margin: 0;
        font-weight: 600;
        color: #221d42;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .employee-id {
        font-size: 0.7rem;
        color: #6c757d;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-badge {
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        display: inline-block;
    }

    .status-pendiente {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
    }

    .status-aprobado {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .status-rechazado {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    /* ✅ BOTONES DE ACCIÓN MEJORADOS */
    .actions-group {
        display: flex;
        gap: 0.3rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action-custom {
        padding: 0.4rem 0.6rem;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        min-width: 35px;
        height: 32px;
        position: relative;
    }

    .btn-action-custom i {
        font-size: 0.8rem;
    }

    .btn-details {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
    }

    .btn-edit {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    .btn-approve {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .btn-reject {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    .btn-action-custom:hover {
        transform: translateY(-2px);
        text-decoration: none;
        color: white;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    /* ✅ TOOLTIP PARA BOTONES */
    .btn-action-custom::after {
        content: attr(title);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: white;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-size: 0.7rem;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 1000;
        margin-bottom: 5px;
    }

    .btn-action-custom:hover::after {
        opacity: 1;
        visibility: visible;
    }

    /* ✅ TRUNCAR TEXTO LARGO */
    .text-truncate-custom {
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: help;
    }

    .tipo-permiso {
        color: #1788ca;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .fecha-info {
        font-weight: 600;
        color: #221d42;
        font-size: 0.9rem;
    }

    .horas-info {
        font-weight: 600;
        color: #e67e22;
        font-size: 0.9rem;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #28a745;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-error {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #dc3545;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #e7e8eb;
    }

    /* ✅ RESPONSIVE MEJORADO */
    @@media (max-width: 768px) {
        .filters-grid {
            grid-template-columns: 1fr;
        }

        .table-custom {
            min-width: 800px;
        }

        .actions-group {
            flex-direction: column;
            gap: 0.2rem;
        }

        .btn-action-custom {
            width: 100%;
            justify-content: center;
        }

        .employee-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.3rem;
        }

        .employee-avatar {
            width: 30px;
            height: 30px;
        }
    }

    @@media (max-width: 480px) {
        .container {
            max-width: 100% !important;
            padding: 0 10px;
        }

        .filters-container {
            padding: 1rem;
        }

        .page-header-custom {
            padding: 1rem 0;
        }
    }
</style>

<!-- Mensajes de alerta -->
@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-clipboard-list"></i> Gestión de Permisos</h1>
                <p class="mb-0">Administra las solicitudes de permisos del personal</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1400px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Filtros -->
            <div class="filters-container">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label class="filter-label">Filtrar por Estado:</label>
                        <select id="filtroEstado" class="filter-select">
                            <option value="">Todos los estados</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="aprobado">Aprobado</option>
                            <option value="rechazado">Rechazado</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Filtrar por Tipo:</label>
                        <select id="filtroTipo" class="filter-select">
                            <option value="">Todos los tipos</option>
                            @foreach (var tipo in ViewBag.TiposPermiso as IEnumerable<SistemaNomina.TiposPermiso> ?? Enumerable.Empty<SistemaNomina.TiposPermiso>())
                            {
                                <option value="@tipo.nombre.ToLower()">@tipo.nombre</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Buscar:</label>
                        <input type="text" id="filtroEmpleado" class="filter-input" placeholder="Buscar por empleado o motivo..."
                               oninput="validarSoloLetras(this)" onkeypress="return validarTeclaLetras(event)">
                    </div>

                    <div class="filter-group">
                        <button id="limpiarFiltros" class="btn-filter">
                            <i class="fas fa-broom"></i> Limpiar
                        </button>
                    </div>
                </div>

                <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #6c757d;">
                        <i class="fas fa-info-circle"></i>
                        Mostrando <strong id="registrosVisibles">@Model.Count()</strong> de <strong>@Model.Count()</strong> registros
                    </span>
                    @Html.ActionLink("Nuevo Permiso", "Create", null, new { @class = "btn-primary-custom" })
                </div>
            </div>

            <!-- ✅ TABLA MEJORADA -->
            <div class="card-custom">
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-container">
                            <table class="table-custom table" id="tablaPermisos">
                                <thead>
                                    <tr>
                                        <th class="col-empleado"><i class="fas fa-user"></i> Empleado</th>
                                        <th class="col-fecha"><i class="fas fa-calendar"></i> Fecha</th>
                                        <th class="col-horas"><i class="fas fa-clock"></i> Horas</th>
                                        <th class="col-tipo"><i class="fas fa-tag"></i> Tipo</th>
                                        <th class="col-motivo"><i class="fas fa-comment"></i> Motivo</th>
                                        <th class="col-estado"><i class="fas fa-info-circle"></i> Estado</th>
                                        <th class="col-aprobado"><i class="fas fa-user-check"></i> Aprobado por</th>
                                        <th class="col-acciones"><i class="fas fa-cogs"></i> Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="permiso-row"
                                            data-estado="@item.Estados.nombre.ToLower()"
                                            data-tipo="@item.TiposPermiso.nombre.ToLower()">
                                            <td class="col-empleado">
                                                <div class="employee-info">
                                                    <div class="employee-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="employee-details">
                                                        <h6 title="@item.Empleados.nombre1 @item.Empleados.apellido1">
                                                            @item.Empleados.nombre1 @item.Empleados.apellido1
                                                        </h6>
                                                        <p class="employee-id" title="@item.Empleados.cedula">
                                                            @item.Empleados.cedula
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="col-fecha">
                                                <span class="fecha-info">@item.fecha.ToString("dd/MM/yyyy")</span>
                                            </td>
                                            <td class="col-horas">
                                                <span class="horas-info">@item.horas h</span>
                                            </td>
                                            <td class="col-tipo">
                                                <span class="tipo-permiso" title="@item.TiposPermiso.nombre">
                                                    @(item.TiposPermiso.nombre.Length > 15 ? item.TiposPermiso.nombre.Substring(0, 15) + "..." : item.TiposPermiso.nombre)
                                                </span>
                                            </td>
                                            <td class="col-motivo">
                                                <span class="text-truncate-custom" title="@item.motivo">
                                                    @(item.motivo.Length > 30 ? item.motivo.Substring(0, 30) + "..." : item.motivo)
                                                </span>
                                            </td>
                                            <td class="col-estado">
                                                @{
                                                    var estadoClass = item.Estados.nombre.ToLower() == "pendiente" ? "status-pendiente" :
                                                                     item.Estados.nombre.ToLower() == "aprobado" ? "status-aprobado" : "status-rechazado";
                                                }
                                                <span class="status-badge @estadoClass">
                                                    @item.Estados.nombre
                                                </span>
                                            </td>
                                            <td class="col-aprobado">
                                                @if (item.Usuarios != null)
                                                {
                                                    <span title="@item.Usuarios.usuario">
                                                        @(item.Usuarios.usuario.Length > 12 ? item.Usuarios.usuario.Substring(0, 12) + "..." : item.Usuarios.usuario)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="col-acciones">
                                                <div class="actions-group">
                                                    @Html.ActionLink("Detalles", "Details", new { id = item.id_permiso }, new
                                                    {
                                                        @class = "btn-action-custom btn-details",
                                                        title = "Ver detalles",
                                                        @style = "text-decoration: none;"
                                                    })
                                                    <script>
                                                        document.addEventListener('DOMContentLoaded', function() {
                                                            const detailsBtn = document.querySelector('a[href*="Details/@item.id_permiso"]');
                                                            if (detailsBtn) detailsBtn.innerHTML = '<i class="fas fa-eye"></i>';
                                                        });
                                                    </script>

                                                    @if (item.Estados.nombre.ToLower() == "pendiente")
                                                    {
                                                        @Html.ActionLink("Editar", "Edit", new { id = item.id_permiso }, new
                                                        {
                                                            @class = "btn-action-custom btn-edit",
                                                            title = "Editar",
                                                            @style = "text-decoration: none;"
                                                        })
                                                        <script>
                                                            document.addEventListener('DOMContentLoaded', function() {
                                                                const editBtn = document.querySelector('a[href*="Edit/@item.id_permiso"]');
                                                                if (editBtn) editBtn.innerHTML = '<i class="fas fa-edit"></i>';
                                                            });
                                                        </script>

                                                        <button class="btn-action-custom btn-approve" onclick="cambiarEstado(@item.id_permiso, 'aprobar')" title="Aprobar">
                                                            <i class="fas fa-check"></i>
                                                        </button>

                                                        <button class="btn-action-custom btn-reject" onclick="cambiarEstado(@item.id_permiso, 'rechazar')" title="Rechazar">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    }

                                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.id_permiso }, new
                                                    {
                                                        @class = "btn-action-custom btn-delete",
                                                        title = "Eliminar",
                                                        @style = "text-decoration: none;"
                                                    })
                                                    <script>
                                                        document.addEventListener('DOMContentLoaded', function() {
                                                            const deleteBtn = document.querySelector('a[href*="Delete/@item.id_permiso"]');
                                                            if (deleteBtn) deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                                                        });
                                                    </script>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-clipboard-list"></i>
                            <h5>No hay permisos registrados</h5>
                            <p>Comienza creando el primer permiso del sistema</p>
                            @Html.ActionLink("Crear Permiso", "Create", null, new { @class = "btn-primary-custom" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ✅ VALIDACIONES DE INPUT - Solo letras para búsqueda
    function validarTeclaLetras(event) {
        const key = event.key;
        // Permitir letras, espacios, acentos y teclas de control
        if (!/[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/.test(key) &&
            !['Backspace', 'Delete', 'Tab', 'Enter', 'ArrowLeft', 'ArrowRight'].includes(key)) {
            event.preventDefault();
            return false;
        }
        return true;
    }

    function validarSoloLetras(input) {
        // Remover caracteres no válidos del valor
        input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Elementos del DOM
        const filtroEstado = document.getElementById('filtroEstado');
        const filtroTipo = document.getElementById('filtroTipo');
        const filtroEmpleado = document.getElementById('filtroEmpleado');
        const limpiarFiltros = document.getElementById('limpiarFiltros');
        const registrosVisibles = document.getElementById('registrosVisibles');
        const permisoRows = document.querySelectorAll('.permiso-row');

        // Función para filtrar tabla
        function filtrarTabla() {
            const estadoSeleccionado = filtroEstado.value.toLowerCase();
            const tipoSeleccionado = filtroTipo.value.toLowerCase();
            const busqueda = filtroEmpleado.value.toLowerCase();
            let contadorVisibles = 0;

            permisoRows.forEach(function (row) {
                const estado = row.getAttribute('data-estado');
                const tipo = row.getAttribute('data-tipo');
                const empleado = row.querySelector('.employee-details h6').textContent.toLowerCase();
                const motivo = row.querySelector('.col-motivo').textContent.toLowerCase();

                let mostrar = true;

                // Filtro por estado
                if (estadoSeleccionado && estado !== estadoSeleccionado) {
                    mostrar = false;
                }

                // Filtro por tipo
                if (tipoSeleccionado && tipo !== tipoSeleccionado) {
                    mostrar = false;
                }

                // Filtro por búsqueda (empleado o motivo)
                if (busqueda && !empleado.includes(busqueda) && !motivo.includes(busqueda)) {
                    mostrar = false;
                }

                if (mostrar) {
                    row.style.display = '';
                    contadorVisibles++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Actualizar contador
            registrosVisibles.textContent = contadorVisibles;
        }

        // Event listeners para filtros
        filtroEstado.addEventListener('change', filtrarTabla);
        filtroTipo.addEventListener('change', filtrarTabla);
        filtroEmpleado.addEventListener('input', filtrarTabla);

        // Limpiar filtros
        limpiarFiltros.addEventListener('click', function () {
            filtroEstado.value = '';
            filtroTipo.value = '';
            filtroEmpleado.value = '';
            filtrarTabla();
        });
    });

    // Función para cambiar estado de permiso
    function cambiarEstado(permisoId, accion) {
        const mensaje = accion === 'aprobar' ? '¿Aprobar este permiso?' : '¿Rechazar este permiso?';

        if (confirm(mensaje)) {
            // Aquí harías una llamada AJAX al controlador
            const estadoId = accion === 'aprobar' ? 2 : 3; // Asumiendo que 2=Aprobado, 3=Rechazado

            fetch('/Permisos/CambiarEstado', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    id: permisoId,
                    nuevoEstado: estadoId
                })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload(); // Recargar la página para ver los cambios
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Error al procesar la solicitud');
                    console.error('Error:', error);
                });
        }
    }
</script>