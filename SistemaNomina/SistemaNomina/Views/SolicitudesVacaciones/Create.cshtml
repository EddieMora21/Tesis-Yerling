@model SistemaNomina.SolicitudesVacaciones

@{
    ViewBag.Title = "Solicitar Vacaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 20px 0;
        margin-bottom: 30px;
        border-radius: 0 0 15px 15px;
    }

    .form-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
        }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .alert-info {
        background-color: #d1ecf1;
        border: 1px solid #b8daff;
        color: #0c5460;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .cadena-aprobacion {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .aprobador-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .aprobador-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #007bff;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        font-size: 12px;
    }

    .validation-error {
        color: #dc3545;
        font-size: 14px;
        margin-top: 5px;
    }
</style>

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-calendar-plus"></i> Solicitar Vacaciones</h1>
        <p>Complete el formulario para enviar su solicitud de vacaciones</p>
    </div>
</div>

<div class="container">
    @if (ViewBag.CadenaAprobacion != null)
    {
        <div class="cadena-aprobacion">
            <h5><i class="fas fa-route"></i> Flujo de Aprobación</h5>
            <p>Su solicitud seguirá esta ruta de aprobación:</p>
            <ol>
                @foreach (var aprobador in (List<SistemaNomina.Empleados>)ViewBag.CadenaAprobacion)
                {
                    <li class="aprobador-item">
                        <div class="aprobador-icon">
                            @(aprobador.nombre1.Substring(0, 1))@(aprobador.apellido1.Substring(0, 1))
                        </div>
                        <div>
                            <strong>@aprobador.nombre1 @aprobador.apellido1</strong><br>
                            <small class="text-muted">
                                @aprobador.Puestos.nombre_puesto - @aprobador.Puestos.Departamentos.nombre
                            </small>
                        </div>
                    </li>
                }
            </ol>
        </div>
    }

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.id_vacacion, "Período de Vacaciones", new { @class = "form-label" })
                @Html.DropDownList("id_vacacion", null, "-- Seleccione el período --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.id_vacacion, "", new { @class = "validation-error" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.fecha_inicio, "Fecha de Inicio", new { @class = "form-label" })
                        @Html.EditorFor(model => model.fecha_inicio, new { htmlAttributes = new { @class = "form-control", @type = "date", @min = DateTime.Today.ToString("yyyy-MM-dd") } })
                        @Html.ValidationMessageFor(model => model.fecha_inicio, "", new { @class = "validation-error" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.fecha_fin, "Fecha de Fin", new { @class = "form-label" })
                        @Html.EditorFor(model => model.fecha_fin, new { htmlAttributes = new { @class = "form-control", @type = "date", @min = DateTime.Today.ToString("yyyy-MM-dd") } })
                        @Html.ValidationMessageFor(model => model.fecha_fin, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.comentario_solicitud, "Motivo/Comentario", new { @class = "form-label" })
                @Html.TextAreaFor(model => model.comentario_solicitud, new { @class = "form-control solo-letras", @rows = "4", @placeholder = "Describa el motivo de su solicitud de vacaciones...", @maxlength = "500" })
                @Html.ValidationMessageFor(model => model.comentario_solicitud, "", new { @class = "validation-error" })
                <small class="text-muted">Máximo 500 caracteres</small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> Enviar Solicitud
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // 🎯 APLICAR VALIDACIONES DE SOLO LETRAS
            $('.solo-letras').on('keypress', function(e) {
                const char = String.fromCharCode(e.which);
                const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;

                if (!regex.test(char)) {
                    e.preventDefault();
                    return false;
                }
            });

            $('.solo-letras').on('input paste', function() {
                const $this = $(this);
                setTimeout(function() {
                    const valor = $this.val();
                    const valorLimpio = valor.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');

                    if (valor !== valorLimpio) {
                        $this.val(valorLimpio);
                    }
                }, 1);
            });

            // Capitalizar automáticamente
            $('.solo-letras').on('blur', function() {
                if (this.value.trim() !== '') {
                    const palabras = this.value.toLowerCase().trim().split(/\s+/);
                    const capitalizado = palabras.map(palabra =>
                        palabra.charAt(0).toUpperCase() + palabra.slice(1)
                    ).join(' ');
                    this.value = capitalizado;
                }
            });
        });
    </script>
}