                            <span>Consultas</span>
                            <i class="bi bi-chevron-down menu-toggle-icon"></i>
                        </a>
                        <div class="submenu collapse" id="consultasMenu">
                            <a href="/Consultas/ConsultarPorColaborador" class="menu-link">
                                <i class="fas fa-user-search menu-icon"></i>
                                <span>Consultar por Colaborador</span>
                            </a>
                            <a href="/Consultas/HistoricoPlanillas" class="menu-link">
                                <i class="fas fa-history menu-icon"></i>
                                <span>Histórico de Planillas</span>
                            </a>
                        </div>
                    </div>
