@model SistemaNomina.TiposHoraExtra
@{
    ViewBag.Title = "Editar Tipo de Hora Extra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .page-header {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        color: var(--primary-color);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        box-shadow: var(--shadow-main);
    }

    .page-header * {
        color: var(--primary-color) !important;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .page-subtitle {
        opacity: 0.8;
        margin-top: 0.5rem;
        font-size: 1.1rem;
        font-weight: 400;
    }

    .form-card {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        padding: 2rem;
        border: 1px solid var(--neutral-color);
    }

    .form-header {
        background: linear-gradient(135deg, var(--secondary-color) 0%, #0f6da3 100%);
        color: var(--white);
        padding: 1.5rem;
        margin: -2rem -2rem 2rem -2rem;
        border-radius: var(--border-radius) var(--border-radius) 0 0;
    }

    .form-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 1rem;
    }

    .form-control-custom {
        border: 2px solid var(--neutral-color);
        border-radius: var(--border-radius-sm);
        padding: 0.75rem 1rem;
        transition: var(--transition);
        font-size: 1rem;
        width: 100%;
    }

    .form-control-custom:focus {
        border-color: var(--secondary-color);
        box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
        outline: none;
    }

    .form-control-display {
        background: linear-gradient(135deg, #f8f9fa, var(--neutral-color));
        border: 2px solid var(--neutral-color);
        border-radius: var(--border-radius-sm);
        padding: 0.75rem 1rem;
        font-size: 1rem;
        color: var(--text-color);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--secondary-color), #0f6da3);
        border: none;
        color: var(--white);
        font-weight: 600;
        padding: 12px 24px;
        border-radius: var(--border-radius-sm);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-save:hover {
        background: linear-gradient(135deg, #0f6da3, #0c5a87);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
        color: var(--white);
    }

    .btn-cancel {
        background: var(--neutral-color);
        border: 2px solid var(--neutral-color);
        color: var(--primary-color);
        font-weight: 600;
        padding: 10px 24px;
        border-radius: var(--border-radius-sm);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-left: 1rem;
    }

    .btn-cancel:hover {
        background: #d6d8db;
        border-color: #d6d8db;
        color: var(--primary-color);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .help-text {
        color: var(--text-muted);
        font-size: 0.875rem;
        font-style: italic;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .help-text.protected {
        color: var(--accent-color);
        font-weight: 500;
    }

    .validation-summary-custom {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        border-left: 4px solid var(--danger-color);
        padding: 1rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 1.5rem;
        color: #721c24;
    }

    .text-danger {
        color: var(--danger-color) !important;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .required-field::after {
        content: " *";
        color: var(--danger-color);
    }

    .info-card {
        background: linear-gradient(135deg, #e7f3ff, #f0f8ff);
        border-left: 4px solid var(--secondary-color);
        padding: 1rem 1.5rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 1.5rem;
    }

    .info-card h6 {
        color: var(--primary-color);
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .button-group {
        text-align: center;
        padding-top: 1.5rem;
        margin-top: 1.5rem;
        border-top: 1px solid var(--neutral-color);
    }

    /* === RESPONSIVE === */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem 0;
        }

        .page-title {
            font-size: 1.6rem;
            flex-direction: column;
            gap: 0.5rem;
            text-align: center;
        }

        .page-subtitle {
            text-align: center;
            font-size: 1rem;
        }

        .form-card {
            padding: 1.5rem;
        }

        .form-header {
            margin: -1.5rem -1.5rem 1.5rem -1.5rem;
        }

        .button-group {
            flex-direction: column;
        }

        .btn-save,
        .btn-cancel {
            width: 100%;
            margin: 0.25rem 0;
            justify-content: center;
        }
    }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-edit"></i>
            Editar Tipo de Hora Extra
        </h1>
        <p class="page-subtitle">
            Modifique la información del tipo de hora extra "@Model.nombre"
        </p>
    </div>
</div>

<div class="container" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="form-card">
                <div class="form-header">
                    <h4>
                        <i class="fas fa-edit"></i>
                        Formulario de Edición
                    </h4>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.id_tipo)
                    @Html.HiddenFor(model => model.fecha_creacion)

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-custom" })

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.nombre, "Nombre del Tipo", new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.nombre, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control form-control-custom",
                                placeholder = "Ej: Horas Nocturnas, Feriados, Fines de Semana",
                                maxlength = "100"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i>
                            Nombre descriptivo para identificar el tipo de hora extra
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.recargo, "Porcentaje de Recargo", new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.recargo, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control form-control-custom",
                                placeholder = "Ej: 50.00 (para 50%)",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                max = "500"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.recargo, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-percentage"></i>
                            Porcentaje de recargo sobre el salario base (ej: 50 = 50% adicional)
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.descripcion, "Descripción", new { @class = "form-label-custom" })
                        @Html.TextAreaFor(model => model.descripcion, new
                        {
                            @class = "form-control form-control-custom",
                            rows = "4",
                            placeholder = "Descripción detallada del tipo de hora extra, cuándo aplica y condiciones especiales...",
                            maxlength = "500"
                        })
                        @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-align-left"></i>
                            Descripción opcional con detalles adicionales sobre este tipo de hora extra
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.fecha_creacion, "Fecha de Creación", new { @class = "form-label-custom" })
                        <div class="form-control-display">
                            <i class="fas fa-shield-alt" style="color: var(--accent-color);"></i>
                            @if (Model.fecha_creacion.HasValue)
                            {
                                @Model.fecha_creacion.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span>No registrada</span>
                            }
                        </div>
                        <div class="help-text protected">
                            <i class="fas fa-lock"></i>
                            Fecha de creación protegida - No puede ser modificada
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.fecha_actualizacion, "Fecha de Actualización", new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.fecha_actualizacion, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control form-control-custom",
                                type = "datetime-local",
                                value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
                            }
                        })
                        @Html.ValidationMessageFor(model => model.fecha_actualizacion, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-calendar-edit"></i>
                            Fecha y hora de la última actualización (por defecto: fecha actual)
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn-save">
                            <i class="fas fa-save"></i>
                            Guardar Cambios
                        </button>
                        <a href="@Url.Action("Index")" class="btn-cancel">
                            <i class="fas fa-times"></i>
                            Cancelar
                        </a>
                    </div>
                }
            </div>

            <!-- Información adicional -->
            <div class="info-card">
                <h6>
                    <i class="fas fa-exclamation-triangle" style="color: var(--accent-color);"></i>
                    Consideraciones Importantes
                </h6>
                <ul class="mb-0" style="font-size: 0.875rem; color: var(--text-muted);">
                    <li>Los cambios en el recargo afectarán futuros cálculos de horas extra</li>
                    <li>Si este tipo está siendo utilizado, verifique que los cambios sean apropiados</li>
                    <li>La fecha de creación se preserva automáticamente sin modificaciones</li>
                    <li>La fecha de actualización refleja cuándo se modificó por última vez</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Validación adicional para el campo recargo
            $('#recargo').on('input', function () {
                var value = parseFloat($(this).val());
                if (value < 0) {
                    $(this).val(0);
                }
                if (value > 500) {
                    $(this).val(500);
                }
            });

            // Contador de caracteres para descripción
            var maxLength = 500;
            $('#descripcion').on('input', function () {
                var currentLength = $(this).val().length;
                var remaining = maxLength - currentLength;

                if (!$('#char-counter').length) {
                    $(this).after('<div id="char-counter" class="help-text mt-1"></div>');
                }

                $('#char-counter').html('<i class="fas fa-keyboard"></i> ' + remaining + ' caracteres restantes')
                    .removeClass('text-danger')
                    .addClass(remaining < 50 ? 'text-danger' : '');
            });

            // Trigger inicial del contador
            $('#descripcion').trigger('input');

            // Confirmar envío del formulario
            $('form').on('submit', function (e) {
                var nombreValue = $('#nombre').val().trim();
                var recargoValue = $('#recargo').val();

                if (nombreValue === '' || recargoValue === '') {
                    alert('Por favor complete todos los campos obligatorios');
                    e.preventDefault();
                    return false;
                }

                return confirm('¿Está seguro de que desea guardar los cambios realizados?');
            });
        });
    </script>
}