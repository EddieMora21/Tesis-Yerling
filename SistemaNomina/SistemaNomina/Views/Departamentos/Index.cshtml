@model IEnumerable<SistemaNomina.Models.Departamentos>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(34, 29, 66, 0.2);
    }

    .page-header-custom h1 {
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .page-header-custom p {
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .search-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 300px;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .search-input:focus {
        outline: none;
        border-color: #1788ca;
        box-shadow: 0 0 0 3px rgba(23, 136, 202, 0.1);
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.2rem;
    }

    .counter-badge {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(250, 182, 27, 0.3);
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(23, 136, 202, 0.3);
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.4);
        color: white;
        text-decoration: none;
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .btn-action-custom {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-details {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(23, 136, 202, 0.3);
    }

    .btn-details:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(23, 136, 202, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-edit {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(250, 182, 27, 0.3);
    }

    .btn-edit:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(250, 182, 27, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);
    }

    .btn-delete:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        color: white;
        text-decoration: none;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #28a745;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-error {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #dc3545;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .table-custom {
        margin: 0;
    }

    .table-custom thead {
        background: #221d42;
        color: white;
    }

    .table-custom thead th {
        border: none;
        padding: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.875rem;
        letter-spacing: 0.5px;
    }

    .table-custom tbody tr {
        transition: all 0.3s ease;
    }

    .table-custom tbody tr:hover {
        background-color: rgba(23, 136, 202, 0.05);
    }

    .table-custom td {
        padding: 1rem;
        border-color: #e7e8eb;
        vertical-align: middle;
    }

    .dept-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .dept-avatar {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #1788ca 0%, #221d42 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
        font-weight: 600;
    }

    .dept-details h6 {
        margin: 0;
        font-weight: 600;
        color: #221d42;
    }

    .date-display {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .date-value {
        font-weight: 500;
        color: #221d42;
        font-size: 0.875rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #e7e8eb;
    }

    .actions-group {
        display: flex;
        gap: 0.25rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

        .search-container {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            min-width: auto;
        }

        .btn-action-custom {
            padding: 4px 8px;
            font-size: 0.75rem;
        }

        .table-responsive {
            border-radius: 15px;
        }

        .dept-info {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
        }

        .actions-group {
            flex-direction: column;
            gap: 0.5rem;
        }

        .btn-action-custom {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .hidden-mobile {
            display: none;
        }
    }
</style>

<!-- Mensajes de alerta -->
@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-building"></i> Gestión de Departamentos</h1>
                <p class="mb-0">Administra los departamentos de la organización</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1200px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Barra de búsqueda y acciones -->
            <div class="search-container">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Buscar departamentos por nombre...">
                </div>
                <div class="counter-badge">
                    <i class="fas fa-hashtag"></i>
                    Total: <span id="totalCount">@(Model?.Count() ?? 0)</span>
                </div>
                @Html.ActionLink("Nuevo Departamento", "Create", null, new { @class = "btn-primary-custom" })
            </div>

            <div class="card-custom">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center p-4 border-bottom" style="border-color: #e7e8eb !important;">
                        <h4 class="mb-0" style="color: #221d42; font-weight: 600;">
                            <i class="fas fa-list-alt"></i> Lista de Departamentos
                        </h4>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-custom table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-building"></i> Departamento</th>
                                        <th class="hidden-mobile"><i class="fas fa-calendar-plus"></i> Fecha Creación</th>
                                        <th class="hidden-mobile"><i class="fas fa-history"></i> Última Actualización</th>
                                        <th><i class="fas fa-cogs"></i> Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="departamentosTableBody">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="departamento-row">
                                            <td>
                                                <div class="dept-info">
                                                    <div class="dept-avatar">
                                                        <i class="fas fa-building"></i>
                                                    </div>
                                                    <div class="dept-details">
                                                        <h6 class="dept-name">@Html.DisplayFor(modelItem => item.nombre)</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="hidden-mobile">
                                                <div class="date-display">
                                                    <span class="date-value">@Html.DisplayFor(modelItem => item.fecha_creacion)</span>
                                                </div>
                                            </td>
                                            <td class="hidden-mobile">
                                                <div class="date-display">
                                                    <span class="date-value">@Html.DisplayFor(modelItem => item.fecha_actualizacion)</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="actions-group">
                                                    @Html.ActionLink("Detalles", "Details", new { id = item.id_departamento }, new { @class = "btn-action-custom btn-details" })
                                                    @Html.ActionLink("Editar", "Edit", new { id = item.id_departamento }, new { @class = "btn-action-custom btn-edit" })
                                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.id_departamento }, new { @class = "btn-action-custom btn-delete" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-building"></i>
                            <h5>No hay departamentos registrados</h5>
                            <p>Comienza creando el primer departamento de la organización</p>
                            @Html.ActionLink("Crear Departamento", "Create", null, new { @class = "btn-primary-custom" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Usar JavaScript puro para asegurar compatibilidad
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        const totalCount = document.getElementById('totalCount');
        const departmentRows = document.querySelectorAll('.departamento-row');

        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                const searchTerm = this.value.toLowerCase();
                let visibleRows = 0;

                departmentRows.forEach(function (row) {
                    const deptNameElement = row.querySelector('.dept-name');

                    if (deptNameElement) {
                        const deptName = deptNameElement.textContent.toLowerCase();

                        if (deptName.includes(searchTerm)) {
                            row.style.display = '';
                            visibleRows++;
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });

                // Actualizar contador
                if (totalCount) {
                    totalCount.textContent = visibleRows;
                }
            });
        }

        // Confirmación para eliminar
        const deleteButtons = document.querySelectorAll('.btn-delete');
        deleteButtons.forEach(function (button) {
            button.addEventListener('click', function (e) {
                const row = this.closest('tr');
                const deptNameElement = row.querySelector('.dept-name');
                const departmentName = deptNameElement ? deptNameElement.textContent : 'este departamento';

                if (!confirm(`¿Estás seguro de que deseas eliminar el departamento "${departmentName}"?\n\nEsta acción no se puede deshacer.`)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    });
</script>