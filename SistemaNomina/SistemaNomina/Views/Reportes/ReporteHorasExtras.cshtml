@model IEnumerable<SistemaNomina.HorasExtras>

@{
    ViewBag.Title = "Reporte de Horas Extras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-danger text-white py-3">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="mb-0">
                                <i class="fas fa-clock me-3"></i>Reporte de Horas Extras
                            </h3>
                            <p class="mb-0 opacity-75">Del @ViewBag.FechaInicio al @ViewBag.FechaFin - Empleado: @ViewBag.EmpleadoSeleccionado - Tipo: @ViewBag.TipoSeleccionado</p>
                        </div>
                        <div class="col-auto">
                            <a href="@Url.Action("Index", "Reportes")" class="btn btn-light">
                                <i class="fas fa-arrow-left me-2"></i>Volver
                            </a>
                            <button onclick="window.print()" class="btn btn-warning ms-2">
                                <i class="fas fa-print me-2"></i>Imprimir
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <!-- Resumen General -->
                        <div class="row g-0 bg-light p-4">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white h-100 border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-list fa-2x mb-2"></i>
                                        <h4>@Model.Count()</h4>
                                        <p class="mb-0">Total Registros</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white h-100 border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-clock fa-2x mb-2"></i>
                                        <h4>@Model.Sum(h => h.horas).ToString("N1")</h4>
                                        <p class="mb-0">Total Horas</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white h-100 border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-check-circle fa-2x mb-2"></i>
                                        <h4>@Model.Count(h => h.Estados.nombre == "Aprobado")</h4>
                                        <p class="mb-0">Aprobadas</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white h-100 border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                                        <h4>₡@(Model.Where(h => h.Estados.nombre == "Aprobado").Sum(h => h.total ?? 0).ToString("N0"))</h4>
                                        <p class="mb-0">Total a Pagar</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de Detalles -->
                        <div class="table-responsive">
                            <table class="table-striped table-hover mb-0 table" id="reporteTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="fas fa-calendar me-2"></i>Fecha</th>
                                        <th><i class="fas fa-user me-2"></i>Empleado</th>
                                        <th><i class="fas fa-building me-2"></i>Departamento</th>
                                        <th><i class="fas fa-tag me-2"></i>Tipo</th>
                                        <th class="text-center"><i class="fas fa-clock me-2"></i>Inicio</th>
                                        <th class="text-center"><i class="fas fa-clock me-2"></i>Fin</th>
                                        <th class="text-center"><i class="fas fa-hourglass me-2"></i>Horas</th>
                                        <th class="text-center"><i class="fas fa-percentage me-2"></i>Recargo</th>
                                        <th class="text-end"><i class="fas fa-dollar-sign me-2"></i>Valor Hora</th>
                                        <th class="text-end"><i class="fas fa-money-bill me-2"></i>Total</th>
                                        <th class="text-center"><i class="fas fa-info-circle me-2"></i>Estado</th>
                                        <th><i class="fas fa-comment me-2"></i>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var horaExtra in Model.OrderBy(h => h.fecha).ThenBy(h => h.Empleados.apellido1))
                                    {
                                        var estadoClase = "";
                                        switch (horaExtra.Estados.nombre)
                                        {
                                            case "Aprobado":
                                                estadoClase = "badge bg-success";
                                                break;
                                            case "Pendiente":
                                                estadoClase = "badge bg-warning";
                                                break;
                                            case "Rechazado":
                                                estadoClase = "badge bg-danger";
                                                break;
                                            default:
                                                estadoClase = "badge bg-secondary";
                                                break;
                                        }

                                        <tr>
                                            <td>
                                                <strong>@horaExtra.fecha.ToString("dd/MM/yyyy")</strong>
                                                <br><small class="text-muted">@horaExtra.fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</small>
                                            </td>
                                            <td>
                                                <strong>@horaExtra.Empleados.nombre1 @horaExtra.Empleados.apellido1</strong>
                                                <br><small class="text-muted">@horaExtra.Empleados.cedula</small>
                                            </td>
                                            <td><span class="badge bg-primary">@horaExtra.Empleados.Puestos.Departamentos.nombre</span></td>
                                            <td><span class="badge bg-info">@horaExtra.TiposHoraExtra.nombre</span></td>
                                            <td class="text-center">@horaExtra.hora_inicio.ToString(@"hh\:mm")</td>
                                            <td class="text-center">@horaExtra.hora_fin.ToString(@"hh\:mm")</td>
                                            <td class="text-center">
                                                <span class="fw-bold">@horaExtra.horas.ToString("N1")h</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning">@horaExtra.recargo.ToString("N0")%</span>
                                            </td>
                                            <td class="text-end">₡@(horaExtra.valor_hora.ToString("N0") ?? "0")</td>
                                            <td class="text-end">
                                                <strong>₡@((horaExtra.total ?? 0).ToString("N0"))</strong>
                                            </td>
                                            <td class="text-center">
                                                <span class="@estadoClase">@horaExtra.Estados.nombre</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(horaExtra.motivo))
                                                {
                                                    <small>@horaExtra.motivo</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-dark">
                                    <tr>
                                        <th colspan="6" class="text-end">TOTALES:</th>
                                        <th class="text-center">@Model.Sum(h => h.horas).ToString("N1")h</th>
                                        <th></th>
                                        <th></th>
                                        <th class="text-end">₡@(Model.Sum(h => h.total ?? 0).ToString("N0"))</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No se encontraron registros</h4>
                            <p class="text-muted">No hay datos de horas extras para los filtros seleccionados.</p>
                            <a href="@Url.Action("Index", "Reportes")" class="btn btn-primary">
                                <i class="fas fa-arrow-left me-2"></i>Volver a Reportes
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .btn, .card-header .col-auto {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        body {
            font-size: 12px;
        }

        .table {
            font-size: 11px;
        }
    }

    .badge {
        font-size: 0.8em;
    }

    .table th {
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }
</style>