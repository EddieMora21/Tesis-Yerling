@model IEnumerable<SistemaNomina.ISR>
@{
    ViewBag.Title = "Gestión de ISR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #fd7e14;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .page-header-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: var(--white);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        box-shadow: var(--shadow-main);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .card-custom {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        border: 1px solid var(--neutral-color);
        overflow: hidden;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--accent-color), #e09f15);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        font-weight: 600;
        color: var(--primary-color);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #e09f15, #d18c00);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(250, 182, 27, 0.4);
            color: var(--primary-color);
            text-decoration: none;
        }

    .table-custom {
        margin: 0;
        border-radius: var(--border-radius);
        overflow: hidden;
    }

        .table-custom thead th {
            background: var(--primary-color);
            color: var(--white);
            border: none;
            padding: 1rem;
            font-weight: 600;
            border-bottom: none;
            font-size: 0.875rem;
            white-space: nowrap;
        }

        .table-custom tbody tr {
            transition: var(--transition);
            border-bottom: 1px solid var(--neutral-color);
        }

            .table-custom tbody tr:hover {
                background: rgba(23, 136, 202, 0.05);
                transform: translateY(-1px);
            }

        .table-custom tbody td {
            padding: 1rem;
            vertical-align: middle;
            border: none;
            color: var(--text-color);
            font-size: 0.875rem;
        }

    .badge-year {
        background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-color) 100%);
        color: var(--white);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-percentage {
        background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
        color: var(--white);
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .currency {
        color: var(--secondary-color);
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--text-muted);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--neutral-color);
            margin-bottom: 1rem;
        }

    /* === BOTONES DE ACCIONES (ESTÁNDAR) === */
    .action-buttons {
        display: flex;
        gap: 4px;
        justify-content: center;
        flex-wrap: nowrap;
        min-width: 210px;
    }

    .btn-action {
        padding: 8px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        border: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-width: 65px;
        justify-content: center;
        white-space: nowrap;
    }

    .btn-view {
        background: linear-gradient(135deg, var(--secondary-color), #0f6da3);
        color: var(--white);
    }

    .btn-view:hover {
        background: linear-gradient(135deg, #0f6da3, #0c5a87);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.3);
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--accent-color), #e09f15);
        color: var(--primary-color);
    }

    .btn-edit:hover {
        background: linear-gradient(135deg, #e09f15, #d18c00);
        color: var(--primary-color);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--danger-color), #c82333);
        color: var(--white);
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, #c82333, #bd2130);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

    /* === RESPONSIVE DESIGN === */
    @@media (max-width: 1200px) {
        .action-buttons {
            min-width: 190px;
        }

        .btn-action {
            min-width: 60px;
            padding: 6px 10px;
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 992px) {
        .table-custom thead th {
            padding: 1rem 0.7rem;
            font-size: 0.85rem;
        }

        .table-custom tbody td {
            padding: 0.8rem 0.7rem;
        }

        .action-buttons {
            min-width: 170px;
            gap: 3px;
        }

        .btn-action {
            min-width: 55px;
            padding: 6px 8px;
            font-size: 0.7rem;
        }

        .btn-action .btn-text {
            display: none; /* Oculta el texto, solo muestra iconos */
        }
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

            .page-header-custom h1 {
                font-size: 1.5rem;
            }

        .btn-primary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
        }

        .table-responsive {
            border-radius: var(--border-radius);
        }

        .table-custom {
            min-width: 850px;
        }

        .action-buttons {
            min-width: 160px;
            gap: 2px;
        }

        .btn-action {
            min-width: 50px;
            padding: 5px 6px;
            font-size: 0.7rem;
        }

        .btn-action i {
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .btn-primary-custom {
            width: 100%;
            justify-content: center;
            margin-bottom: 1rem;
        }

        .table-custom {
            min-width: 800px;
        }

        .action-buttons {
            flex-direction: column;
            min-width: 80px;
            gap: 2px;
        }

        .btn-action {
            width: 100%;
            min-width: auto;
            padding: 4px;
            font-size: 0.65rem;
        }
    }

    /* Scroll horizontal personalizado */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--secondary-color);
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: var(--primary-color);
    }
</style>

<!-- Header de la página -->
<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-calculator" style="font-size: 2rem; margin-right: 15px;"></i>
                    Gestión de ISR (Impuesto Sobre la Renta)
                </h1>
                <p class="mb-0" style="opacity: 0.9; margin-top: 0.5rem;">
                    Administra las tablas de tramos impositivos y deducciones fiscales
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Contenido principal -->
<div class="container-fluid" style="max-width: 1600px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Botón de crear nuevo -->
            <div class="mb-4 text-right">
                @Html.ActionLink("Crear Nueva Tabla ISR", "Create", null, new
                {
                    @class = "btn-primary-custom",
                    title = "Agregar un nuevo tramo de ISR"
                })
            </div>

            <!-- Card principal con la tabla -->
            <div class="card-custom">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom table">
                            <thead>
                                <tr>
                                    <th>
                                        <i class="fas fa-calendar-alt mr-2"></i>
                                        Año
                                    </th>
                                    <th>
                                        <i class="fas fa-arrow-down mr-2"></i>
                                        Límite Inferior
                                    </th>
                                    <th>
                                        <i class="fas fa-arrow-up mr-2"></i>
                                        Límite Superior
                                    </th>
                                    <th>
                                        <i class="fas fa-percentage mr-2"></i>
                                        @Html.DisplayNameFor(model => model.porcentaje)
                                    </th>
                                    <th>
                                        <i class="fas fa-plus-circle mr-2"></i>
                                        @Html.DisplayNameFor(model => model.exceso)
                                    </th>
                                    <th>
                                        <i class="fas fa-child mr-2"></i>
                                        Crédito Hijo
                                    </th>
                                    <th>
                                        <i class="fas fa-heart mr-2"></i>
                                        Crédito Cónyuge
                                    </th>
                                    <th>
                                        <i class="fas fa-align-left mr-2"></i>
                                        @Html.DisplayNameFor(model => model.descripcion)
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-cogs mr-2"></i>
                                        Acciones
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge-year">
                                                <i class="fas fa-calendar"></i>
                                                @Html.DisplayFor(modelItem => item.anio)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="currency">
                                                ¢@Html.DisplayFor(modelItem => item.limite_inferior)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="currency">
                                                ¢@Html.DisplayFor(modelItem => item.limite_superior)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-percentage">
                                                @Html.DisplayFor(modelItem => item.porcentaje)%
                                            </span>
                                        </td>
                                        <td>
                                            <span class="currency">
                                                ¢@Html.DisplayFor(modelItem => item.exceso)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="currency">
                                                ¢@Html.DisplayFor(modelItem => item.credito_hijo)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="currency">
                                                ¢@Html.DisplayFor(modelItem => item.credito_conyuge)
                                            </span>
                                        </td>
                                        <td style="max-width: 150px;">
                                            @if (!string.IsNullOrEmpty(item.descripcion))
                                            {
                                                @(item.descripcion.Length > 30 ? item.descripcion.Substring(0, 30) + "..." : item.descripcion)
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin descripción</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="@Url.Action("Details", new { id = item.id_isr })"
                                                   class="btn-action btn-view"
                                                   title="Ver detalles">
                                                    <i class="fas fa-eye"></i>
                                                    <span class="btn-text">Ver</span>
                                                </a>
                                                <a href="@Url.Action("Edit", new { id = item.id_isr })"
                                                   class="btn-action btn-edit"
                                                   title="Editar tramo ISR">
                                                    <i class="fas fa-edit"></i>
                                                    <span class="btn-text">Editar</span>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.id_isr })"
                                                   class="btn-action btn-delete"
                                                   title="Eliminar tramo ISR"
                                                   onclick="return confirm('¿Está seguro de que desea eliminar este tramo de ISR?');">
                                                    <i class="fas fa-trash"></i>
                                                    <span class="btn-text">Eliminar</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-calculator"></i>
                        <h4>No hay tramos de ISR registrados</h4>
                        <p class="text-muted">Comience agregando los tramos de impuesto sobre la renta para los cálculos de nómina.</p>
                        @Html.ActionLink("Crear Primera Tabla", "Create", null, new
                        {
                            @class = "btn-primary-custom mt-3"
                        })
                    </div>
                }
            </div>

            <!-- Información adicional -->
            <div class="mt-4 p-3" style="background: #e7f3ff; border-radius: 10px; border-left: 4px solid #1788ca;">
                <h6 style="color: #221d42; margin-bottom: 0.5rem;">
                    <i class="fas fa-info-circle text-info"></i>
                    Información sobre el ISR
                </h6>
                <ul class="mb-0" style="font-size: 0.875rem; color: #6c757d;">
                    <li>Los tramos de ISR definen cómo se calcula el impuesto según el nivel salarial</li>
                    <li>Los créditos por hijo y cónyuge reducen el monto del impuesto a pagar</li>
                    <li>Cada año fiscal puede tener diferentes tramos y porcentajes</li>
                    <li>Asegúrese de mantener actualizadas las tablas según las regulaciones fiscales</li>
                </ul>
            </div>
        </div>
    </div>
</div>