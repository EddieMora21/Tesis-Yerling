                            <a href="/Aguinaldo" class="menu-link">
                                <i class="fas fa-gift menu-icon"></i>
                                <span>Cálculo de Aguinaldo</span>
                            </a>

                            <!-- Pago de Nómina - Submenu -->
                            <a data-bs-toggle="collapse" href="#nominaSubmenu" role="button"
                               class="menu-link" aria-expanded="false" aria-controls="nominaSubmenu">
                                <i class="fas fa-money-check-alt menu-icon"></i>
                                <span>Pago de Nómina</span>
                                <i class="bi bi-chevron-down menu-toggle-icon"></i>
                            </a>
                            <div class="submenu collapse" id="nominaSubmenu">
                                <a href="/Nominas/SeleccionarPeriodo" class="menu-link">
                                    <i class="fas fa-plus-circle menu-icon"></i>
                                    <span>Generar Nómina</span>
                                </a>
                                <a href="/Nominas/Index" class="menu-link">
                                    <i class="fas fa-table menu-icon"></i>
