@model SistemaNomina.Vacaciones

@{
    ViewBag.Title = "Crear Registro de Vacaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-calendar-plus me-2"></i>
                            Crear Registro de Vacaciones
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver al Listado
                        </a>
                    </div>
                    <p class="mb-0 mt-2">
                        <small>Registra los días de vacaciones disponibles para un empleado</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <!-- Panel principal del formulario -->
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="fas fa-edit me-2"></i>Información de Vacaciones
                </h5>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Create", "Vacaciones", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Mensaje de errores generales -->
                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>¡Atención!</strong> Por favor corrige los errores señalados.
                            @Html.ValidationSummary(true, "", new { @class = "mt-2" })
                        </div>
                    }

                    <!-- Campo: Empleado -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-user me-1"></i>Empleado *
                        </label>
                        @Html.DropDownList("id_empleado", null, "-- Selecciona un empleado --",
                            new { @class = "form-select", @required = "required" })
                        @Html.ValidationMessageFor(model => model.id_empleado, "", new { @class = "text-danger small" })
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>Selecciona el empleado para asignar vacaciones
                        </small>
                    </div>

                    <!-- Campo: Período -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-calendar me-1"></i>Período *
                        </label>
                        @Html.EditorFor(model => model.periodo, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control only-letters-numbers",
                                @required = "required",
                                @placeholder = "Ej: 2025, 2025-2026",
                                @maxlength = "50"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.periodo, "", new { @class = "text-danger small" })
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>Año o período al que corresponden las vacaciones
                        </small>
                    </div>

                    <!-- Campos en fila -->
                    <div class="row">
                        <!-- Campo: Días disponibles -->
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-calendar-plus me-1"></i>Días Disponibles *
                                </label>
                                @Html.EditorFor(model => model.dias_disponibles, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control only-numbers",
                                        @required = "required",
                                        @type = "number",
                                        @min = "0",
                                        @max = "365",
                                        @step = "1"
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.dias_disponibles, "", new { @class = "text-danger small" })
                                <small class="form-text text-muted">
                                    <i class="fas fa-info-circle me-1"></i>Total de días que puede disfrutar
                                </small>
                            </div>
                        </div>

                        <!-- Campo: Días disfrutados -->
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-calendar-check me-1"></i>Días Disfrutados
                                </label>
                                @Html.EditorFor(model => model.dias_disfrutados, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control only-numbers",
                                        @type = "number",
                                        @min = "0",
                                        @step = "1",
                                        @value = "0"
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.dias_disfrutados, "", new { @class = "text-danger small" })
                                <small class="form-text text-muted">
                                    <i class="fas fa-info-circle me-1"></i>Días ya utilizados (opcional, por defecto 0)
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-center gap-3 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Crear Registro
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Cancelar
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Panel de ayuda -->
        <div class="card mt-3 shadow-sm">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0">
                    <i class="fas fa-lightbulb me-2"></i>Información Útil
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <small><strong>Días Disponibles:</strong> Normalmente 14 días por año para empleados con pago mensual</small>
                    </div>
                    <div class="col-md-4 mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <small><strong>Período:</strong> Indica el año laboral al que corresponden las vacaciones</small>
                    </div>
                    <div class="col-md-4 mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <small><strong>Actualización:</strong> Los días disfrutados se actualizan automáticamente con las solicitudes aprobadas</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Validación: Solo números para campos numéricos
            $('.only-numbers').on('input', function () {
                var value = $(this).val();
                var regex = /^[0-9]*$/;

                if (!regex.test(value)) {
                    var newValue = value.replace(/[^0-9]/g, '');
                    $(this).val(newValue);

                    if (!$(this).next('.validation-error').length) {
                        $(this).after('<div class="validation-error text-danger small">Solo se permiten números</div>');
                        setTimeout(function () {
                            $('.validation-error').fadeOut(function () {
                                $(this).remove();
                            });
                        }, 3000);
                    }
                }
            });

            // Validación: Solo letras, números y algunos caracteres para período
            $('.only-letters-numbers').on('input', function () {
                var value = $(this).val();
                var regex = /^[a-zA-Z0-9\s\-]*$/;

                if (!regex.test(value)) {
                    var newValue = value.replace(/[^a-zA-Z0-9\s\-]/g, '');
                    $(this).val(newValue);

                    if (!$(this).next('.validation-error').length) {
                        $(this).after('<div class="validation-error text-danger small">Solo se permiten letras, números, espacios y guiones</div>');
                        setTimeout(function () {
                            $('.validation-error').fadeOut(function () {
                                $(this).remove();
                            });
                        }, 3000);
                    }
                }
            });

            // Validación adicional de negocio
            $('#dias_disponibles').on('input', function () {
                var valor = parseInt($(this).val()) || 0;
                var diasDisfrutados = parseInt($('#dias_disfrutados').val()) || 0;

                if (valor < diasDisfrutados) {
                    $(this).addClass('is-invalid');
                    if (!$(this).siblings('.validation-business').length) {
                        $(this).after('<div class="validation-business text-danger small">Los días disponibles no pueden ser menores a los días disfrutados</div>');
                    }
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).siblings('.validation-business').remove();
                }
            });

            $('#dias_disfrutados').on('input', function () {
                var valor = parseInt($(this).val()) || 0;
                var diasDisponibles = parseInt($('#dias_disponibles').val()) || 0;

                if (valor > diasDisponibles) {
                    $(this).addClass('is-invalid');
                    if (!$(this).siblings('.validation-business').length) {
                        $(this).after('<div class="validation-business text-danger small">Los días disfrutados no pueden ser mayores a los disponibles</div>');
                    }
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).siblings('.validation-business').remove();
                }
            });

            // Validación del formulario al enviar
            $('.needs-validation').on('submit', function (e) {
                var isValid = true;

                // Validar que no haya errores de negocio
                if ($('.is-invalid').length > 0) {
                    e.preventDefault();
                    isValid = false;
                }

                if (!isValid) {
                    // Mostrar alerta de error
                    if (!$('.alert-danger').length) {
                        var alert = '<div class="alert alert-danger alert-dismissible fade show mt-3">' +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                            '<i class="fas fa-exclamation-triangle me-2"></i>' +
                            'Por favor corrija los errores en el formulario antes de continuar.' +
                            '</div>';
                        $(this).prepend(alert);
                    }
                }
            });
        });
    </script>
}