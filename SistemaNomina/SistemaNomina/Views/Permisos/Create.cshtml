@model SistemaNomina.Models.Permisos

@{
    ViewBag.Title = "Crear Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(34, 29, 66, 0.2);
    }

    .form-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #221d42;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-custom {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #1788ca;
        box-shadow: 0 0 0 3px rgba(23, 136, 202, 0.1);
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.4);
    }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-secondary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.4);
        color: white;
        text-decoration: none;
    }

    .help-text {
        font-size: 0.875rem;
        color: #6c757d;
        font-style: italic;
        margin-top: 0.25rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #e7e8eb;
    }

    .validation-summary {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #dc3545;
        margin-bottom: 2rem;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-plus-circle"></i> Crear Nuevo Permiso</h1>
                <p class="mb-0">Registra una nueva solicitud de permiso</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="form-container">
                @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user"></i> Empleado *
                        </label>
                        @Html.DropDownList("id_empleado", null, "Selecciona un empleado", new { @class = "form-control-custom", @required = "required" })
                        @Html.ValidationMessageFor(model => model.id_empleado, "", new { @class = "field-validation-error" })
                        <small class="help-text">Selecciona el empleado que solicita el permiso</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-calendar"></i> Fecha del Permiso *
                        </label>
                        @Html.EditorFor(model => model.fecha, new { htmlAttributes = new { @class = "form-control-custom", @type = "date", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.fecha, "", new { @class = "field-validation-error" })
                        <small class="help-text">Fecha en la que se utilizará el permiso</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-clock"></i> Horas *
                        </label>
                        @Html.EditorFor(model => model.horas, new { htmlAttributes = new { @class = "form-control-custom", @type = "number", @min = "1", @max = "8", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.horas, "", new { @class = "field-validation-error" })
                        <small class="help-text">Número de horas del permiso (máximo 8 horas)</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tag"></i> Tipo de Permiso *
                        </label>
                        @Html.DropDownList("id_tipo_permiso", null, "Selecciona el tipo de permiso", new { @class = "form-control-custom", @required = "required" })
                        @Html.ValidationMessageFor(model => model.id_tipo_permiso, "", new { @class = "field-validation-error" })
                        <small class="help-text">Tipo o categoría del permiso solicitado</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-comment"></i> Motivo *
                        </label>
                        @Html.TextAreaFor(model => model.motivo, new { @class = "form-control-custom", @rows = "4", @required = "required", @maxlength = "500" })
                        @Html.ValidationMessageFor(model => model.motivo, "", new { @class = "field-validation-error" })
                        <small class="help-text">Describe el motivo de la solicitud del permiso (máximo 500 caracteres)</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary-custom">
                            <i class="fas fa-save"></i> Crear Permiso
                        </button>
                        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-secondary-custom" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Establecer fecha mínima como hoy
        const fechaInput = document.querySelector('input[type="date"]');
        if (fechaInput) {
            const today = new Date().toISOString().split('T')[0];
            fechaInput.setAttribute('min', today);
        }

        // Contador de caracteres para el motivo
        const motivoTextarea = document.querySelector('textarea[name="motivo"]');
        if (motivoTextarea) {
            const maxLength = motivoTextarea.getAttribute('maxlength');
            const helpText = motivoTextarea.parentNode.querySelector('.help-text');

            motivoTextarea.addEventListener('input', function () {
                const remaining = maxLength - this.value.length;
                helpText.textContent = `Describe el motivo de la solicitud del permiso (${remaining} caracteres restantes)`;
            });
        }
    });
</script>