@model SistemaNomina.TipoLiquidacion

@{
    ViewBag.Title = "Editar Tipo de Liquidación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Editar Tipo de Liquidación
                    </h4>
                </div>

                @using (Html.BeginForm("Edit", "TipoLiquidacion", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.id_tipo)

                    <div class="card-body">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-tag me-1"></i>
                                        Nombre del Tipo
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-tag"></i>
                                        </span>
                                        @Html.EditorFor(model => model.nombre, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control only-letters",
                                                required = "required",
                                                placeholder = "Ingrese el nombre del tipo de liquidación"
                                            }
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Descripción
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-info-circle"></i>
                                        </span>
                                        @Html.EditorFor(model => model.descripcion, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control only-letters",
                                                placeholder = "Descripción del tipo de liquidación (opcional)"
                                            }
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-calendar-plus me-1"></i>
                                        Fecha de Creación
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-calendar-plus"></i>
                                        </span>
                                        @Html.EditorFor(model => model.fecha_creacion, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control",
                                                @type = "datetime-local",
                                                @readonly = "readonly"
                                            }
                                        })
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-lock me-1"></i>
                                        La fecha de creación no se puede modificar
                                    </small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-calendar-edit me-1"></i>
                                        Última Actualización
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-calendar-edit"></i>
                                        </span>
                                        @Html.EditorFor(model => model.fecha_actualizacion, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control",
                                                @type = "datetime-local"
                                            }
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.fecha_actualizacion, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>
                                Volver a la Lista
                            </a>
                            <div>
                                <a href="@Url.Action("Details", new { id = Model.id_tipo })" class="btn btn-info me-2">
                                    <i class="fas fa-eye me-1"></i>
                                    Ver Detalles
                                </a>
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save me-1"></i>
                                    Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Validación: Solo letras, espacios y algunos caracteres especiales permitidos para nombres y descripciones
            $('.only-letters').on('input', function () {
                // Permite letras, espacios, tildes, ñ, números, puntos, comas, guiones y paréntesis
                var value = $(this).val();
                var regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ0-9\s\.\,\-\(\)]*$/;

                if (!regex.test(value)) {
                    // Remover caracteres no permitidos
                    var newValue = value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ0-9\s\.\,\-\(\)]/g, '');
                    $(this).val(newValue);

                    // Mostrar mensaje de error temporal
                    if (!$(this).next('.validation-error').length) {
                        $(this).after('<div class="validation-error text-danger small">Solo se permiten letras, números, espacios y caracteres básicos</div>');
                        setTimeout(function() {
                            $('.validation-error').fadeOut(function() {
                                $(this).remove();
                            });
                        }, 3000);
                    }
                }
            });

            // Validación: Solo números para campos numéricos
            $('.only-numbers').on('input', function () {
                var value = $(this).val();
                var regex = /^[0-9]*\.?[0-9]*$/;

                if (!regex.test(value)) {
                    var newValue = value.replace(/[^0-9\.]/g, '');
                    $(this).val(newValue);

                    if (!$(this).next('.validation-error').length) {
                        $(this).after('<div class="validation-error text-danger small">Solo se permiten números</div>');
                        setTimeout(function() {
                            $('.validation-error').fadeOut(function() {
                                $(this).remove();
                            });
                        }, 3000);
                    }
                }
            });

            // Actualizar fecha de actualización al cambiar cualquier campo
            $('input, select, textarea').not('[readonly]').on('change', function() {
                var now = new Date();
                var dateTimeLocal = now.getFullYear() + '-' +
                    String(now.getMonth() + 1).padStart(2, '0') + '-' +
                    String(now.getDate()).padStart(2, '0') + 'T' +
                    String(now.getHours()).padStart(2, '0') + ':' +
                    String(now.getMinutes()).padStart(2, '0');

                $('input[name="fecha_actualizacion"]').val(dateTimeLocal);
            });
        });
    </script>
}