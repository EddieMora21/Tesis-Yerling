@model SistemaNomina.Models.Empleados

@{
    ViewBag.Title = "Nuevo Empleado";
}

<style>
    .header-create {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
        padding: 2rem 0;
        margin: -15px -15px 30px -15px;
        border-radius: 0 0 15px 15px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .form-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 30px;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .form-control-custom:focus {
            border-color: #1788ca;
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
            outline: none;
        }

    .control-label-custom {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-success-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
            color: white;
        }

    .btn-default-custom {
        background: white;
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 12px 24px;
        color: #221d42;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-default-custom:hover {
            background: #f8f9fa;
            border-color: #1788ca;
            color: #1788ca;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .section-title {
        color: #221d42;
        font-weight: 600;
        border-bottom: 2px solid #1788ca;
        padding-bottom: 10px;
        margin-bottom: 25px;
    }

    .help-text {
        color: #6c757d;
        font-style: italic;
        font-size: 12px;
        margin-top: 4px;
    }

    .form-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        border-left: 4px solid #1788ca;
    }

    @@media (max-width: 768px) {
        .form-card {
            padding: 20px 15px;
        }

        .header-create {
            padding: 1.5rem 0;
            margin: -15px -15px 20px -15px;
        }

        .col-md-4, .col-md-8 {
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>

<div class="container" style="max-width: 1200px;">
    <div class="header-create">
        <div class="container">
            <h2 class="mb-0">
                <i class="fa fa-user-plus" style="font-size: 2rem; margin-right: 15px;"></i>
                Nuevo Empleado
            </h2>
            <p class="mb-0 mt-2" style="opacity: 0.9;">Registra la información de un nuevo colaborador</p>
        </div>
    </div>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="form-section">
                <h4 class="section-title">
                    <i class="fa fa-user" style="margin-right: 10px; color: #1788ca;"></i>
                    Información Personal
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-id-card" style="margin-right: 5px;"></i>
                                Cédula
                            </label>
                            @Html.EditorFor(model => model.cedula, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "000-0000000-0", @required = "required", id = "cedula" } })
                            @Html.ValidationMessageFor(model => model.cedula, "", new { @class = "text-danger" })
                            <small class="help-text">Formato: 000-0000000-0</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-user" style="margin-right: 5px;"></i>
                                Primer Nombre
                            </label>
                            @Html.EditorFor(model => model.nombre1, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Primer nombre", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.nombre1, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-user" style="margin-right: 5px;"></i>
                                Segundo Nombre
                            </label>
                            @Html.EditorFor(model => model.nombre2, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Segundo nombre (opcional)" } })
                            @Html.ValidationMessageFor(model => model.nombre2, "", new { @class = "text-danger" })
                            <small class="help-text">Campo opcional</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-user" style="margin-right: 5px;"></i>
                                Primer Apellido
                            </label>
                            @Html.EditorFor(model => model.apellido1, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Primer apellido", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.apellido1, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-user" style="margin-right: 5px;"></i>
                                Segundo Apellido
                            </label>
                            @Html.EditorFor(model => model.apellido2, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Segundo apellido (opcional)" } })
                            @Html.ValidationMessageFor(model => model.apellido2, "", new { @class = "text-danger" })
                            <small class="help-text">Campo opcional</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-calendar" style="margin-right: 5px;"></i>
                                Fecha de Nacimiento
                            </label>
                            @Html.EditorFor(model => model.fecha_nacimiento, new { htmlAttributes = new { @class = "form-control form-control-custom", type = "date", @required = "required", max = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd") } })
                            @Html.ValidationMessageFor(model => model.fecha_nacimiento, "", new { @class = "text-danger" })
                            <small class="help-text">Debe ser mayor de 18 años</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-map-marker" style="margin-right: 5px;"></i>
                                Dirección
                            </label>
                            @Html.EditorFor(model => model.direccion, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Dirección completa" } })
                            @Html.ValidationMessageFor(model => model.direccion, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-envelope" style="margin-right: 5px;"></i>
                                Correo Electrónico
                            </label>
                            @Html.EditorFor(model => model.correo, new { htmlAttributes = new { @class = "form-control form-control-custom", type = "email", placeholder = "ejemplo@dominio.com" } })
                            @Html.ValidationMessageFor(model => model.correo, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-phone" style="margin-right: 5px;"></i>
                                Teléfono
                            </label>
                            @Html.EditorFor(model => model.telefono, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "809-555-1234" } })
                            @Html.ValidationMessageFor(model => model.telefono, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-heart" style="margin-right: 5px;"></i>
                                Estado Civil
                            </label>
                            @Html.DropDownList("id_estado_civil", null, "-- Seleccione --", htmlAttributes: new { @class = "form-control form-control-custom", @required = "required" })
                            @Html.ValidationMessageFor(model => model.id_estado_civil, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-child" style="margin-right: 5px;"></i>
                                Cantidad de Hijos
                            </label>
                            @Html.EditorFor(model => model.cantidad_hijos, new { htmlAttributes = new { @class = "form-control form-control-custom", min = "0", value = "0" } })
                            @Html.ValidationMessageFor(model => model.cantidad_hijos, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h4 class="section-title">
                    <i class="fa fa-briefcase" style="margin-right: 10px; color: #1788ca;"></i>
                    Información Laboral
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-briefcase" style="margin-right: 5px;"></i>
                                Puesto
                            </label>
                            @Html.DropDownList("id_puesto", null, "-- Seleccione --", htmlAttributes: new { @class = "form-control form-control-custom", @required = "required" })
                            @Html.ValidationMessageFor(model => model.id_puesto, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-calendar-check" style="margin-right: 5px;"></i>
                                Fecha de Ingreso
                            </label>
                            @Html.EditorFor(model => model.fecha_ingreso, new { htmlAttributes = new { @class = "form-control form-control-custom", type = "date", @required = "required", max = DateTime.Today.ToString("yyyy-MM-dd") } })
                            @Html.ValidationMessageFor(model => model.fecha_ingreso, "", new { @class = "text-danger" })
                            <small class="help-text">No puede ser fecha futura</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-clock" style="margin-right: 5px;"></i>
                                Horario
                            </label>
                            @Html.DropDownList("id_horario", null, "-- Seleccione --", htmlAttributes: new { @class = "form-control form-control-custom", @required = "required" })
                            @Html.ValidationMessageFor(model => model.id_horario, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="control-label-custom">
                                <i class="fa fa-toggle-on" style="margin-right: 5px;"></i>
                                Estado
                            </label>
                            @Html.DropDownList("estado", null, htmlAttributes: new { @class = "form-control form-control-custom", @required = "required" })
                            @Html.ValidationMessageFor(model => model.estado, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center" style="margin-top: 30px;">
                <button type="submit" class="btn-success-custom" style="margin-right: 15px;">
                    <i class="fa fa-save" style="margin-right: 8px;"></i>
                    Guardar Empleado
                </button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-default-custom" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jquery.maskedinput.min.js"></script>
    <script>
        $(function () {
            $("#cedula").mask("999-9999999-9");
        });
    </script>
}