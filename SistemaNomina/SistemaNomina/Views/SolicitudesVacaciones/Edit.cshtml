@model SistemaNomina.Models.SolicitudesVacaciones

@{
    ViewBag.Title = "Editar Solicitud";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-edit"></i> Editar Solicitud de Vacaciones</h1>
        <p>Modificar información de la solicitud</p>
    </div>
</div>

<div class="container">
    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.id_solicitud)
            @Html.HiddenFor(model => model.fecha_creacion)
            @Html.HiddenFor(model => model.fecha_solicitud)

            <div class="form-group">
                @Html.LabelFor(model => model.id_vacacion, "Período de Vacaciones", new { @class = "form-label" })
                @Html.DropDownList("id_vacacion", null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.id_vacacion, "", new { @class = "validation-error" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.fecha_inicio, "Fecha de Inicio", new { @class = "form-label" })
                        @Html.EditorFor(model => model.fecha_inicio, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                        @Html.ValidationMessageFor(model => model.fecha_inicio, "", new { @class = "validation-error" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.fecha_fin, "Fecha de Fin", new { @class = "form-label" })
                        @Html.EditorFor(model => model.fecha_fin, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                        @Html.ValidationMessageFor(model => model.fecha_fin, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.comentario_solicitud, "Motivo/Comentario", new { @class = "form-label" })
                @Html.TextAreaFor(model => model.comentario_solicitud, new { @class = "form-control solo-letras", @rows = "4", @maxlength = "500" })
                @Html.ValidationMessageFor(model => model.comentario_solicitud, "", new { @class = "validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.id_estado, "Estado", new { @class = "form-label" })
                @Html.DropDownList("id_estado", null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.id_estado, "", new { @class = "validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.comentario_respuesta, "Comentario de Respuesta", new { @class = "form-label" })
                @Html.TextAreaFor(model => model.comentario_respuesta, new { @class = "form-control solo-letras", @rows = "3", @maxlength = "500" })
                @Html.ValidationMessageFor(model => model.comentario_respuesta, "", new { @class = "validation-error" })
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Aplicar validaciones de solo letras
        $(document).ready(function() {
            $('.solo-letras').on('keypress', function(e) {
                const char = String.fromCharCode(e.which);
                const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                if (!regex.test(char)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}