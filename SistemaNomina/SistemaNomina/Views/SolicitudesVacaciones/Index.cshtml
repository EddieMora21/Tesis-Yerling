@model IEnumerable<SistemaNomina.SolicitudesVacaciones>

@{
    ViewBag.Title = "Solicitudes de Vacaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%);
        color: white;
        padding: 20px 0;
        margin-bottom: 30px;
        border-radius: 0 0 15px 15px;
    }

    .stats-row {
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        border-left: 4px solid;
    }

        .stat-card.pendientes {
            border-left-color: #ffc107;
        }

        .stat-card.aprobadas {
            border-left-color: #28a745;
        }

        .stat-card.rechazadas {
            border-left-color: #dc3545;
        }

        .stat-card.total {
            border-left-color: #007bff;
        }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #666;
        font-size: 0.9rem;
    }

    .filters-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }

    .table-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }

    .table-responsive {
        margin: 0;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-aprobado {
        background-color: #d4edda;
        color: #155724;
    }

    .status-rechazado {
        background-color: #f8d7da;
        color: #721c24;
    }

    .btn-action {
        padding: 4px 8px;
        margin: 2px;
        border: none;
        border-radius: 4px;
        font-size: 12px;
        cursor: pointer;
    }

        .btn-action.view {
            background-color: #17a2b8;
            color: white;
        }

        .btn-action.approve {
            background-color: #28a745;
            color: white;
        }

        .btn-action.reject {
            background-color: #dc3545;
            color: white;
        }

        .btn-action.edit {
            background-color: #ffc107;
            color: #212529;
        }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #666;
    }
</style>

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1><i class="fas fa-calendar-check"></i> Mis Solicitudes de Vacaciones</h1>
                <p>Gestione y revise todas las solicitudes de vacaciones</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="@Url.Action("Create")" class="btn btn-light btn-lg">
                    <i class="fas fa-plus"></i> Nueva Solicitud
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Estadísticas -->
    <div class="stats-row">
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="stat-card total">
                    <div class="stat-number text-primary">@Model.Count()</div>
                    <div class="stat-label">Total Solicitudes</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="stat-card pendientes">
                    <div class="stat-number text-warning">@Model.Count(s => s.Estados.nombre == "Pendiente")</div>
                    <div class="stat-label">Pendientes</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="stat-card aprobadas">
                    <div class="stat-number text-success">@Model.Count(s => s.Estados.nombre == "Aprobado")</div>
                    <div class="stat-label">Aprobadas</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="stat-card rechazadas">
                    <div class="stat-number text-danger">@Model.Count(s => s.Estados.nombre == "Rechazado")</div>
                    <div class="stat-label">Rechazadas</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filters-card">
        <div class="row align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">
                    <i class="fas fa-filter"></i> Filtrar por Estado
                </label>
                <select class="form-select" id="filtroEstado">
                    <option value="">Todos los estados</option>
                    <option value="pendiente">Pendientes</option>
                    <option value="aprobado">Aprobadas</option>
                    <option value="rechazado">Rechazadas</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">
                    <i class="fas fa-search"></i> Buscar
                </label>
                <input type="text" class="form-control" id="filtroBusqueda"
                       placeholder="Buscar por empleado, período, fechas...">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">
                    <i class="fas fa-calendar"></i> Rango de Fechas
                </label>
                <input type="month" class="form-control" id="filtroMes">
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de Solicitudes -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="table-hover table" id="tablaSolicitudes">
                <thead>
                    <tr>
                        <th><i class="fas fa-user"></i> Empleado</th>
                        <th><i class="fas fa-calendar"></i> Período</th>
                        <th><i class="fas fa-calendar-day"></i> Fechas Solicitadas</th>
                        <th><i class="fas fa-clock"></i> Días</th>
                        <th><i class="fas fa-calendar-plus"></i> Fecha Solicitud</th>
                        <th><i class="fas fa-info-circle"></i> Estado</th>
                        <th><i class="fas fa-cogs"></i> Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var solicitud in Model)
                        {
                            var diasSolicitados = 0;
                            for (var fecha = solicitud.fecha_inicio; fecha <= solicitud.fecha_fin; fecha = fecha.AddDays(1))
                            {
                                if (fecha.DayOfWeek != DayOfWeek.Saturday && fecha.DayOfWeek != DayOfWeek.Sunday) { diasSolicitados++; }

                            }

                            <tr data-estado="@solicitud.Estados.nombre.ToLower()">
                                <td>
                                    <div>
                                        <strong>@solicitud.Vacaciones.Empleados.nombre1 @solicitud.Vacaciones.Empleados.apellido1</strong><br>
                                        <small class="text-muted">@solicitud.Vacaciones.Empleados.cedula</small><br>
                                        <small class="text-muted">@solicitud.Vacaciones.Empleados.Puestos.Departamentos.nombre</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@solicitud.Vacaciones.periodo</span>
                                </td>
                                <td>
                                    <strong>@solicitud.fecha_inicio.ToString("dd/MM/yyyy")</strong><br>
                                    <strong>@solicitud.fecha_fin.ToString("dd/MM/yyyy")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@diasSolicitados días</span>
                                </td>
                                <td>
                                    @if (solicitud.fecha_solicitud!= null)
                                    {
                                        <span>@solicitud.fecha_solicitud.Value.ToString("dd/MM/yyyy")</span><br>
                                        <small class="text-muted">@solicitud.fecha_solicitud.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin fecha</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge status-@solicitud.Estados.nombre.ToLower()">
                                        @solicitud.Estados.nombre
                                    </span>
                                    @if (solicitud.fecha_aprobacion!= null)
                                    {
                                        <br><small class="text-muted">@solicitud.fecha_aprobacion.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group-vertical" role="group">
                                        <button class="btn-action view" onclick="verDetalles(@solicitud.id_solicitud)" title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        @if (User.IsInRole("Admin") || User.IsInRole("RRHH") || User.IsInRole("Supervisor"))
                                        {
                                            if (solicitud.Estados.nombre == "Pendiente")
                                            {
                                                <button class="btn-action approve" onclick="aprobarSolicitud(@solicitud.id_solicitud, '@solicitud.Vacaciones.Empleados.nombre1 @solicitud.Vacaciones.Empleados.apellido1')" title="Aprobar">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button class="btn-action reject" onclick="rechazarSolicitud(@solicitud.id_solicitud, '@solicitud.Vacaciones.Empleados.nombre1 @solicitud.Vacaciones.Empleados.apellido1')" title="Rechazar">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }

                                            if (User.IsInRole("Admin") || User.IsInRole("RRHH"))
                                            {
                                                <button class="btn-action edit" onclick="editarSolicitud(@solicitud.id_solicitud)" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-calendar-times fa-3x mb-3"></i>
                                    <h5>No hay solicitudes de vacaciones</h5>
                                    <p>Aún no se han registrado solicitudes de vacaciones.</p>
                                    <a href="@Url.Action("Create")" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Crear Primera Solicitud
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row mt-3">
            <div class="col-md-6">
                <p class="text-muted">
                    <i class="fas fa-info-circle"></i>
                    Mostrando <strong id="registrosVisibles">@Model.Count()</strong> de <strong>@Model.Count()</strong> solicitudes
                </p>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">
                    <i class="fas fa-clock"></i>
                    Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // Aplicar filtros en tiempo real
            $('#filtroEstado, #filtroBusqueda, #filtroMes').on('change keyup', function() {
                aplicarFiltros();
            });
        });

        function aplicarFiltros() {
            const tabla = document.getElementById('tablaSolicitudes');
            const filtroEstado = document.getElementById('filtroEstado').value.toLowerCase();
            const textoBusqueda = document.getElementById('filtroBusqueda').value.toLowerCase();
            const filtroMes = document.getElementById('filtroMes').value;
            const filas = tabla.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            let visibles = 0;

            for (let i = 0; i < filas.length; i++) {
                const fila = filas[i];
                if (fila.cells.length === 1) continue; // Skip empty state row

                const estado = fila.getAttribute('data-estado');
                const texto = fila.textContent.toLowerCase();

                const coincideEstado = !filtroEstado || estado === filtroEstado;
                const coincideTexto = !textoBusqueda || texto.includes(textoBusqueda);

                let coincideMes = true;
                if (filtroMes) {
                    const fechaTexto = fila.cells[4].textContent;
                    coincideMes = fechaTexto.includes(filtroMes.replace('-', '/'));
                }

                if (coincideEstado && coincideTexto && coincideMes) {
                    fila.style.display = '';
                    visibles++;
                } else {
                    fila.style.display = 'none';
                }
            }

            document.getElementById('registrosVisibles').textContent = visibles;
        }

        function limpiarFiltros() {
            document.getElementById('filtroEstado').value = '';
            document.getElementById('filtroBusqueda').value = '';
            document.getElementById('filtroMes').value = '';
            aplicarFiltros();
        }

        // Funciones globales
        window.verDetalles = function(id) {
            window.location.href = '@Url.Action("Details")/' + id;
        };

        window.editarSolicitud = function(id) {
            window.location.href = '@Url.Action("Edit")/' + id;
        };

        window.aprobarSolicitud = function(id, empleado) {
            Swal.fire({
                title: '¿Aprobar solicitud?',
                text: `Se aprobará la solicitud de vacaciones para ${empleado}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, aprobar',
                cancelButtonText: 'Cancelar',
                input: 'textarea',
                inputPlaceholder: 'Comentario opcional...'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Aprobar")', {
                        id: id,
                        comentario_respuesta: result.value
                    }, function(data) {
                        if (data.success) {
                            Swal.fire('¡Aprobado!', data.message, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            });
        };

        window.rechazarSolicitud = function(id, empleado) {
            Swal.fire({
                title: '¿Rechazar solicitud?',
                text: `Se rechazará la solicitud de vacaciones para ${empleado}`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, rechazar',
                cancelButtonText: 'Cancelar',
                input: 'textarea',
                inputPlaceholder: 'Motivo del rechazo (recomendado)...',
                inputValidator: (value) => {
                    if (!value || value.trim() === '') {
                        return 'Por favor proporcione un motivo para el rechazo'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Rechazar")', {
                        id: id,
                        comentario_respuesta: result.value
                    }, function(data) {
                        if (data.success) {
                            Swal.fire('Rechazado', data.message, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            });
        };
    </script>
}