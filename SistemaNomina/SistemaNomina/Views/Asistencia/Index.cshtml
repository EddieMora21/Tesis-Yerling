@model IEnumerable<SistemaNomina.Asistencia>

@{
    ViewBag.Title = "Gestión de Asistencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #fd7e14;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .header-asistencia {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: var(--white);
        padding: 2rem 0;
        margin: -15px -15px 30px -15px;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .main-card {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        border: 1px solid var(--neutral-color);
        overflow: hidden;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--secondary-color) 0%, #0f6da3 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        color: var(--white);
        font-weight: 600;
        transition: var(--transition);
        margin-right: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .btn-accent-custom {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        color: var(--white);
        font-weight: 600;
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-accent-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(250, 182, 27, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .table-custom {
        border-radius: 0;
        margin-bottom: 0;
    }

        .table-custom thead th {
            background: var(--primary-color);
            color: var(--white);
            border: none;
            padding: 15px 12px;
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
        }

        .table-custom tbody tr {
            transition: var(--transition);
            border-bottom: 1px solid var(--neutral-color);
        }

            .table-custom tbody tr:hover {
                background: rgba(23, 136, 202, 0.05);
            }

        .table-custom tbody td {
            padding: 12px;
            vertical-align: middle;
            border-top: none;
        }

    .status-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-completo {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
    }

    .status-sin-salida {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
    }

    .status-feriado {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    /* === BOTONES DE ACCIONES (ESTÁNDAR) === */
    .action-buttons {
        display: flex;
        gap: 4px;
        justify-content: center;
        flex-wrap: nowrap;
        min-width: 210px;
    }

    .btn-action {
        padding: 8px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        border: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-width: 65px;
        justify-content: center;
        white-space: nowrap;
    }

    .btn-view {
        background: linear-gradient(135deg, var(--secondary-color), #0f6da3);
        color: var(--white);
    }

    .btn-view:hover {
        background: linear-gradient(135deg, #0f6da3, #0c5a87);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.3);
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--accent-color), #e09f15);
        color: var(--primary-color);
    }

    .btn-edit:hover {
        background: linear-gradient(135deg, #e09f15, #d18c00);
        color: var(--primary-color);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--danger-color), #c82333);
        color: var(--white);
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, #c82333, #bd2130);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

    .button-group {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    /* === RESPONSIVE DESIGN === */
    @@media (max-width: 1200px) {
        .action-buttons {
            min-width: 190px;
        }

        .btn-action {
            min-width: 60px;
            padding: 6px 10px;
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 992px) {
        .table-custom thead th {
            padding: 1rem 0.7rem;
            font-size: 0.85rem;
        }

        .table-custom tbody td {
            padding: 0.8rem 0.7rem;
        }

        .action-buttons {
            min-width: 170px;
            gap: 3px;
        }

        .btn-action {
            min-width: 55px;
            padding: 6px 8px;
            font-size: 0.7rem;
        }

        .btn-action .btn-text {
            display: none; /* Oculta el texto, solo muestra iconos */
        }
    }

    @@media (max-width: 768px) {
        .header-asistencia {
            padding: 1.5rem 0;
            margin: -15px -15px 20px -15px;
        }

            .header-asistencia h2 {
                font-size: 1.5rem;
            }

        .button-group {
            flex-direction: column;
            width: 100%;
        }

        .btn-primary-custom,
        .btn-accent-custom {
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }

        .action-buttons {
            min-width: 160px;
            gap: 2px;
        }

        .btn-action {
            min-width: 50px;
            padding: 5px 6px;
            font-size: 0.7rem;
        }

        .btn-action i {
            font-size: 0.8rem;
        }
    }

   @@media (max-width: 576px) {
        .action-buttons {
            flex-direction: column;
            min-width: 80px;
            gap: 2px;
        }

        .btn-action {
            width: 100%;
            min-width: auto;
            padding: 4px;
            font-size: 0.65rem;
        }
    }

    /* Scroll horizontal personalizado */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--secondary-color);
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: var(--primary-color);
    }
</style>

<div class="container" style="max-width: 1200px;">
    <div class="header-asistencia">
        <div class="container">
            <h2 class="mb-0">
                <i class="fa fa-clock" style="font-size: 2rem; margin-right: 15px;"></i>
                Gestión de Asistencias
            </h2>
            <p class="mb-0 mt-2" style="opacity: 0.9;">Control y seguimiento de horarios laborales</p>
        </div>
    </div>

    <div class="main-card">
        <div style="padding: 25px 25px 15px 25px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: var(--primary-color); font-weight: 600; margin: 0;">
                    <i class="fa fa-list" style="margin-right: 10px; color: var(--secondary-color);"></i>
                    Registros de Asistencia
                </h4>
                <div class="button-group">
                    @Html.ActionLink("Marcar Asistencia", "Marcar", null, new { @class = "btn-accent-custom" })
                    @Html.ActionLink("Nueva Asistencia", "Create", null, new { @class = "btn-primary-custom" })
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table-custom table">
                <thead>
                    <tr>
                        <th><i class="fa fa-calendar" style="margin-right: 8px;"></i>Fecha</th>
                        <th><i class="fa fa-user" style="margin-right: 8px;"></i>Empleado</th>
                        <th><i class="fa fa-sign-in" style="margin-right: 8px;"></i>Entrada</th>
                        <th><i class="fa fa-sign-out" style="margin-right: 8px;"></i>Salida</th>
                        <th><i class="fa fa-clock" style="margin-right: 8px;"></i>Horas</th>
                        <th><i class="fa fa-toggle-on" style="margin-right: 8px;"></i>Estado</th>
                        <th><i class="fa fa-calendar-check" style="margin-right: 8px;"></i>Feriado</th>
                        <th class="text-center"><i class="fa fa-cogs" style="margin-right: 8px;"></i>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 500; color: var(--primary-color);">
                                @item.fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td style="color: var(--text-color);">
                                @item.Empleados.nombre1 @item.Empleados.apellido1
                                <br><small style="color: var(--text-muted);">@item.Empleados.cedula</small>
                            </td>
                            <td>
                                @if (item.hora_entrada != null)
                                {
                                    <span style="font-family: monospace; font-weight: 600; color: var(--success-color);">
                                        @item.hora_entrada.Value.ToString(@"hh\:mm")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_salida != null)
                                {
                                    <span style="font-family: monospace; font-weight: 600; color: var(--danger-color);">
                                        @item.hora_salida.Value.ToString(@"hh\:mm")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada != null && item.hora_salida != null)
                                {
                                    var horas = (item.hora_salida.Value - item.hora_entrada.Value).TotalHours;
                                    <span style="font-weight: 600; color: var(--secondary-color);">
                                        @Math.Round(horas, 2) hrs
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted);">-</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada != null && item.hora_salida != null)
                                {
                                    <span class="status-badge status-completo">Completo</span>
                                }
                                else if (item.hora_entrada != null)
                                {
                                    <span class="status-badge status-sin-salida">Sin Salida</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%); color: #721c24;">Sin Entrada</span>
                                }
                            </td>
                            <td>
                                @if (item.es_feriado == true)
                                {
                                    <span class="status-badge status-feriado">
                                        @(item.Feriados != null ? item.Feriados.nombre : "Feriado")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted);">-</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", new { id = item.id_asistencia })"
                                       class="btn-action btn-view"
                                       title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                        <span class="btn-text">Ver</span>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.id_asistencia })"
                                       class="btn-action btn-edit"
                                       title="Editar asistencia">
                                        <i class="fas fa-edit"></i>
                                        <span class="btn-text">Editar</span>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.id_asistencia })"
                                       class="btn-action btn-delete"
                                       title="Eliminar asistencia"
                                       onclick="return confirm('¿Está seguro de que desea eliminar este registro de asistencia?');">
                                        <i class="fas fa-trash"></i>
                                        <span class="btn-text">Eliminar</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="padding: 15px 25px;">
            <p style="color: var(--text-muted); font-style: italic; margin: 0; font-size: 14px;">
                <i class="fa fa-info-circle" style="margin-right: 5px;"></i>
                Total de registros de asistencia: @Model.Count()
            </p>
        </div>
    </div>
</div>