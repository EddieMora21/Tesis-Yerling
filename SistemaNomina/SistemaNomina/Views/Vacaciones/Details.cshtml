@model SistemaNomina.Vacaciones

@{
    ViewBag.Title = "Detalles de Vacaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(34, 29, 66, 0.2);
    }

    .page-header-custom h1 {
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .page-header-custom p {
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .details-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .details-card-header {
        background: linear-gradient(135deg, #1788ca 0%, #0d6efd 100%);
        color: white;
        padding: 1.5rem 2rem;
        text-shadow: 0 1px 2px rgba(0,0,0,0.2);
    }

    .details-card-header h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 1rem 0;
    }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1rem;
    }

    .employee-id {
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
        margin-left: auto;
    }

    .details-card-body {
        padding: 2rem;
    }

    .details-section {
        margin-bottom: 2.5rem;
    }

    .details-section:last-child {
        margin-bottom: 0;
    }

    .details-section h4 {
        color: #221d42;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid #e7e8eb;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #221d42;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: 1;
    }

    .detail-value {
        flex: 2;
        text-align: right;
        color: #495057;
    }

    .badge-custom {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .badge-primary {
        background: linear-gradient(135deg, #1788ca 0%, #0d6efd 100%);
        color: white;
    }

    .badge-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .badge-warning {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
    }

    .progress-container {
        background: #e7e8eb;
        border-radius: 8px;
        overflow: hidden;
        height: 12px;
        margin: 0.5rem 0;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(135deg, #1788ca 0%, #28a745 100%);
        transition: width 0.3s ease;
        border-radius: 8px;
    }

    .alert-success-custom {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #28a745;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #fab61b;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .action-buttons-container {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
        padding: 2rem;
        background: #f8f9fa;
        border-radius: 15px;
        border: 1px solid #e7e8eb;
    }

    .btn-warning-custom {
        background: linear-gradient(135deg, #fab61b 0%, #e67e22 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(250, 182, 27, 0.3);
    }

    .btn-warning-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-info-custom {
        background: linear-gradient(135deg, #1788ca 0%, #0d7ab0 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(23, 136, 202, 0.3);
    }

    .btn-info-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(108, 117, 125, 0.3);
    }

    .btn-secondary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.4);
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .details-card-body {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .detail-value {
            text-align: left;
        }

        .action-buttons-container {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-warning-custom,
        .btn-info-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-calendar-alt"></i> Detalles de Vacaciones</h1>
                <p class="mb-0">Información completa del registro de vacaciones</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1000px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Card de detalles del empleado -->
            <div class="details-card">
                <div class="details-card-header">
                    <h3><i class="fas fa-user"></i> @Model.Empleados.nombre1 @Model.Empleados.apellido1 @Model.Empleados.apellido2</h3>
                    <div class="employee-info">
                        <span><i class="fas fa-id-card"></i> Cédula: @Model.Empleados.cedula</span>
                        <span class="employee-id">ID Empleado: @Model.id_empleado</span>
                    </div>
                </div>

                <div class="details-card-body">
                    <!-- Información del Período -->
                    <div class="details-section">
                        <h4><i class="fas fa-calendar"></i> Información del Período</h4>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-clock"></i>
                                Período de Vacaciones
                            </div>
                            <div class="detail-value">
                                <span class="badge-custom badge-primary">
                                    <i class="fas fa-calendar-year"></i>
                                    @Html.DisplayFor(model => model.periodo)
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Estado de Vacaciones -->
                    <div class="details-section">
                        <h4><i class="fas fa-chart-pie"></i> Utilización de Vacaciones</h4>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-plus-circle"></i>
                                Días Disponibles
                            </div>
                            <div class="detail-value">
                                <strong style="color: #28a745; font-size: 1.2rem;">@Html.DisplayFor(model => model.dias_disponibles) días</strong>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-minus-circle"></i>
                                Días Disfrutados
                            </div>
                            <div class="detail-value">
                                <strong style="color: #dc3545; font-size: 1.2rem;">@Html.DisplayFor(model => model.dias_disfrutados) días</strong>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-clock"></i>
                                Días Restantes
                            </div>
                            <div class="detail-value">
                                @{
                                    // CORRECCIÓN: Sin nullable - son tipos int normales
                                    int diasDisponibles = Model.dias_disponibles;
                                    int diasDisfrutados = Model.dias_disfrutados;
                                    int diasRestantes = diasDisponibles - diasDisfrutados;
                                }
                                <strong style="color: #1788ca; font-size: 1.2rem;">@diasRestantes días</strong>
                            </div>
                        </div>

                        <!-- Barra de progreso -->
                        
                    </div>

                    <!-- Información de Registro -->
                    <div class="details-section">
                        <h4><i class="fas fa-info-circle"></i> Información de Registro</h4>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-calendar-plus"></i>
                                Fecha de Creación
                            </div>
                            <div class="detail-value">
                                @Html.DisplayFor(model => model.fecha_creacion)
                            </div>
                        </div>

                        @if (Model.fecha_actualizacion!= null)
                        {
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-history"></i>
                                    Última Actualización
                                </div>
                                <div class="detail-value">
                                    @Html.DisplayFor(model => model.fecha_actualizacion)
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Alertas de Estado -->
                    <div class="details-section">
                        @if (diasRestantes > 0)
                        {
                            <div class="alert-success-custom">
                                <i class="fas fa-check-circle"></i>
                                <div>
                                    <strong>Estado del Registro</strong><br>
                                    El empleado tiene @diasRestantes días de vacaciones disponibles para solicitar.
                                </div>
                            </div>
                        }
                        else if (diasRestantes == 0)
                        {
                            <div class="alert-warning-custom">
                                <i class="fas fa-exclamation-triangle"></i>
                                <div>
                                    <strong>Vacaciones Agotadas</strong><br>
                                    El empleado ha utilizado todos los días de vacaciones disponibles. Revisar registro.
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="action-buttons-container">
                <a href="@Url.Action("Edit", new { id = Model.id_vacacion })" class="btn-warning-custom">
                    <i class="fas fa-edit"></i> Editar Registro
                </a>
                <a href="@Url.Action("Index", "SolicitudesVacaciones", new { empleadoId = Model.id_empleado })" class="btn-info-custom">
                    <i class="fas fa-list"></i> Ver Solicitudes
                </a>
                <a href="@Url.Action("Index")" class="btn-secondary-custom">
                    <i class="fas fa-arrow-left"></i> Volver a Lista
                </a>
            </div>
        </div>
    </div>
</div>