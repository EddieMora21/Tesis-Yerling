@model SistemaNomina.TiposHoraExtra
@{
    ViewBag.Title = "Eliminar Tipo de Hora Extra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .warning-card {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border-left: 4px solid #fab61b;
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.1);
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: flex-start;
        padding: 1rem 0;
        border-bottom: 1px solid #e7e8eb;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #221d42;
        min-width: 200px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        flex: 1;
        color: #495057;
        font-size: 1.1rem;
    }

        .detail-value strong {
            color: #221d42;
        }

    .badge-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 1.1rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .date-badge {
        background: linear-gradient(135deg, #e7e8eb 0%, #e7e8eb 100%);
        color: #6c757d;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-block;
    }

    .description-box {
        background: #f8f9fa;
        border-left: 4px solid #dc3545;
        padding: 1.5rem;
        border-radius: 8px;
        font-style: italic;
        line-height: 1.6;
        margin-top: 1rem;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 1rem;
    }

        .btn-danger-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
            color: white;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .danger-icon {
        font-size: 4rem;
        color: #dc3545;
        text-align: center;
        margin-bottom: 1rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

            .page-header-custom h1 {
                font-size: 1.5rem;
            }

        .warning-card,
        .card-custom {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            min-width: auto;
            margin-bottom: 0.5rem;
        }

        .btn-danger-custom,
        .btn-secondary-custom {
            width: 100%;
            margin-bottom: 0.5rem;
            justify-content: center;
            margin-right: 0;
        }
    }
</style>

<!-- Header de la página -->
<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-exclamation-triangle" style="font-size: 2rem; margin-right: 15px;"></i>
                    Eliminar Tipo de Hora Extra
                </h1>
                <p class="mb-0" style="opacity: 0.9; margin-top: 0.5rem;">
                    Confirme la eliminación del registro seleccionado
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Contenido principal -->
<div class="container" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Advertencia principal -->
            <div class="warning-card">
                <div class="danger-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h4 class="text-center" style="color: #221d42; font-weight: 600; margin-bottom: 1rem;">
                    ¿Está seguro de que desea eliminar este tipo de hora extra?
                </h4>
                <p class="mb-0 text-center" style="color: #6c757d;">
                    Esta acción no se puede deshacer. Una vez eliminado, el registro se perderá permanentemente.
                </p>
            </div>

            <!-- Información del registro a eliminar -->
            <div class="card-custom">
                <h4 style="color: #221d42; margin-bottom: 1.5rem; font-weight: 600;">
                    <i class="fas fa-info-circle"></i>
                    Información del Registro a Eliminar
                </h4>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-tag"></i>
                        @Html.DisplayNameFor(model => model.nombre)
                    </div>
                    <div class="detail-value">
                        <strong>@Html.DisplayFor(model => model.nombre)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-percentage"></i>
                        @Html.DisplayNameFor(model => model.recargo)
                    </div>
                    <div class="detail-value">
                        <span class="badge-custom">
                            <i class="fas fa-plus"></i>
                            @Html.DisplayFor(model => model.recargo)%
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        @Html.DisplayNameFor(model => model.fecha_creacion)
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_creacion)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-edit"></i>
                        @Html.DisplayNameFor(model => model.fecha_actualizacion)
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_actualizacion)
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.descripcion))
                {
                    <div class="description-box">
                        <strong>Descripción:</strong><br>
                        @Html.DisplayFor(model => model.descripcion)
                    </div>
                }
            </div>

            <!-- Formulario de confirmación -->
            <div class="card-custom">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="text-center">
                        <hr style="margin: 2rem 0; border-color: #e7e8eb;">
                        <h5 style="color: #dc3545; margin-bottom: 1.5rem;">
                            <i class="fas fa-question-circle"></i>
                            ¿Confirma que desea proceder con la eliminación?
                        </h5>

                        <button type="submit" class="btn btn-danger-custom">
                            <i class="fas fa-trash"></i>
                            Sí, Eliminar Permanentemente
                        </button>

                        @Html.ActionLink("No, Cancelar", "Index", null, new
                        {
                            @class = "btn btn-secondary-custom"
                        })
                    </div>
                }
            </div>

            <!-- Información adicional sobre las consecuencias -->
            <div class="mt-4 p-3" style="background: #f8d7da; border-radius: 10px; border-left: 4px solid #dc3545;">
                <h6 style="color: #721c24; margin-bottom: 0.5rem;">
                    <i class="fas fa-exclamation-circle"></i>
                    Consecuencias de la eliminación
                </h6>
                <ul class="mb-0" style="font-size: 0.875rem; color: #721c24;">
                    <li>Este tipo de hora extra no estará disponible para nuevos registros</li>
                    <li>Los registros existentes que usen este tipo pueden verse afectados</li>
                    <li>Se recomienda verificar que no existan dependencias antes de eliminar</li>
                    <li>Esta acción no se puede revertir</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Agregar confirmación adicional al formulario
        $('form').on('submit', function (e) {
            if (!confirm('¿ESTÁ COMPLETAMENTE SEGURO de que desea eliminar este tipo de hora extra?\n\nEsta acción NO se puede deshacer.')) {
                e.preventDefault();
                return false;
            }
        });
    });
</script>