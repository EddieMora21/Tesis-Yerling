@model SistemaNomina.Models.Feriados
@{
    ViewBag.Title = "Crear Feriado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.2);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        padding: 2rem;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control-custom:focus {
            border-color: #1788ca;
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
            outline: none;
        }

    .checkbox-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        border: 2px solid #e7e8eb;
        transition: all 0.3s ease;
    }

        .checkbox-custom:hover {
            border-color: #1788ca;
            background: #e7f3ff;
        }

        .checkbox-custom input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #1788ca;
        }

        .checkbox-custom label {
            margin: 0;
            font-weight: 500;
            color: #221d42;
            cursor: pointer;
        }

    .btn-success-custom {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-success-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
            color: white;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .help-text {
        color: #6c757d;
        font-size: 0.875rem;
        font-style: italic;
        margin-top: 0.25rem;
    }

    .validation-summary-custom {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border-left: 4px solid #dc3545;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .text-danger {
        color: #dc3545 !important;
        font-size: 0.875rem;
    }

    .required-field::after {
        content: " *";
        color: #dc3545;
    }

    .date-info-card {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        border-left: 4px solid #1788ca;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

            .page-header-custom h1 {
                font-size: 1.5rem;
            }

        .card-custom {
            padding: 1.5rem;
        }

        .btn-success-custom,
        .btn-secondary-custom {
            width: 100%;
            margin-bottom: 0.5rem;
            justify-content: center;
        }
    }
</style>

<!-- Header de la página -->
<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-plus-circle" style="font-size: 2rem; margin-right: 15px;"></i>
                    Crear Feriado
                </h1>
                <p class="mb-0" style="opacity: 0.9; margin-top: 0.5rem;">
                    Registre un nuevo día feriado con sus políticas de pago
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Contenido principal -->
<div class="container" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-custom" })

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.nombre, new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.nombre, new
                   {
                       htmlAttributes = new
                       {
                           @class = "form-control form-control-custom",
                           placeholder = "Ej: Día de la Independencia, Navidad, Año Nuevo",
                           maxlength = "100"
                       }
                   })
                        @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i>
                            Nombre del día feriado (máximo 100 caracteres)
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.fecha, new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.fecha, new
                   {
                       htmlAttributes = new
                       {
                           @class = "form-control form-control-custom",
                           type = "date"
                       }
                   })
                        @Html.ValidationMessageFor(model => model.fecha, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-calendar-alt"></i>
                            Fecha exacta del feriado
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.pago_obligatorio, new { @class = "form-label-custom" })
                        <div class="checkbox-custom">
                            @Html.EditorFor(model => model.pago_obligatorio)
                            <label for="pago_obligatorio">
                                <i class="fas fa-money-bill-wave mr-2"></i>
                                Este feriado requiere pago obligatorio
                            </label>
                        </div>
                        @Html.ValidationMessageFor(model => model.pago_obligatorio, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i>
                            Marque si es un feriado de pago obligatorio según la ley laboral
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.recargo, new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.recargo, new
                   {
                       htmlAttributes = new
                       {
                           @class = "form-control form-control-custom",
                           placeholder = "Ej: 100.00 (para 100% adicional)",
                           type = "number",
                           step = "0.01",
                           min = "0",
                           max = "500"
                       }
                   })
                        @Html.ValidationMessageFor(model => model.recargo, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-percentage"></i>
                            Porcentaje de recargo por trabajar en este feriado (ej: 100 = doble pago)
                        </div>
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.descripcion, new { @class = "form-label-custom" })
                        @Html.TextAreaFor(model => model.descripcion, new
                        {
                            @class = "form-control form-control-custom",
                            rows = "4",
                            placeholder = "Descripción del feriado, tradiciones, importancia histórica...",
                            maxlength = "500"
                        })
                        @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i>
                            Descripción opcional del feriado (máximo 500 caracteres)
                        </div>
                    </div>

                    <!-- Campo de fecha de creación EDITABLE -->
                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.fecha_creacion, new { @class = "form-label-custom required-field" })
                        @Html.EditorFor(model => model.fecha_creacion, new
                   {
                       htmlAttributes = new
                       {
                           @class = "form-control form-control-custom",
                           type = "datetime-local",
                           value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
                       } })
                        @Html.ValidationMessageFor(model => model.fecha_creacion, "", new { @class = "text-danger" })
                        <div class="help-text">
                            <i class="fas fa-calendar-plus"></i>
                            Fecha y hora de creación del registro
                        </div>
                    </div>

                    <!-- Campo de fecha de actualización oculto -->
                    @Html.HiddenFor(model => model.fecha_actualizacion)

                    <div class="form-group-custom text-center">
                        <hr style="margin: 2rem 0; border-color: #e7e8eb;">
                        <button type="submit" class="btn btn-success-custom mr-3">
                            <i class="fas fa-save"></i>
                            Crear Feriado
                        </button>
                        @Html.ActionLink("Cancelar", "Index", null, new
                        {
                            @class = "btn btn-secondary-custom"
                        })
                    </div>
                }
            </div>

            <!-- Información sobre feriados -->
            <div class="date-info-card">
                <h6 style="color: #221d42; margin-bottom: 0.5rem;">
                    <i class="fas fa-calendar-day text-info"></i>
                    Información sobre feriados
                </h6>
                <ul class="mb-0" style="font-size: 0.875rem; color: #6c757d;">
                    <li><strong>Pago obligatorio:</strong> Feriados establecidos por ley que requieren pago</li>
                    <li><strong>Recargo:</strong> Porcentaje adicional por trabajar en el feriado</li>
                    <li><strong>Ejemplo:</strong> 100% de recargo = se paga el doble del salario normal</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function() {
            // Validación para el recargo
            $('#recargo').on('input', function() {
                var value = parseFloat($(this).val());
                if (value < 0) {
                    $(this).val(0);
                }
                if (value > 500) {
                    $(this).val(500);
                }
            });

            // Contador de caracteres para descripción
            var maxLength = 500;
            $('#descripcion').on('input', function() {
                var currentLength = $(this).val().length;
                var remaining = maxLength - currentLength;

                if (!$('#char-counter').length) {
                    $(this).after('<div id="char-counter" class="help-text mt-1"></div>');
                }

                $('#char-counter').text(remaining + ' caracteres restantes')
                    .removeClass('text-danger')
                    .addClass(remaining < 50 ? 'text-danger' : '');
            });

            // Validación de fecha
            $('#fecha').on('change', function() {
                var selectedDate = new Date($(this).val());
                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (selectedDate < today) {
                    if (!confirm('Ha seleccionado una fecha pasada. ¿Está seguro de continuar?')) {
                        $(this).val('');
                    }
                }
            });
        });
    </script>
}