@model SistemaNomina.Estados

@{
    ViewBag.Title = "Eliminar Estado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* === VARIABLES DE COLORES CORPORATIVOS === */
    :root {
        --color-primario: #221d42;
        --color-secundario: #1788ca;
        --color-acento: #fab61b;
        --color-neutro: #e7e8eb;
        --color-danger: #dc3545;
        --color-blanco: #ffffff;
        --color-texto: #495057;
        --color-texto-claro: #6c757d;
    }

    /* HEADER MÁS AMIGABLE */
    .page-header {
        background: linear-gradient(135deg, var(--color-primario) 0%, var(--color-secundario) 100%);
        color: var(--color-blanco);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
    }

    .page-title {
        
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .delete-card {
        background: var(--color-blanco);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        overflow: hidden;
        border: 1px solid var(--color-neutro);
    }

    /* HEADER SUAVE SIN COLOR AGRESIVO */
    .delete-header {
        background: linear-gradient(135deg, #f8f9fa 0%, var(--color-neutro) 100%);
        padding: 1.5rem;
        border-bottom: 1px solid var(--color-neutro);
        color: var(--color-primario);
    }

    .delete-header h4 {
        margin: 0;
        font-weight: 600;
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .delete-header .warning-icon {
        color: var(--color-acento);
        font-size: 1.5rem;
    }

    /* MENSAJE DE ADVERTENCIA MÁS SUAVE */
    .warning-message {
        background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
        border: 1px solid #ffcc02;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        color: #e65100;
        font-weight: 500;
        text-align: center;
        border-left: 4px solid var(--color-acento);
    }

    .warning-message i {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
        display: block;
        color: var(--color-acento);
    }

    .delete-body {
        padding: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid var(--color-neutro);
    }

    .detail-row:last-child {
        border-bottom: none;
        margin-bottom: 1rem;
    }

    .detail-label {
        font-weight: 600;
        color: var(--color-primario);
        font-size: 1rem;
        min-width: 120px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        font-size: 1rem;
        color: var(--color-texto);
        margin-left: 2rem;
    }

    .badge-modulo {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
        min-width: 100px;
        text-align: center;
    }

    .modulo-vacaciones {
        background: linear-gradient(135deg, var(--color-secundario), #0f6da3);
        color: var(--color-blanco);
    }

    .modulo-permisos {
        background: linear-gradient(135deg, var(--color-acento), #e09f15);
        color: var(--color-primario);
    }

    .modulo-asistencia {
        background: linear-gradient(135deg, #28a745, #1e7e34);
        color: var(--color-blanco);
    }

    .modulo-horasextras {
        background: linear-gradient(135deg, #6f42c1, #5a32a3);
        color: var(--color-blanco);
    }

    .modulo-incapacidades {
        background: linear-gradient(135deg, var(--color-danger), #c82333);
        color: var(--color-blanco);
    }

    .modulo-nomina, .modulo-nómina {
        background: linear-gradient(135deg, #20c997, #17a085);
        color: var(--color-blanco);
    }

    .estado-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-primario);
        background: linear-gradient(135deg, #f8f9fa, var(--color-neutro));
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid var(--color-secundario);
    }

    .button-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-neutro);
        justify-content: center;
    }

    /* BOTÓN DE ELIMINAR MÁS SUAVE */
    .btn-danger-custom {
        background: linear-gradient(135deg, #e57373, #f44336);
        border: none;
        color: var(--color-blanco);
        font-weight: 600;
        padding: 12px 30px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-danger-custom:hover {
        background: linear-gradient(135deg, #f44336, #d32f2f);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(244, 67, 54, 0.3);
        color: var(--color-blanco);
    }

    .btn-danger-custom:disabled {
        background: linear-gradient(135deg, #bdbdbd, #9e9e9e);
        cursor: not-allowed;
        opacity: 0.7;
    }

    .btn-secondary-custom {
        background: var(--color-neutro);
        border: 2px solid var(--color-neutro);
        color: var(--color-primario);
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary-custom:hover {
        background: #d6d8db;
        border-color: #d6d8db;
        color: var(--color-primario);
        text-decoration: none;
        transform: translateY(-1px);
    }

    /* MENSAJE DE REGISTROS ASOCIADOS MÁS SUAVE */
    .records-warning {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: 1px solid #ffcdd2;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        color: #c62828;
        font-weight: 500;
        text-align: center;
        border-left: 4px solid #e57373;
    }

    .records-warning i {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
        display: block;
        color: #e57373;
    }

    /* === RESPONSIVE === */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem 0;
        }

        .page-title {
            font-size: 1.6rem;
            flex-direction: column;
            gap: 0.5rem;
            text-align: center;
        }

        .delete-body {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .detail-label {
            min-width: auto;
        }

        .detail-value {
            margin-left: 0;
            width: 100%;
        }

        .button-group {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-danger-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }
    }
    .page-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--color-blanco) !important; /* ✅ AGREGADO PARA FORZAR COLOR BLANCO */
    }

        .page-title i {
            color: var(--color-blanco); /* ✅ AGREGADO PARA EL ICONO TAMBIÉN */
        }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-question-circle"></i>
            Confirmar Acción
        </h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="delete-card">
                <div class="delete-header">
                    <h4>
                        <i class="fas fa-exclamation-triangle warning-icon"></i>
                        Eliminar Estado
                    </h4>
                </div>

                <div class="delete-body">
                    <!-- Verificar si hay registros asociados -->
                    @if (ViewBag.RegistrosAsociados != null && ViewBag.RegistrosAsociados > 0)
                    {
                        <div class="records-warning">
                            <i class="fas fa-info-circle"></i>
                            <strong>No se puede eliminar este estado</strong>
                            <br>
                            Está siendo utilizado por @ViewBag.RegistrosAsociados @ViewBag.TipoRegistros.
                            <br><br>
                            <small>Para eliminarlo, primero cambie el estado de todos los registros asociados.</small>
                        </div>
                    }
                    else
                    {
                        <div class="warning-message">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>¿Confirma que desea eliminar este estado?</strong>
                            <br>
                            Esta acción no se puede deshacer.
                        </div>
                    }

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-tag"></i>
                            Nombre:
                        </div>
                        <div class="detail-value">
                            <div class="estado-name">@Model.nombre</div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-cube"></i>
                            Módulo:
                        </div>
                        <div class="detail-value">
                            <span class="badge-modulo modulo-@(Model.modulo?.ToLower().Replace(" ", "").Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ó", "o").Replace("ú", "u") ?? "default")">
                                @Model.modulo
                            </span>
                        </div>
                    </div>

                    <!-- Formulario con AntiForgeryToken -->
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="button-group">
                            @if (ViewBag.RegistrosAsociados == null || ViewBag.RegistrosAsociados == 0)
                            {
                                <button type="submit" class="btn-danger-custom" onclick="return confirm('¿Está completamente seguro de eliminar este estado? Esta acción es irreversible.');">
                                    <i class="fas fa-check"></i>
                                    Sí, Eliminar
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-danger-custom" disabled title="No se puede eliminar">
                                    <i class="fas fa-ban"></i>
                                    No se puede eliminar
                                </button>
                            }
                            <a href="@Url.Action("Index")" class="btn-secondary-custom">
                                <i class="fas fa-times"></i>
                                Cancelar
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>