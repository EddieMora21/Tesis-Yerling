@{
    ViewBag.Title = "Reportes de Asistencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .header-reportes {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin: -15px -15px 30px -15px;
        border-radius: 0 0 15px 15px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .main-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .filters-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #1788ca;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .form-control-custom:focus {
            border-color: #1788ca;
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
            outline: none;
        }

    .control-label-custom {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
        width: 100%;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
            color: white;
        }

    .section-title {
        color: #221d42;
        font-weight: 600;
        border-bottom: 2px solid #1788ca;
        padding-bottom: 10px;
        margin-bottom: 25px;
    }

    .help-text {
        color: #6c757d;
        font-style: italic;
        font-size: 12px;
        margin-top: 4px;
    }

    .results-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        margin-top: 25px;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state {
        text-align: center;
        color: #6c757d;
        padding: 40px 20px;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #e7e8eb;
        }

    .loading-state {
        text-align: center;
        color: #1788ca;
        padding: 40px 20px;
        display: none;
    }

    .loading-spinner {
        border: 4px solid #e7e8eb;
        border-top: 4px solid #1788ca;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px auto;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .filter-icon {
        margin-right: 8px;
        color: #1788ca;
    }

    /* 🎯 VALIDACIÓN DE CAMPOS */
    .form-control-custom.error {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
    }

    .error-message {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }

    @@media (max-width: 768px) {
        .header-reportes {
            padding: 1.5rem 0;
            margin: -15px -15px 20px -15px;
        }

        .filters-card {
            padding: 20px 15px;
        }
    }
</style>

<div class="container" style="max-width: 1200px;">
    <div class="header-reportes">
        <div class="container">
            <h2 class="mb-0">
                <i class="fa fa-chart-bar" style="font-size: 2rem; margin-right: 15px;"></i>
                Reportes de Asistencia
            </h2>
            <p class="mb-0 mt-2" style="opacity: 0.9;">Genera informes detallados de asistencia y puntualidad</p>
        </div>
    </div>

    <div class="main-card">
        <div style="padding: 25px;">
            <h4 class="section-title">
                <i class="fa fa-filter" style="margin-right: 10px; color: #1788ca;"></i>
                Filtros de Búsqueda
            </h4>

            <div class="filters-card">
                @using (Html.BeginForm("GenerarReporte", "Asistencia", FormMethod.Post, new { @id = "formReporte" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label-custom">
                                    <i class="filter-icon fa fa-user"></i>
                                    Empleado
                                </label>
                                @Html.DropDownList("empleadoId", ViewBag.Empleados as SelectList, "-- Todos los empleados --", new { @class = "form-control form-control-custom", @id = "empleadoSelect" })
                                <small class="help-text">Selecciona un empleado específico o deja en blanco para todos</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label-custom">
                                    <i class="filter-icon fa fa-building"></i>
                                    Departamento
                                </label>
                                @Html.DropDownList("departamentoId", ViewBag.Departamentos as SelectList, "-- Todos los departamentos --", new { @class = "form-control form-control-custom" })
                                <small class="help-text">Filtra por departamento específico</small>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label-custom">
                                    <i class="filter-icon fa fa-calendar"></i>
                                    Fecha Inicio <span style="color: red;">*</span>
                                </label>
                                <input type="date" name="fechaInicio" id="fechaInicio" class="form-control form-control-custom" required />
                                <small class="help-text">Fecha de inicio del período</small>
                                <span class="error-message" id="errorFechaInicio" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label-custom">
                                    <i class="filter-icon fa fa-calendar"></i>
                                    Fecha Fin <span style="color: red;">*</span>
                                </label>
                                <input type="date" name="fechaFin" id="fechaFin" class="form-control form-control-custom" required />
                                <small class="help-text">Fecha de fin del período</small>
                                <span class="error-message" id="errorFechaFin" style="display: none;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <button type="submit" class="btn-primary-custom">
                                    <i class="fa fa-search" style="margin-right: 8px;"></i>
                                    Generar Reporte
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="results-container" id="resultadoReporte">
        <div class="empty-state">
            <i class="fa fa-chart-bar"></i>
            <h5 style="color: #221d42; margin-bottom: 10px;">Reportes de Asistencia</h5>
            <p style="margin: 0;">Selecciona los filtros deseados y haz clic en "Generar Reporte" para visualizar los datos de asistencia.</p>
            <br />
            <small style="color: #6c757d;">📋 Los campos marcados con (*) son obligatorios</small>
        </div>
        <div class="loading-state" id="loadingState">
            <div class="loading-spinner"></div>
            <h5 style="margin-bottom: 10px;">Generando Reporte</h5>
            <p style="margin: 0;">Procesando datos de asistencia...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 🎯 VALIDACIÓN EN TIEMPO REAL
            $('#fechaInicio, #fechaFin').on('change', function() {
                validarFechas();
            });

            // 🎯 VALIDAR FORMULARIO ANTES DE ENVIAR
            $('#formReporte').submit(function (e) {
                e.preventDefault();

                if (!validarFormulario()) {
                    return false;
                }

                // Mostrar estado de carga
                $('.empty-state').hide();
                $('#loadingState').show();

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        $('#loadingState').hide();
                        $('#resultadoReporte').html(response);
                    },
                    error: function (xhr, status, error) {
                        $('#loadingState').hide();
                        $('#resultadoReporte').html(
                            '<div style="text-align: center; padding: 40px; color: #dc3545;">' +
                            '<i class="fa fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: 15px;"></i>' +
                            '<h5>Error al generar el reporte</h5>' +
                            '<p>Ha ocurrido un error al procesar la solicitud. Por favor, inténtalo de nuevo.</p>' +
                            '<small>Error técnico: ' + error + '</small>' +
                            '</div>'
                        );
                        showNotification('Error al generar el reporte', 'error');
                    }
                });
            });
        });

        // 🎯 FUNCIÓN DE VALIDACIÓN COMPLETA
        function validarFormulario() {
            var isValid = true;

            // Limpiar errores previos
            $('.form-control-custom').removeClass('error');
            $('.error-message').hide();

            var fechaInicio = $('#fechaInicio').val();
            var fechaFin = $('#fechaFin').val();

            // Validar fecha inicio
            if (!fechaInicio) {
                $('#fechaInicio').addClass('error');
                $('#errorFechaInicio').text('La fecha de inicio es obligatoria').show();
                isValid = false;
            }

            // Validar fecha fin
            if (!fechaFin) {
                $('#fechaFin').addClass('error');
                $('#errorFechaFin').text('La fecha de fin es obligatoria').show();
                isValid = false;
            }

            // Validar que fecha inicio no sea mayor a fecha fin
            if (fechaInicio && fechaFin && new Date(fechaInicio) > new Date(fechaFin)) {
                $('#fechaInicio').addClass('error');
                $('#fechaFin').addClass('error');
                $('#errorFechaFin').text('La fecha de fin debe ser mayor o igual a la fecha de inicio').show();
                showNotification('Las fechas seleccionadas no son válidas', 'error');
                isValid = false;
            }

            // Validar que el rango no sea mayor a 1 año
            if (fechaInicio && fechaFin) {
                var inicio = new Date(fechaInicio);
                var fin = new Date(fechaFin);
                var diffTime = Math.abs(fin - inicio);
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                if (diffDays > 365) {
                    $('#fechaFin').addClass('error');
                    $('#errorFechaFin').text('El rango de fechas no puede ser mayor a 1 año').show();
                    showNotification('El rango de fechas es demasiado amplio', 'warning');
                    isValid = false;
                }
            }

            return isValid;
        }

        // 🎯 VALIDACIÓN EN TIEMPO REAL DE FECHAS
        function validarFechas() {
            var fechaInicio = $('#fechaInicio').val();
            var fechaFin = $('#fechaFin').val();

            if (fechaInicio && fechaFin) {
                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    $('#fechaFin').addClass('error');
                    $('#errorFechaFin').text('La fecha de fin debe ser mayor o igual a la fecha de inicio').show();
                } else {
                    $('#fechaInicio, #fechaFin').removeClass('error');
                    $('#errorFechaInicio, #errorFechaFin').hide();
                }
            }
        }

        // 🎯 FUNCIONES DE EXPORTACIÓN (ya incluidas en tu controlador)
        function exportarPDF() {
            if (!validarFormulario()) {
                showNotification('Por favor corrige los errores antes de exportar', 'error');
                return;
            }

            showNotification('Generando reporte PDF...', 'info');

            var formData = $('#formReporte').serialize();

            var form = $('<form>', {
                'method': 'POST',
                'action': '@Url.Action("ExportarReportePDF", "Asistencia")',
                'target': '_blank'
            });

            form.append($('<input>', {
                'type': 'hidden',
                'name': '__RequestVerificationToken',
                'value': $('input[name="__RequestVerificationToken"]').val()
            }));

            var params = new URLSearchParams(formData);
            for (let [key, value] of params) {
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': key,
                    'value': value
                }));
            }

            $('body').append(form);
            form.submit();
            form.remove();

            showNotification('Descarga de PDF iniciada', 'success');
        }

        function exportarExcel() {
            if (!validarFormulario()) {
                showNotification('Por favor corrige los errores antes de exportar', 'error');
                return;
            }

            showNotification('Generando reporte Excel...', 'info');

            var formData = $('#formReporte').serialize();

            var form = $('<form>', {
                'method': 'POST',
                'action': '@Url.Action("ExportarReporteExcel", "Asistencia")',
                'target': '_blank'
            });

            form.append($('<input>', {
                'type': 'hidden',
                'name': '__RequestVerificationToken',
                'value': $('input[name="__RequestVerificationToken"]').val()
            }));

            var params = new URLSearchParams(formData);
            for (let [key, value] of params) {
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': key,
                    'value': value
                }));
            }

            $('body').append(form);
            form.submit();
            form.remove();

            showNotification('Descarga de Excel iniciada', 'success');
        }

        // 🎯 FUNCIÓN PARA MOSTRAR NOTIFICACIONES
        function showNotification(message, type) {
            // Si tienes Toastr configurado
            if (typeof toastr !== 'undefined') {
                toastr[type](message);
            }
            // Si tienes SweetAlert configurado
            else if (typeof Swal !== 'undefined') {
                var icon = type === 'error' ? 'error' : type === 'success' ? 'success' : type === 'warning' ? 'warning' : 'info';
                Swal.fire({
                    icon: icon,
                    title: message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            }
            // Fallback a alert nativo
            else {
                alert(message);
            }
        }
    </script>
}