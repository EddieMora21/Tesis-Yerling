                           class="menu-link" aria-expanded="false" aria-controls="reportesMenu">
                            <i class="fas fa-chart-bar menu-icon"></i>
                            <span>Reportes</span>
                            <i class="bi bi-chevron-down menu-toggle-icon"></i>
                        </a>
