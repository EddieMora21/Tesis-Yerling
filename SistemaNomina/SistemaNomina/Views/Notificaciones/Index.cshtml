@* Views/Notificaciones/Index.cshtml *@
@model List<SistemaNomina.Notificaciones>

@{
    ViewBag.Title = "Mis Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --azul-oscuro: #221d42;
            --celeste: #1788ca;
            --amarillo: #fab61b;
            --gris-claro: #e7e8eb;
        }

        .notifications-header {
            background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--celeste) 100%);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 15px 15px;
            margin: -2rem -2rem 2rem -2rem;
            box-shadow: 0 4px 15px rgba(34, 29, 66, 0.2);
        }

        .notification-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(34, 29, 66, 0.1);
            margin-bottom: 1rem;
            border-left: 4px solid var(--celeste);
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .notification-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(34, 29, 66, 0.15);
        }

        .notification-card.unread {
            border-left-color: var(--amarillo);
            background: linear-gradient(90deg, rgba(250, 182, 27, 0.05) 0%, white 100%);
        }

        .notification-card.read {
            opacity: 0.8;
            border-left-color: var(--gris-claro);
        }

        .notification-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            margin-right: 1rem;
            flex-shrink: 0;
        }

        .notification-content {
            flex: 1;
            min-width: 0;
        }

        .notification-title {
            font-weight: 600;
            color: var(--azul-oscuro);
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .notification-message {
            color: #6c757d;
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .notification-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: #8a8a8a;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .notification-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .btn-notification {
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            border: none;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        .btn-mark-read {
            background-color: var(--celeste);
            color: white;
        }

        .btn-mark-read:hover {
            background-color: var(--azul-oscuro);
            transform: translateY(-1px);
        }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

        .btn-delete:hover {
            background-color: #c82333;
            transform: translateY(-1px);
        }

        .btn-details {
            background-color: var(--amarillo);
            color: var(--azul-oscuro);
        }

        .btn-details:hover {
            background-color: #e5a515;
            color: var(--azul-oscuro);
            transform: translateY(-1px);
        }

        .notification-badge {
            background: linear-gradient(135deg, var(--amarillo) 0%, #ffc843 100%);
            color: var(--azul-oscuro);
            padding: 0.2rem 0.6rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .priority-urgent {
            border-left-color: #dc3545 !important;
            animation: pulse-urgent 2s infinite;
        }

        .priority-high {
            border-left-color: #fd7e14 !important;
        }

        .priority-low {
            opacity: 0.7;
        }

        @@keyframes pulse-urgent {
            0%, 100% { border-left-color: #dc3545; }
            50% { border-left-color: #ff6b7a; }
        }

        .empty-notifications {
            text-align: center;
            padding: 3rem;
            color: #8a8a8a;
        }

        .empty-notifications i {
            font-size: 4rem;
            color: var(--gris-claro);
            margin-bottom: 1rem;
        }

        .stats-cards {
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 2px 15px rgba(34, 29, 66, 0.1);
            border-top: 3px solid var(--celeste);
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(34, 29, 66, 0.15);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--azul-oscuro);
        }

        .stat-label {
            color: #6c757d;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 0.5rem;
        }

        .filters-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 15px rgba(34, 29, 66, 0.1);
            border-top: 3px solid var(--amarillo);
        }

        .custom-select, .custom-input {
            border: 2px solid var(--gris-claro);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

        .custom-select:focus, .custom-input:focus {
            border-color: var(--celeste);
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
        }

        .remitente-info {
            font-size: 0.8rem;
            color: #6c757d;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        @@media (max-width: 768px) {
            .notification-card .d-flex {
                flex-direction: column;
                text-align: center;
            }

            .notification-icon {
                margin: 0 auto 1rem;
            }

            .notification-meta {
                flex-direction: column;
                text-align: center;
                gap: 1rem;
            }

            .notification-actions {
                justify-content: center;
            }

            .stats-cards .row > div {
                margin-bottom: 1rem;
            }
        }
    </style>
}

<div class="notifications-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="fas fa-bell fa-2x"></i>
                </div>
                <div>
                    <h2 class="mb-1">Mis Notificaciones</h2>
                    <p class="mb-0 opacity-75">Centro de mensajes y alertas del sistema</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/Notificaciones/NoLeidas" class="btn btn-outline-light">
                    <i class="fas fa-filter me-2"></i>Solo No Leídas
                </a>
                <button type="button" class="btn btn-outline-light" id="markAllRead">
                    <i class="fas fa-check-double me-2"></i>
                    <span class="d-none d-sm-inline">Marcar todas como leídas</span>
                </button>
                <button type="button" class="btn btn-warning" id="refreshNotifications">
                    <i class="fas fa-sync me-2"></i>
                    <span class="d-none d-sm-inline">Actualizar</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Estadísticas -->
    <div class="row stats-cards">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="stat-number" id="totalNotifications">@Model.Count</div>
                <div class="stat-label">Total</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="stat-number text-warning" id="unreadNotifications">@Model.Count(n => !(n.leido ?? false))</div>
                <div class="stat-label">No Leídas</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="stat-number text-success" id="readNotifications">@Model.Count(n => n.leido ?? false)</div>
                <div class="stat-label">Leídas</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="stat-number text-info" id="todayNotifications">@Model.Count(n => n.fecha_creacion != null && n.fecha_creacion.Value.Date == DateTime.Today)</div>
                <div class="stat-label">Hoy</div>
            </div>
        </div>
    </div>

    <!-- Lista de Notificaciones -->
    <div id="notificationsList">
        @if (Model.Any())
        {
            foreach (var notificacion in Model)
            {
                string prioridadClass = "";
                if (notificacion.prioridad == "urgente") { prioridadClass = "priority-urgent"; }
                else if (notificacion.prioridad == "alta") { prioridadClass = "priority-high"; }
                else if (notificacion.prioridad == "baja") { prioridadClass = "priority-low"; }

                string iconoColor = "primary";
                string icono = "fas fa-bell";

                // Determinar icono y color según el tipo
                switch (notificacion.tipo?.ToLower())
                {
                    case "solicitud":
                        icono = "fas fa-paper-plane";
                        iconoColor = "info";
                        break;
                    case "aprobacion":
                        icono = "fas fa-check-circle";
                        iconoColor = "success";
                        break;
                    case "rechazo":
                        icono = "fas fa-times-circle";
                        iconoColor = "danger";
                        break;
                    case "sistema":
                        icono = "fas fa-cog";
                        iconoColor = "secondary";
                        break;
                    default:
                        icono = "fas fa-info-circle";
                        iconoColor = "primary";
                        break;
                }

                <div class="notification-card @((notificacion.leido ?? false) ? "read" : "unread") @prioridadClass"
                     data-id="@notificacion.id_notificacion"
                     data-type="@(notificacion.tipo ?? "")"
                     data-priority="@(notificacion.prioridad ?? "")"
                     data-leido="@((notificacion.leido ?? false).ToString().ToLower())">
                    <div class="p-3">
                        <div class="d-flex align-items-start">
                            <div class="notification-icon bg-@iconoColor">
                                <i class="@icono"></i>
                            </div>

                            <div class="notification-content">
                                <div class="notification-title">
                                    @(notificacion.titulo ?? "Sin título")
                                    @if (!(notificacion.leido ?? false))
                                    {
                                        <span class="notification-badge">Nueva</span>
                                    }
                                    @if (notificacion.prioridad == "urgente")
                                    {
                                        <i class="fas fa-exclamation-triangle text-danger" title="Urgente"></i>
                                    }
                                    else if (notificacion.prioridad == "alta")
                                    {
                                        <i class="fas fa-exclamation text-warning" title="Prioridad Alta"></i>
                                    }
                                </div>

                                <div class="notification-message">
                                    @{
                                        var mensaje = notificacion.mensaje ?? "Sin mensaje";
                                        var mensajeCorto = mensaje.Length > 150 ? mensaje.Substring(0, 150) + "..." : mensaje;
                                    }
                                    @mensajeCorto
                                </div>

                                <div class="notification-meta">
                                    <div class="d-flex align-items-center gap-3 flex-wrap">
                                        <span>
                                            <i class="fas fa-clock me-1"></i>
                                            @{
                                                var fechaCreacion = notificacion.fecha_creacion ?? DateTime.Now;
                                                var tiempoTranscurrido = DateTime.Now - fechaCreacion;
                                                string tiempoTexto;

                                                if (tiempoTranscurrido.TotalMinutes < 1)
                                                {
                                                    tiempoTexto = "Hace un momento";
                                                }
                                                else if (tiempoTranscurrido.TotalHours < 1)
                                                {
                                                    tiempoTexto = $"Hace {(int)tiempoTranscurrido.TotalMinutes} minutos";
                                                }
                                                else if (tiempoTranscurrido.TotalDays < 1)
                                                {
                                                    tiempoTexto = $"Hace {(int)tiempoTranscurrido.TotalHours} horas";
                                                }
                                                else if (tiempoTranscurrido.TotalDays < 7)
                                                {
                                                    tiempoTexto = $"Hace {(int)tiempoTranscurrido.TotalDays} días";
                                                }
                                                else
                                                {
                                                    tiempoTexto = fechaCreacion.ToString("dd/MM/yyyy");
                                                }
                                            }
                                            @tiempoTexto
                                        </span>
                                        <span class="badge bg-secondary">@(notificacion.tipo ?? "general")</span>
                                        @if (!string.IsNullOrEmpty(notificacion.referencia_tipo))
                                        {
                                            <span class="badge bg-info">@notificacion.referencia_tipo</span>
                                        }
                                    </div>

                                    <div class="notification-actions">
                                        <a href="/Notificaciones/Details/@notificacion.id_notificacion"
                                           class="btn-notification btn-details">
                                            <i class="fas fa-eye"></i>Ver
                                        </a>

                                        @if (!(notificacion.leido ?? false))
                                        {
                                            <button type="button" class="btn-notification btn-mark-read"
                                                    onclick="markAsRead(@notificacion.id_notificacion)">
                                                <i class="fas fa-check"></i>Marcar leída
                                            </button>
                                        }

                                        <button type="button" class="btn-notification btn-delete"
                                                onclick="deleteNotification(@notificacion.id_notificacion)">
                                            <i class="fas fa-trash"></i>Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-notifications">
                <i class="fas fa-bell-slash"></i>
                <h4>No tienes notificaciones</h4>
                <p>Cuando recibas nuevas notificaciones aparecerán aquí.</p>
                <a href="/Home/Index" class="btn btn-primary">
                    <i class="fas fa-home me-2"></i>Volver al inicio
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function markAsRead(notificationId) {
            $.post('/Notificaciones/MarcarComoLeida', {
                id: notificationId
            })
                .done(function (response) {
                    if (response.success) {
                        const card = $(`[data-id="${notificationId}"]`);
                        card.removeClass('unread').addClass('read');
                        card.find('.notification-badge').remove();
                        card.find('.btn-mark-read').remove();
                        card.attr('data-leido', 'true');

                        // Actualizar contadores
                        updateStats();
                    }
                });
        }

        function deleteNotification(notificationId) {
            if (confirm('¿Eliminar esta notificación?')) {
                $.post('/Notificaciones/Delete', {
                    id: notificationId
                })
                    .done(function (response) {
                        if (response.success) {
                            $(`[data-id="${notificationId}"]`).fadeOut(300, function () {
                                $(this).remove();
                                updateStats();
                            });
                        }
                    });
            }
        }

        function updateStats() {
            const total = $('.notification-card').length;
            const unread = $('.notification-card.unread').length;
            const read = $('.notification-card.read').length;

            $('#totalNotifications').text(total);
            $('#unreadNotifications').text(unread);
            $('#readNotifications').text(read);
        }
    </script>
}