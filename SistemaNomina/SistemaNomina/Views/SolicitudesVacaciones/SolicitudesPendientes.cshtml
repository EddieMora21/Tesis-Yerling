<!-- Views/SolicitudesVacaciones/SolicitudesPendientes.cshtml -->
@model IEnumerable<SistemaNomina.SolicitudesVacaciones>

@{
    ViewBag.Title = "Solicitudes Pendientes de Aprobación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-clipboard-check"></i>
                        Solicitudes Pendientes de Aprobación
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-striped table-hover table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Empleado</th>
                                        <th>Departamento</th>
                                        <th>Fecha Solicitud</th>
                                        <th>Período Vacaciones</th>
                                        <th>Días</th>
                                        <th>Comentario</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var solicitud in Model)
                                    {
                                        var empleado = solicitud.Vacaciones.Empleados;
                                        var diasSolicitados = (solicitud.fecha_fin - solicitud.fecha_inicio).Days + 1;

                                        <tr>
                                            <td>
                                                <strong>@empleado.nombre1 @empleado.apellido1</strong><br>
                                                <small class="text-muted">@empleado.cedula</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @(empleado.Puestos?.Departamentos?.nombre ?? "N/A")
                                                </span>
                                            </td>
                                            <td>
                                                <small>@solicitud.fecha_solicitud?.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong>@solicitud.fecha_inicio.ToString("dd/MM/yyyy")</strong>
                                                <br>
                                                <small class="text-muted">al @solicitud.fecha_fin.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@diasSolicitados días</span>
                                            </td>
                                            <td>
                                                <small>@(solicitud.comentario_solicitud ?? "Sin comentarios")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-success btn-sm"
                                                            onclick="mostrarModalAprobacion(@solicitud.id_solicitud, 'aprobar')">
                                                        <i class="fas fa-check"></i> Aprobar
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-sm"
                                                            onclick="mostrarModalAprobacion(@solicitud.id_solicitud, 'rechazar')">
                                                        <i class="fas fa-times"></i> Rechazar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle fa-3x mb-3"></i>
                            <h5>No hay solicitudes pendientes</h5>
                            <p>No existen solicitudes de vacaciones pendientes de aprobación en este momento.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para aprobar/rechazar -->
<div class="modal fade" id="modalAprobacion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" id="modalHeader">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formAprobacion">
                    <input type="hidden" id="solicitudId" />
                    <input type="hidden" id="accionTipo" />

                    <div class="mb-3">
                        <label for="comentario" class="form-label">Comentario:</label>
                        <textarea class="form-control" id="comentario" rows="3"
                                  placeholder="Escriba sus comentarios sobre la decisión..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn" id="btnConfirmar" onclick="procesarSolicitud()">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarModalAprobacion(solicitudId, accion) {
            $('#solicitudId').val(solicitudId);
            $('#accionTipo').val(accion);
            $('#comentario').val('');

            if (accion === 'aprobar') {
                $('#modalTitle').text('Aprobar Solicitud de Vacaciones');
                $('#modalHeader').removeClass('bg-danger').addClass('bg-success text-white');
                $('#btnConfirmar').removeClass('btn-danger').addClass('btn-success').text('Aprobar');
            } else {
                $('#modalTitle').text('Rechazar Solicitud de Vacaciones');
                $('#modalHeader').removeClass('bg-success').addClass('bg-danger text-white');
                $('#btnConfirmar').removeClass('btn-success').addClass('btn-danger').text('Rechazar');
            }

            $('#modalAprobacion').modal('show');
        }

        function procesarSolicitud() {
            var solicitudId = $('#solicitudId').val();
            var accion = $('#accionTipo').val();
            var comentario = $('#comentario').val();

            if (!solicitudId || !accion) {
                alert('Error: Datos incompletos');
                return;
            }

            var url = accion === 'aprobar' ? '@Url.Action("Aprobar")' : '@Url.Action("Rechazar")';

            $.ajax({
                url: url,
                type: 'POST',
                data: {
                    id: solicitudId,
                    comentario: comentario
                },
                success: function(response) {
                    if (response.success) {
                        $('#modalAprobacion').modal('hide');
                        toastr.success(response.message);
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error:', error);
                    toastr.error('Error al procesar la solicitud');
                }
            });
        }
    </script>
}