@model IEnumerable<SistemaNomina.Models.Asistencia>

<style>
    .report-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
        margin-top: 25px;
    }

    .report-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 20px 25px;
        margin: 0;
    }

    .report-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        padding: 20px 25px;
        background: #f8f9fa;
        border-bottom: 1px solid #e7e8eb;
    }

    .stat-item {
        text-align: center;
        padding: 15px;
        background: white;
        border-radius: 8px;
        border: 1px solid #e7e8eb;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1788ca;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 12px;
        color: #6c757d;
        font-weight: 500;
    }

    .table-custom {
        margin-bottom: 0;
    }

        .table-custom thead th {
            background: #221d42;
            color: white;
            border: none;
            padding: 15px 12px;
            font-weight: 600;
            font-size: 13px;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid #e7e8eb;
        }

            .table-custom tbody tr:hover {
                background: rgba(23, 136, 202, 0.05);
            }

        .table-custom tbody td {
            padding: 12px;
            vertical-align: middle;
            border-top: none;
            font-size: 14px;
        }

    .status-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-completo {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
    }

    .status-sin-salida {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
    }

    .status-sin-entrada {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }

    .status-tardanza {
        background: linear-gradient(135deg, #fd7e14 0%, #fd7e14 100%);
        color: white;
    }

    .status-feriado {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    .time-display {
        font-family: 'Courier New', monospace;
        font-weight: 600;
        color: #221d42;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-success-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-info-custom {
        background: linear-gradient(135deg, #17a2b8 0%, #17a2b8 100%);
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
        margin-left: 10px;
    }

        .btn-info-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 162, 184, 0.4);
            color: white;
            text-decoration: none;
        }

    .no-results {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

        .no-results i {
            font-size: 4rem;
            margin-bottom: 20px;
            color: #e7e8eb;
        }

    @@media (max-width: 768px) {
        .report-stats {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            padding: 15px;
        }

        .stat-item {
            padding: 10px;
        }

        .table-responsive {
            border-radius: 0;
        }

        .btn-success-custom, .btn-info-custom {
            width: 100%;
            margin: 5px 0;
        }
    }
</style>

@if (Model.Any())
{
    <div class="report-card">
        <div class="report-header">
            <h4 class="mb-0">
                <i class="fa fa-table" style="margin-right: 10px;"></i>
                Resultados del Reporte
            </h4>
            <small style="opacity: 0.9;">@Model.Count() registros encontrados</small>
        </div>

        <div class="report-stats">
            <div class="stat-item">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label">
                    <i class="fa fa-list" style="margin-right: 3px;"></i>
                    Total Registros
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-number">@Model.Count(x => x.hora_entrada.HasValue && x.hora_salida.HasValue)</div>
                <div class="stat-label">
                    <i class="fa fa-check-circle" style="margin-right: 3px;"></i>
                    Completos
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-number">@Model.Count(x => x.hora_entrada.HasValue && x.hora_entrada.Value > new TimeSpan(8, 15, 0))</div>
                <div class="stat-label">
                    <i class="fa fa-clock" style="margin-right: 3px;"></i>
                    Tardanzas
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-number">@Model.Count(x => x.es_feriado == true)</div>
                <div class="stat-label">
                    <i class="fa fa-calendar" style="margin-right: 3px;"></i>
                    Feriados
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table-custom table">
                <thead>
                    <tr>
                        <th><i class="fa fa-calendar" style="margin-right: 5px;"></i>Fecha</th>
                        <th><i class="fa fa-user" style="margin-right: 5px;"></i>Empleado</th>
                        <th><i class="fa fa-id-card" style="margin-right: 5px;"></i>Cédula</th>
                        <th><i class="fa fa-sign-in" style="margin-right: 5px;"></i>Entrada</th>
                        <th><i class="fa fa-sign-out" style="margin-right: 5px;"></i>Salida</th>
                        <th><i class="fa fa-clock" style="margin-right: 5px;"></i>Horas</th>
                        <th><i class="fa fa-info-circle" style="margin-right: 5px;"></i>Estado</th>
                        <th><i class="fa fa-calendar-check" style="margin-right: 5px;"></i>Feriado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="time-display">@item.fecha.ToString("dd/MM/yyyy")</td>
                            <td style="font-weight: 500;">
                                @item.Empleados.nombre1 @item.Empleados.apellido1
                            </td>
                            <td style="font-family: monospace; font-size: 13px;">@item.Empleados.cedula</td>
                            <td>
                                @if (item.hora_entrada.HasValue)
                                {
                                    <span class="time-display">@item.hora_entrada.Value.ToString(@"hh\:mm")</span>
                                    if (item.hora_entrada.Value > new TimeSpan(8, 15, 0))
                                    {
                                        <br><span class="status-badge status-tardanza">Tardanza</span>
                                    }
                                }
                                else
                                {
                                    <span style="color: #6c757d; font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_salida.HasValue)
                                {
                                    <span class="time-display">@item.hora_salida.Value.ToString(@"hh\:mm")</span>
                                }
                                else
                                {
                                    <span style="color: #6c757d; font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada.HasValue && item.hora_salida.HasValue)
                                {
                                    var horas = (item.hora_salida.Value - item.hora_entrada.Value).TotalHours;
                                    <span class="time-display">@Math.Round(horas, 2) hrs</span>
                                }
                                else
                                {
                                    <span style="color: #6c757d;">-</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada.HasValue && item.hora_salida.HasValue)
                                {
                                    <span class="status-badge status-completo">Completo</span>
                                }
                                else if (item.hora_entrada.HasValue)
                                {
                                    <span class="status-badge status-sin-salida">Sin Salida</span>
                                }
                                else
                                {
                                    <span class="status-badge status-sin-entrada">Sin Entrada</span>
                                }
                            </td>
                            <td>
                                @if (item.es_feriado == true)
                                {
                                    <span class="status-badge status-feriado">
                                        @(item.Feriados != null ? item.Feriados.nombre : "Feriado")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6c757d;">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="padding: 20px 25px; background: #f8f9fa; text-align: right;">
            <button class="btn-success-custom" onclick="exportarPDF()">
                <i class="fa fa-file-pdf" style="margin-right: 8px;"></i>
                Exportar a PDF
            </button>
            <button class="btn-info-custom" onclick="exportarExcel()">
                <i class="fa fa-file-excel" style="margin-right: 8px;"></i>
                Exportar a Excel
            </button>
        </div>
    </div>
}
else
{
    <div class="report-card">
        <div class="no-results">
            <i class="fa fa-search"></i>
            <h5 style="color: #221d42; margin-bottom: 15px;">No se encontraron registros</h5>
            <p style="margin: 0;">No existen registros de asistencia que coincidan con los filtros aplicados.</p>
            <small style="color: #6c757d; margin-top: 10px; display: block;">
                Intenta modificar los criterios de búsqueda o ampliar el rango de fechas.
            </small>
        </div>
    </div>
}

<script>
    function exportarPDF() {
        // Mostrar notificación temporal
        showNotification('Preparando exportación a PDF...', 'info');

        // Aquí implementarías la lógica de exportación a PDF
        setTimeout(function () {
            showNotification('Funcionalidad de exportación a PDF pendiente de implementar', 'warning');
        }, 1000);
    }

    function exportarExcel() {
        // Mostrar notificación temporal
        showNotification('Preparando exportación a Excel...', 'info');

        // Aquí implementarías la lógica de exportación a Excel
        setTimeout(function () {
            showNotification('Funcionalidad de exportación a Excel pendiente de implementar', 'warning');
        }, 1000);
    }

    function showNotification(message, type) {
        var alertClass = type === 'info' ? 'alert-info' : type === 'warning' ? 'alert-warning' : 'alert-success';
        var notification = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                <i class="fa fa-${type === 'info' ? 'info-circle' : type === 'warning' ? 'exclamation-triangle' : 'check-circle'}" style="margin-right: 8px;"></i>
                ${message}
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        `;
        $('body').append(notification);

        // Auto-cerrar después de 3 segundos
        setTimeout(function () {
            $('.alert').alert('close');
        }, 3000);
    }
</script>