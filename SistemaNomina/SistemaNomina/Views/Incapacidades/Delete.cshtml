@model SistemaNomina.Models.Incapacidades

@{
    ViewBag.Title = "Eliminar Incapacidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header principal -->
<div class="page-header-gradient delete-header">
    <div class="container">
        <h1><i class="fa fa-trash"></i> Eliminar Incapacidad</h1>
        <p class="header-subtitle">¿Está seguro que desea eliminar este registro de incapacidad?</p>
    </div>
</div>

<div class="main-container container">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <!-- Alerta de advertencia -->
            <div class="alert-custom alert-warning">
                <i class="fa fa-exclamation-triangle"></i>
                <div class="alert-content">
                    <strong>¡Advertencia!</strong>
                    <p>Esta acción eliminará permanentemente el registro de incapacidad. Esta operación no se puede deshacer.</p>
                </div>
            </div>

            <!-- Panel de confirmación -->
            <div class="delete-card">
                <div class="delete-card-header">
                    <h3><i class="fa fa-user-injured"></i> Información de la Incapacidad a Eliminar</h3>
                    <div class="record-id">ID: @Model.id_incapacidad</div>
                </div>

                <div class="delete-card-body">
                    <!-- Información del empleado -->
                    <div class="employee-section">
                        <h4><i class="fa fa-user"></i> Empleado Afectado</h4>
                        <div class="employee-card">
                            <div class="employee-avatar">
                                @if (Model.Empleados != null && !string.IsNullOrEmpty(Model.Empleados.nombre1) && !string.IsNullOrEmpty(Model.Empleados.apellido1))
                                {
                                    @Model.Empleados.nombre1.Substring(0, 1)@Model.Empleados.apellido1.Substring(0, 1)
                                }
                                else
                                {
                                    <text>??</text>
                                }
                            </div>
                            <div class="employee-info">
                                <h5>
                                    @if (Model.Empleados != null)
                                    {
                                        @(Model.Empleados.nombre1 ?? "Sin nombre") @(Model.Empleados.apellido1 ?? "Sin apellido")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin empleado asignado</span>
                                    }
                                </h5>
                                <p><i class="fa fa-id-card"></i> Cédula: @(Model.Empleados?.cedula ?? "No disponible")</p>
                                @if (Model.Empleados?.Puestos != null && !string.IsNullOrEmpty(Model.Empleados.Puestos.nombre_puesto))
                                {
                                    <p><i class="fa fa-briefcase"></i> @Model.Empleados.Puestos.nombre_puesto</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Detalles de la incapacidad -->
                    <div class="details-section">
                        <h4><i class="fa fa-clipboard-list"></i> Detalles de la Incapacidad</h4>
                        <div class="details-grid">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fa fa-tag"></i> Tipo de Incapacidad
                                </div>
                                <div class="detail-value">
                                    @if (Model.TipoIncapacidades != null && !string.IsNullOrEmpty(Model.TipoIncapacidades.nombre))
                                    {
                                        <span class="badge-info">@Model.TipoIncapacidades.nombre</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No especificado</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fa fa-flag"></i> Estado
                                </div>
                                <div class="detail-value">
                                    @{
                                        string badgeClass = "badge-secondary";
                                        string estadoNombre = "Sin estado";

                                        if (Model.Estados != null && !string.IsNullOrEmpty(Model.Estados.nombre))
                                        {
                                            estadoNombre = Model.Estados.nombre;
                                            switch (Model.Estados.nombre.ToLower())
                                            {
                                                case "pendiente":
                                                    badgeClass = "badge-warning";
                                                    break;
                                                case "aprobado":
                                                    badgeClass = "badge-success";
                                                    break;
                                                case "rechazado":
                                                    badgeClass = "badge-danger";
                                                    break;
                                            }
                                        }
                                    }
                                    <span class="@badgeClass">@estadoNombre</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fa fa-calendar-plus"></i> Fecha de Inicio
                                </div>
                                <div class="detail-value">
                                    @Model.fecha_inicio.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fa fa-calendar-minus"></i> Fecha de Fin
                                </div>
                                <div class="detail-value">
                                    @Model.fecha_fin.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fa fa-clock-o"></i> Duración
                                </div>
                                <div class="detail-value">
                                    <span class="badge-primary">@(Model.dias_incapacidad ?? 0) días</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.numero_boleta))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fa fa-file-medical"></i> N° Boleta
                                    </div>
                                    <div class="detail-value">
                                        <span class="badge-secondary">@Model.numero_boleta</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.descripcion))
                    {
                        <!-- Descripción -->
                        <div class="description-section">
                            <h4><i class="fa fa-comment-medical"></i> Descripción</h4>
                            <div class="description-box">
                                "@Model.descripcion"
                            </div>
                        </div>
                    }

                    <!-- Consecuencias de la eliminación -->
                    <div class="consequences-section">
                        <h4><i class="fa fa-exclamation-triangle"></i> Consecuencias de la Eliminación</h4>
                        <div class="consequences-list">
                            <div class="consequence-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <span>Se eliminará permanentemente el registro de incapacidad</span>
                            </div>
                            <div class="consequence-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <span>Se perderá el historial médico asociado a este período</span>
                            </div>
                            <div class="consequence-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <span>Los cálculos de nómina podrían verse afectados</span>
                            </div>
                            @if ((Model.dias_incapacidad ?? 0) > 0)
                            {
                                <div class="consequence-item warning">
                                    <i class="fa fa-exclamation-triangle text-warning"></i>
                                    <span>La incapacidad tiene una duración de <strong>@Model.dias_incapacidad días</strong></span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Formulario de confirmación CORREGIDO -->
                    @using (Html.BeginForm("Delete", "Incapacidades", new { id = Model.id_incapacidad }, FormMethod.Post, new { @class = "delete-form", @id = "formEliminar" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Checkbox de confirmación -->
                        <div class="confirmation-section">
                            <div class="form-group-custom">
                                <label class="checkbox-container">
                                    <input type="checkbox" id="confirmarEliminacion" name="confirmarEliminacion" required>
                                    <span class="checkmark"></span>
                                    <span class="checkbox-text">
                                        Confirmo que entiendo las consecuencias y deseo eliminar este registro de incapacidad permanentemente
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="form-actions">
                            <button type="submit" class="btn-danger-custom" id="btnEliminar" disabled>
                                <i class="fa fa-trash"></i> Eliminar Definitivamente
                            </button>
                            <a href="@Url.Action("Details", new { id = Model.id_incapacidad })" class="btn-info-custom">
                                <i class="fa fa-eye"></i> Ver Detalles
                            </a>
                            <a href="@Url.Action("Index")" class="btn-secondary-custom">
                                <i class="fa fa-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
