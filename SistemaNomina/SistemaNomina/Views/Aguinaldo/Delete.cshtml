@model SistemaNomina.Aguinaldo

@{
    ViewBag.Title = "Eliminar Aguinaldo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --danger-color: #dc3545;
        --danger-dark: #c82333;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --shadow-hover: 0 12px 40px rgba(34, 29, 66, 0.15);
        --transition: all 0.3s ease;
    }

    .delete-container {
        background: var(--white);
        border-radius: var(--border-radius);
        padding: 2rem;
        box-shadow: var(--shadow-main);
        margin-bottom: 2rem;
    }

    .delete-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: var(--white);
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .warning-section {
        background: #fff3cd;
        border: 1px solid #ffecb5;
        border-left: 5px solid #ffc107;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .danger-section {
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        border-left: 5px solid var(--danger-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .record-details {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #dee2e6;
    }

    .detail-grid:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: bold;
        color: var(--primary-color);
    }

    .detail-value {
        color: #495057;
    }

    .amount-highlight {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--danger-color);
        text-align: center;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        margin: 1rem 0;
    }

    .confirmation-section {
        background: #e2e3e5;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 2rem 0;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, var(--danger-color) 0%, var(--danger-dark) 100%);
        border: none;
        color: var(--white);
        padding: 12px 30px;
        border-radius: var(--border-radius-sm);
        font-weight: 600;
        transition: var(--transition);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
        color: var(--white);
        text-decoration: none;
    }

    .btn-secondary-custom {
        background: var(--neutral-color);
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        padding: 10px 28px;
        border-radius: var(--border-radius-sm);
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary-custom:hover {
        background: var(--primary-color);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-2px);
    }

    .consequences-list {
        background: #f8d7da;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
    }

    .consequences-list ul {
        margin: 0;
        padding-left: 1.5rem;
    }

    .consequences-list li {
        margin-bottom: 0.5rem;
        color: #721c24;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
            gap: 0.25rem;
        }

        .action-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-danger-custom,
        .btn-secondary-custom {
            width: 100%;
            max-width: 280px;
        }
    }
</style>

<div class="container">
    <!-- Header Simple -->
    <div class="delete-header">
        <h2><i class="fas fa-trash-alt"></i> Eliminar Aguinaldo</h2>
        <p class="mb-0">Confirme la eliminación del registro seleccionado</p>
    </div>

    <!-- Advertencia Principal -->
    <div class="danger-section">
        <h4><i class="fas fa-exclamation-triangle"></i> Advertencia</h4>
        <p class="mb-0">
            Esta acción eliminará <strong>permanentemente</strong> el registro de aguinaldo.
            Esta acción no puede ser deshecha.
        </p>
    </div>

    <!-- Detalles del Registro a Eliminar -->
    <div class="record-details">
        <h4 class="mb-3"> Registro a Eliminar</h4>

        <div class="detail-grid">
            <div class="detail-label"><i class="fas fa-user"></i> Empleado:</div>
            <div class="detail-value">
                @Html.DisplayFor(model => model.Empleados.nombre1) @Html.DisplayFor(model => model.Empleados.apellido1)
                (@Html.DisplayFor(model => model.Empleados.cedula))
            </div>
        </div>

        <div class="detail-grid">
            <div class="detail-label"><i class="fas fa-calendar"></i> Año Fiscal:</div>
            <div class="detail-value">@Html.DisplayFor(model => model.anio)</div>
        </div>

        <div class="detail-grid">
            <div class="detail-label"><i class="fas fa-calendar-check"></i> Meses Laborados:</div>
            <div class="detail-value">@Html.DisplayFor(model => model.meses_laborados) meses</div>
        </div>

        <div class="detail-grid">
            <div class="detail-label"><i class="fas fa-calendar-plus"></i> Fecha de Creación:</div>
            <div class="detail-value">
                @if (Model.fecha_creacion != null)
                {
                    @Model.fecha_creacion.Value.ToString("dd/MM/yyyy HH:mm")
                }
                else
                {
                    <span class="text-muted">No registrada</span>
                }
            </div>
        </div>

        @if (Model.fecha_actualizacion != null)
        {
            <div class="detail-grid">
                <div class="detail-label"><i class="fas fa-calendar-edit"></i> Última Actualización:</div>
                <div class="detail-value">@Model.fecha_actualizacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        }

        <!-- Monto Destacado -->
        <div class="amount-highlight">
            <i class="fas fa-coins"></i> Monto a Eliminar: ₡@Model.monto_total.ToString("#,##0.00")
        </div>
    </div>

    <!-- Consecuencias de la Eliminación -->
    <div class="warning-section">
        <h4><i class="fas fa-list-ul"></i> Consecuencias de Esta Acción</h4>
        <div class="consequences-list">
            <ul>
                <li><i class="fas fa-times-circle"></i> Se perderá <strong>permanentemente</strong> toda la información del aguinaldo</li>
                <li><i class="fas fa-times-circle"></i> Los reportes contables se verán afectados</li>
                <li><i class="fas fa-times-circle"></i> El historial del empleado quedará incompleto</li>
            </ul>
        </div>
    </div>

    <!-- Alternativas Recomendadas -->
    <div class="warning-section">
        <h4><i class="fas fa-lightbulb"></i> Alternativas Recomendadas</h4>
        <p><strong>Antes de eliminar, considere:</strong></p>
        <ul>
            <li><i class="fas fa-edit text-warning"></i> <strong>Editar el registro</strong> si solo necesita corregir datos</li>
            <li><i class="fas fa-calculator text-info"></i> <strong>Recalcular automáticamente</strong> si hay errores en el monto</li>
            <li><i class="fas fa-user-shield text-success"></i> <strong>Consultar con supervisión</strong> antes de proceder</li>
        </ul>
    </div>

    <!-- Sección de Confirmación -->
    <div class="confirmation-section">
        <h4><i class="fas fa-question-circle"></i> ¿Está completamente seguro?</h4>
        <p class="mb-3">
            Para confirmar la eliminación, debe hacer clic en el botón <strong>"Eliminar Definitivamente"</strong> a continuación.
        </p>

        @using (Html.BeginForm("Delete", "Aguinaldo", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.id_aguinaldo)

            <div class="action-buttons">
                <button type="submit" class="btn-danger-custom" onclick="return confirmarEliminacion()">
                    <i class="fas fa-trash-alt"></i> Eliminar Definitivamente
                </button>
                <a href="@Url.Action("Details", new { id = Model.id_aguinaldo })" class="btn-secondary-custom">
                    <i class="fas fa-eye"></i> Ver Detalles
                </a>
                <a href="@Url.Action("Index")" class="btn-secondary-custom">
                    <i class="fas fa-arrow-left"></i> Cancelar y Volver
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminacion() {
            return confirm('¿Está seguro de que desea eliminar este registro de aguinaldo?\n\nEsta acción no puede ser revertida.');
        }
    </script>
}