@model SistemaNomina.Aguinaldo

@{
    ViewBag.Title = "Detalles del Aguinaldo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --shadow-hover: 0 12px 40px rgba(34, 29, 66, 0.15);
        --transition: all 0.3s ease;
    }

    .details-container {
        background: var(--white);
        border-radius: var(--border-radius);
        padding: 2rem;
        box-shadow: var(--shadow-main);
        margin-bottom: 2rem;
    }

    .details-header {
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--primary-color) 100%);
        color: var(--white);
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .amount-display {
        font-size: 3rem;
        font-weight: bold;
        color: var(--accent-color);
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        margin: 1rem 0;
    }

    .info-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border-left: 5px solid var(--secondary-color);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin: 1rem 0;
    }

    .info-card {
        background: var(--white);
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.3s ease;
    }

    .info-card:hover {
        transform: translateY(-5px);
    }

    .info-icon {
        font-size: 2rem;
        color: var(--secondary-color);
        margin-bottom: 0.5rem;
    }

    .info-label {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.2rem;
        font-weight: bold;
        color: var(--primary-color);
    }

    .status-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 0.9rem;
        font-weight: bold;
        background: linear-gradient(135deg, var(--success-color), #229954);
        color: var(--white);
        margin-top: 1rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .btn-custom {
        padding: 12px 24px;
        border-radius: var(--border-radius-sm);
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition);
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--accent-color), #e09900);
        color: var(--primary-color);
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(250, 182, 27, 0.4);
        color: var(--primary-color);
        text-decoration: none;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: var(--white);
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
        color: var(--white);
        text-decoration: none;
    }

    .btn-back {
        background: var(--neutral-color);
        color: var(--primary-color);
        border: 2px solid var(--primary-color);
    }

    .btn-back:hover {
        background: var(--primary-color);
        color: var(--white);
        transform: translateY(-2px);
        text-decoration: none;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-custom {
            width: 100%;
            max-width: 280px;
        }

        .amount-display {
            font-size: 2rem;
        }
    }
</style>

<div class="container">
    <!-- Header Principal -->
    <div class="details-header">
        <h2><i class="fas fa-file-invoice-dollar"></i> Detalles del Aguinaldo</h2>
        <div class="amount-display">₡@Model.monto_total.ToString("#,##0.00")</div>
        <p class="mb-0">
            <strong>@Model.Empleados.nombre1 @Model.Empleados.apellido1</strong> - Año @Model.anio
        </p>
        <span class="status-badge">
            <i class="fas fa-check-circle"></i> Registrado
        </span>
    </div>

    <!-- Información Principal -->
    <div class="info-section">
        <h4 class="mb-3"><i class="fas fa-user-tie"></i> Información del Empleado</h4>
        <div class="info-grid">
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-id-card"></i></div>
                <div class="info-label">Cédula</div>
                <div class="info-value">@Html.DisplayFor(model => model.Empleados.cedula)</div>
            </div>
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-user"></i></div>
                <div class="info-label">Nombre Completo</div>
                <div class="info-value">
                    @Html.DisplayFor(model => model.Empleados.nombre1) @Html.DisplayFor(model => model.Empleados.nombre2)<br>
                    @Html.DisplayFor(model => model.Empleados.apellido1) @Html.DisplayFor(model => model.Empleados.apellido2)
                </div>
            </div>
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-calendar-user"></i></div>
                <div class="info-label">Fecha de Ingreso</div>
                <div class="info-value">@Html.DisplayFor(model => model.Empleados.fecha_ingreso)</div>
            </div>
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-briefcase"></i></div>
                <div class="info-label">Estado</div>
                <div class="info-value">@Html.DisplayFor(model => model.Empleados.estado)</div>
            </div>
        </div>
    </div>

    <!-- Detalles del Aguinaldo -->
    <div class="info-section">
        <h4 class="mb-3"><i class="fas fa-calculator"></i> Detalles del Cálculo</h4>
        <div class="info-grid">
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="info-label">Meses Laborados</div>
                <div class="info-value">@Html.DisplayFor(model => model.meses_laborados) meses</div>
            </div>
            <div class="info-card">
                <div class="info-icon"><i class="fas fa-coins"></i></div>
                <div class="info-label">Monto Total</div>
                <div class="info-value">₡@Model.monto_total.ToString("#,##0.00")</div>
            </div>
        </div>
    </div>

    <!-- Botones de Acción -->
    <div class="action-buttons">
        <a href="@Url.Action("Edit", new { id = Model.id_aguinaldo })" class="btn-custom btn-edit">
            <i class="fas fa-edit"></i> Editar Registro
        </a>
        <a href="@Url.Action("Delete", new { id = Model.id_aguinaldo })" class="btn-custom btn-delete">
            <i class="fas fa-trash-alt"></i> Eliminar
        </a>
        <a href="@Url.Action("Index")" class="btn-custom btn-back">
            <i class="fas fa-arrow-left"></i> Volver al Listado
        </a>
    </div>
</div>