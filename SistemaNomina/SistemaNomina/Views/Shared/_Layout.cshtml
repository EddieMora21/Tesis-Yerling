                            <span>Administración</span>
                            <i class="bi bi-chevron-down menu-toggle-icon"></i>
                        </a>
                        <div class="submenu collapse" id="gestionesMenu">
                            <a href="/Estados" class="menu-link">
                                <i class="fas fa-circle-notch menu-icon"></i>
                                <span>Estados</span>
                            </a>
                            <a href="/EstadoCivil" class="menu-link">
                                <i class="fas fa-heart menu-icon"></i>
                                <span>Estado Civil</span>
                            </a>
                            <a href="/TiposPermiso" class="menu-link">
                                <i class="fas fa-stamp menu-icon"></i>
                                <span>Tipos de Permiso</span>
                            </a>
                            <a href="/TiposHoraExtra" class="menu-link">
                                <i class="fas fa-clock menu-icon"></i>
                                <span>Tipos de Hora Extra</span>
                            </a>
                            <a href="/Feriados" class="menu-link">
                                <i class="fas fa-calendar-alt menu-icon"></i>
                                <span>Feriados</span>
                            </a>
                            <a href="/ISR" class="menu-link">
                                <i class="fas fa-percentage menu-icon"></i>
                                <span>ISR</span>
                            </a>
                            <a href="/TipoIncapacidades" class="menu-link">
                                <i class="fas fa-user-injured menu-icon"></i>
