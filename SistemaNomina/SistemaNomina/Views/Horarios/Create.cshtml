@model SistemaNomina.Horarios

@{
    ViewBag.Title = "Crear Horario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.2);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .form-card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-control-custom:focus {
            border-color: #1788ca;
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
            outline: none;
        }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(23, 136, 202, 0.4);
            color: white;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .help-text {
        font-size: 0.875rem;
        color: #6c757d;
        font-style: italic;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-box {
        background: rgba(23, 136, 202, 0.1);
        border-left: 4px solid #1788ca;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

        .info-box h5 {
            color: #221d42;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .info-box p {
            margin: 0;
            color: #6c757d;
        }

    .time-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .time-group {
            grid-template-columns: 1fr;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }

        .btn-primary-custom, .btn-secondary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-plus-circle"></i> Crear Horario</h1>
                <p class="mb-0">Registra un nuevo horario de trabajo en el sistema</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="info-box">
                <h5><i class="fas fa-clock"></i> Nuevo Horario de Trabajo</h5>
                <p>Complete la información para crear un nuevo horario de trabajo. Este podrá ser asignado a empleados y utilizado en la gestión de asistencia.</p>
            </div>

            <div class="form-card-custom">
                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.nombre, "Nombre del Horario *", new { @class = "form-label-custom" })
                            @Html.EditorFor(model => model.nombre, new { htmlAttributes = new { @class = "form-control-custom", @placeholder = "Ej: Turno Matutino, Turno Vespertino, Horario Administrativo..." } })
                            @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                            <div class="help-text">
                                <i class="fas fa-info-circle"></i>
                                Ingresa un nombre descriptivo para identificar este horario
                            </div>
                        </div>

                        <div class="time-group">
                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.hora_entrada, "Hora de Entrada *", new { @class = "form-label-custom" })
                                @Html.EditorFor(model => model.hora_entrada, new { htmlAttributes = new { @class = "form-control-custom", @type = "time" } })
                                @Html.ValidationMessageFor(model => model.hora_entrada, "", new { @class = "text-danger" })
                                <div class="help-text">
                                    <i class="fas fa-sign-in-alt"></i>
                                    Hora de inicio de la jornada laboral
                                </div>
                            </div>

                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.hora_salida, "Hora de Salida *", new { @class = "form-label-custom" })
                                @Html.EditorFor(model => model.hora_salida, new { htmlAttributes = new { @class = "form-control-custom", @type = "time" } })
                                @Html.ValidationMessageFor(model => model.hora_salida, "", new { @class = "text-danger" })
                                <div class="help-text">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Hora de finalización de la jornada laboral
                                </div>
                            </div>
                        </div>

                        @* Campos ocultos para fechas que se llenan automáticamente *@
                        @Html.HiddenFor(model => model.fecha_creacion)
                        @Html.HiddenFor(model => model.fecha_actualizacion)

                        <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mt-4">
                            <button type="submit" class="btn-primary-custom">
                                <i class="fas fa-save"></i> Crear Horario
                            </button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-secondary-custom" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Auto-llenar fechas al crear
            var now = new Date();
            var timestamp = now.toISOString().slice(0, 19);

            $('#fecha_creacion').val(timestamp);
            $('#fecha_actualizacion').val(timestamp);

            // Actualizar fecha de actualización antes de enviar
            $('form').on('submit', function() {
                var newTimestamp = new Date().toISOString().slice(0, 19);
                $('#fecha_actualizacion').val(newTimestamp);
            });

            // Validación personalizada de horarios
            $('#hora_salida').on('change', function() {
                var horaEntrada = $('#hora_entrada').val();
                var horaSalida = $(this).val();

                if (horaEntrada && horaSalida) {
                    if (horaSalida <= horaEntrada) {
                        alert('La hora de salida debe ser posterior a la hora de entrada.');
                        $(this).focus();
                    }
                }
            });
        });
    </script>
}