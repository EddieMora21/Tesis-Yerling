    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.delete-header {
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
}

.page-header-gradient h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
}

.header-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    margin: 0;
    font-weight: 300;
