    /* Indicadores de estado */
    .status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 0.5rem;
    }

        .status-indicator.online {
            background: var(--success-color);
            box-shadow: 0 0 0 2px rgba(40, 167, 69, 0.3);
        }

        .status-indicator.offline {
            background: var(--text-muted);
        }

        .status-indicator.pending {
            background: var(--warning-color);
            animation: pulse 2s infinite;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(255, 193, 7, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }
</style>

@section Scripts {
    <script>
       $(document).ready(function() {
           initializeDetailsView();
       });

       function initializeDetailsView() {
           // Agregar tooltips
           addTooltips();

           // Inicializar animaciones
           initializeAnimations();

           // Configurar modales de confirmación
           setupConfirmations();

           // Agregar atajos de teclado
           setupKeyboardShortcuts();
       }

       function addTooltips() {
           // Agregar tooltips informativos
           $('.security-icon').attr('data-tooltip', 'Estado de seguridad del usuario');
           $('.role-badge').attr('data-tooltip', 'Rol asignado al usuario');
           $('.status-badge').attr('data-tooltip', 'Estado actual del usuario');
       }

       function initializeAnimations() {
           // Animaciones de entrada escalonadas
           $('.info-card').each(function(index) {
               $(this).css('animation-delay', (index * 0.1) + 's');
           });

           // Efectos de hover mejorados
           $('.info-card').hover(
               function() {
                   $(this).find('.card-title i').addClass('fa-bounce');
               },
               function() {
                   $(this).find('.card-title i').removeClass('fa-bounce');
               }
           );
       }

       function setupConfirmations() {
           // Confirmación para eliminar usuario
           $('.action-btn.delete').on('click', function(e) {
               e.preventDefault();

               var result = confirm(
                   '⚠️ ADVERTENCIA CRÍTICA\n\n' +
                   'Está a punto de eliminar permanentemente este usuario.\n\n' +
                   '• Se perderán TODOS los datos asociados\n' +
                   '• Esta acción NO se puede deshacer\n' +
                   '• El acceso al sistema será revocado inmediatamente\n\n' +
                   '¿Está COMPLETAMENTE seguro de continuar?'
               );

               if (result) {
                   // Mostrar loading
                   $(this).html('<i class="fas fa-spinner fa-spin"></i> <span>Eliminando...</span>')
                          .prop('disabled', true);

                   window.location.href = $(this).attr('href');
               }
           });
       }

       function setupKeyboardShortcuts() {
           $(document).on('keydown', function(e) {
               // Ctrl/Cmd + E para editar
               if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
                   e.preventDefault();
                   window.location.href = '@Url.Action("Edit", new { id = Model.id_usuario })';
               }

               // Escape para volver al listado
               if (e.key === 'Escape') {
                   window.location.href = '@Url.Action("Index")';
               }

               // Ctrl/Cmd + P para imprimir
               if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
                   e.preventDefault();
                   window.print();
               }
           });
       }

       function resetUserAccess(userId) {
           if (confirm('¿Desea forzar que el usuario cambie su contraseña en el próximo inicio de sesión?')) {
               // Mostrar loading
               var button = $('button[onclick*="resetUserAccess"]');
               button.html('<i class="fas fa-spinner fa-spin"></i> <span>Procesando...</span>')
                     .prop('disabled', true);

               // Simular llamada AJAX
               setTimeout(function() {
                   alert('Acceso restablecido correctamente. El usuario deberá cambiar su contraseña.');
                   location.reload();
               }, 2000);

               // En producción, aquí iría la llamada AJAX real:
               /*
               $.ajax({
                   url: '@Url.Action("ResetAccess", "Usuarios")',
                   type: 'POST',
                   data: {
                       id: userId,
                       __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                   },
                   success: function(response) {
                       if (response.success) {
                           showNotification('Acceso restablecido correctamente', 'success');
                           setTimeout(() => location.reload(), 2000);
                       } else {
                           showNotification('Error: ' + response.message, 'error');
                           button.html('<i class="fas fa-redo"></i> <span>Restablecer acceso</span>')
                                 .prop('disabled', false);
                       }
                   },
                   error: function() {
                       showNotification('Error de conexión', 'error');
                       button.html('<i class="fas fa-redo"></i> <span>Restablecer acceso</span>')
                             .prop('disabled', false);
                   }
               });
               */
           }
       }

       function showNotification(message, type) {
           var className = type === 'success' ? 'alert-success' : 'alert-danger';
           var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';

           var notification = $('<div class="alert '+ className +'" style="position: fixed; top: 20px; right: 20px; z-index: 9999; max-width: 400px; animation: slideInRight 0.3s ease-out;">' +
                               '<i class="fas '+ icon +'"></i> ' + message +
                               '</div>');

           $('body').append(notification);

           setTimeout(function() {
               notification.fadeOut(function() {
                   $(this).remove();
               });
           }, 5000);
       }

       // Función para copiar información al portapapeles
       function copyToClipboard(text) {
           if (navigator.clipboard) {
               navigator.clipboard.writeText(text).then(function() {
                   showNotification('Información copiada al portapapeles', 'success');
               });
           }
       }

       // Hacer valores copiables con doble clic
       $('.value').on('dblclick', function() {
           var text = $(this).text().trim();
           if (text) {
               copyToClipboard(text);
               $(this).css('background', 'rgba(40, 167, 69, 0.1)')
                      .animate({backgroundColor: 'transparent'}, 1000);
           }
       });

       // Validar enlaces externos
       $('a[href^="http"]').attr('target', '_blank').attr('rel', 'noopener noreferrer');
    </script>
}
