                <!-- Permisos - Para varios roles -->
                @if (RoleHelper.UserHasAnyRole("Admin", "RRHH", "Supervisor", "Empleado", "IT"))
                {
                    <div class="menu-item">
                        <a data-bs-toggle="collapse" href="#permisosMenu" role="button"
                           class="menu-link" aria-expanded="false" aria-controls="permisosMenu">
                            <i class="fas fa-shield-alt menu-icon"></i>
                            <span>Permisos</span>
                            <i class="bi bi-chevron-down menu-toggle-icon"></i>
                        </a>
                        <div class="submenu collapse" id="permisosMenu">
                            <a href="/Permisos" class="menu-link">
                                <i class="fas fa-key menu-icon"></i>
                                <span>Gestión de Permisos</span>
                            </a>
                        </div>
                    </div>
                }

                <!-- CONSULTAS - MÓDULO -->
                @if (RoleHelper.UserHasAnyRole("Admin", "RRHH", "Supervisor"))
                {
                    <div class="menu-item">
                        <a data-bs-toggle="collapse" href="#consultasMenu" role="button"
