@model SistemaNomina.Models.TipoIncapacidades

@{
    ViewBag.Title = "Eliminar Tipo de Incapacidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .delete-card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .warning-alert {
        background: rgba(220, 53, 69, 0.1);
        border-left: 4px solid #dc3545;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 8px;
    }

        .warning-alert h4 {
            color: #dc3545;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .warning-alert p {
            margin: 0;
            color: #721c24;
            line-height: 1.5;
        }

    .detail-row {
        display: flex;
        padding: 1.5rem;
        border-bottom: 1px solid #e7e8eb;
        background: #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        flex: 0 0 200px;
        font-weight: 600;
        color: #221d42;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        flex: 1;
        color: #495057;
        font-size: 1.1rem;
    }

    .badge-custom {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .badge-success {
        background: linear-gradient(135deg, #28a745 0%, #28a745 100%);
        color: white;
    }

    .badge-danger {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        color: white;
    }

    .badge-info {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        color: white;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-danger-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
            color: white;
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #6c757d 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .description-box {
        background: #f1f1f1;
        border-radius: 8px;
        padding: 1rem;
        border-left: 4px solid #6c757d;
        font-style: italic;
        line-height: 1.6;
    }

    .empty-description {
        color: #6c757d;
        font-style: italic;
        opacity: 0.7;
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
            gap: 0.5rem;
        }

        .detail-label {
            flex: none;
        }

        .btn-danger-custom, .btn-secondary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
            width: 100%;
            justify-content: center;
            margin-bottom: 0.5rem;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }
    }
</style>

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1><i class="fas fa-trash-alt"></i> Eliminar Tipo de Incapacidad</h1>
                <p class="mb-0">Confirma la eliminación del tipo de incapacidad seleccionado</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 900px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="warning-alert">
                <h4><i class="fas fa-exclamation-triangle"></i> ¿Estás seguro de que deseas eliminar este tipo de incapacidad?</h4>
                <p><strong>Esta acción no se puede deshacer.</strong> El tipo de incapacidad será eliminado permanentemente del sistema. Si existen incapacidades registradas con este tipo, podrían verse afectadas.</p>
            </div>

            <div class="delete-card-custom">
                <div class="card-header bg-light p-4">
                    <h4 class="mb-0" style="color: #221d42; font-weight: 600;">
                        <i class="fas fa-medical"></i>
                        Información del tipo de incapacidad a eliminar
                    </h4>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-tag"></i>
                        Nombre del Tipo
                    </div>
                    <div class="detail-value">
                        <strong>@Html.DisplayFor(model => model.nombre)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-alt"></i>
                        Días Máximos
                    </div>
                    <div class="detail-value">
                        <span class="badge-custom badge-info">
                            <i class="fas fa-clock"></i>
                            @Html.DisplayFor(model => model.dias_maximos) días máximo
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-money-bill-wave"></i>
                        Pago en Planilla
                    </div>
                    <div class="detail-value">
                        @if (Model.pago_planilla)
                        {
                            <span class="badge-custom badge-success">
                                <i class="fas fa-check-circle"></i>
                                Sí se paga en planilla
                            </span>
                        }
                        else
                        {
                            <span class="badge-custom badge-danger">
                                <i class="fas fa-times-circle"></i>
                                No se paga en planilla
                            </span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-align-left"></i>
                        Descripción
                    </div>
                    <div class="detail-value">
                        @if (!string.IsNullOrEmpty(Model.descripcion))
                        {
                            <div class="description-box">
                                @Html.DisplayFor(model => model.descripcion)
                            </div>
                        }
                        else
                        {
                            <span class="empty-description">Sin descripción proporcionada</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        Fecha de Creación
                    </div>
                    <div class="detail-value">
                        <i class="fas fa-clock"></i>
                        @Html.DisplayFor(model => model.fecha_creacion)
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-history"></i>
                        Última Actualización
                    </div>
                    <div class="detail-value">
                        <i class="fas fa-sync-alt"></i>
                        @Html.DisplayFor(model => model.fecha_actualizacion)
                    </div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn-danger-custom" onclick="return confirm('¿Estás completamente seguro de eliminar este tipo de incapacidad?');">
                        <i class="fas fa-trash-alt"></i> Eliminar Definitivamente
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn-secondary-custom" })
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Agregar confirmación adicional para móviles
    $(document).ready(function() {
        $('form').on('submit', function(e) {
            if (!confirm('⚠️ ÚLTIMA CONFIRMACIÓN\n\n¿Realmente deseas eliminar este tipo de incapacidad?\n\nEsta acción es irreversible.')) {
                e.preventDefault();
                return false;
            }
        });
    });
</script>