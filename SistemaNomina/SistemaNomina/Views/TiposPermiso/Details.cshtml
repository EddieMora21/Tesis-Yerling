@model SistemaNomina.TiposPermiso

@{
    ViewBag.Title = "Detalles del Tipo de Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --text-color: #495057;
    }

    .page-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: var(--white);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
    }

    .page-header * {
        color: var(--white) !important;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .details-card {
        background: var(--white);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        overflow: hidden;
        border: 1px solid var(--neutral-color);
    }

    .details-header {
        background: linear-gradient(135deg, var(--secondary-color) 0%, #0f6da3 100%);
        padding: 1.5rem;
        border-bottom: 1px solid var(--neutral-color);
        color: var(--white);
    }

    .details-header h4 {
        margin: 0;
        font-weight: 600;
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .details-body {
        padding: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid var(--neutral-color);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: var(--primary-color);
        font-size: 1rem;
        min-width: 140px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        font-size: 1rem;
        color: var(--text-color);
        margin-left: 2rem;
        flex: 1;
    }

    .permiso-name-display {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--primary-color);
        background: linear-gradient(135deg, var(--neutral-color), #f8f9fa);
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid var(--secondary-color);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .permiso-icon-large {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--white);
        font-weight: bold;
        flex-shrink: 0;
    }

    .icon-con-goce {
        background: linear-gradient(135deg, var(--success-color), #20a53a);
    }

    .icon-sin-goce {
        background: linear-gradient(135deg, var(--danger-color), #c82333);
    }

    .badge-goce-large {
        padding: 10px 20px;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .goce-si {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .goce-no {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
    }

    .descripcion-display {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid var(--secondary-color);
        font-style: italic;
        line-height: 1.6;
        color: var(--text-color);
    }

    .fecha-display {
        background: linear-gradient(135deg, var(--neutral-color), #f8f9fa);
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 500;
        color: var(--text-color);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #dee2e6;
    }

    .fecha-display i {
        color: var(--secondary-color);
        font-size: 0.9rem;
    }

    .button-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--neutral-color);
        justify-content: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        border: none;
        color: var(--primary-color);
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-custom:hover {
        background: linear-gradient(135deg, #e09f15 0%, #c8890f 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(250, 182, 27, 0.4);
        color: var(--primary-color);
        text-decoration: none;
    }

    .btn-secondary-custom {
        background: var(--neutral-color);
        border: 2px solid var(--neutral-color);
        color: var(--primary-color);
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary-custom:hover {
        background: #d6d8db;
        border-color: #d6d8db;
        color: var(--primary-color);
        text-decoration: none;
        transform: translateY(-1px);
    }

    /* === RESPONSIVE === */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem 0;
        }

        .page-title {
            font-size: 1.6rem;
            flex-direction: column;
            gap: 0.5rem;
            text-align: center;
        }

        .details-body {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .detail-label {
            min-width: auto;
        }

        .detail-value {
            margin-left: 0;
            width: 100%;
        }

        .button-group {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }

        .permiso-name-display {
            flex-direction: column;
            gap: 8px;
            text-align: center;
        }

        .permiso-icon-large {
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
        }
    }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-eye"></i>
            Detalles del Tipo de Permiso
        </h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="details-card">
                <div class="details-header">
                    <h4>
                        <i class="fas fa-info-circle"></i>
                        Información Completa
                    </h4>
                </div>

                <div class="details-body">
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-tag"></i>
                            Nombre:
                        </div>
                        <div class="detail-value">
                            <div class="permiso-name-display">
                                <div class="permiso-icon-large @(Model.con_goce ? "icon-con-goce" : "icon-sin-goce")">
                                    @(Model.con_goce ? "CG" : "SG")
                                </div>
                                <span>@Model.nombre</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-money-bill"></i>
                            Con Goce:
                        </div>
                        <div class="detail-value">
                            <span class="badge-goce-large @(Model.con_goce ? "goce-si" : "goce-no")">
                                <i class="fas @(Model.con_goce ? "fa-check" : "fa-times")"></i>
                                @(Model.con_goce ? "Con Goce de Salario" : "Sin Goce de Salario")
                            </span>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-align-left"></i>
                            Descripción:
                        </div>
                        <div class="detail-value">
                            <div class="descripcion-display">
                                @(Model.descripcion ?? "Sin descripción proporcionada")
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-calendar-plus"></i>
                            Fecha de Creación:
                        </div>
                        <div class="detail-value">
                            <div class="fecha-display">
                                <i class="fas fa-calendar-alt"></i>
                                @if (Model.fecha_creacion.HasValue)
                                {
                                    @Model.fecha_creacion.Value.ToString("dd/MM/yyyy")
                                    <span style="margin-left: 8px; color: #6c757d; font-size: 0.9rem;">
                                        @Model.fecha_creacion.Value.ToString("HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span>No registrada</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-calendar-edit"></i>
                            Última Actualización:
                        </div>
                        <div class="detail-value">
                            <div class="fecha-display">
                                <i class="fas fa-clock"></i>
                                @if (Model.fecha_actualizacion.HasValue)
                                {
                                    @Model.fecha_actualizacion.Value.ToString("dd/MM/yyyy")
                                    <span style="margin-left: 8px; color: #6c757d; font-size: 0.9rem;">
                                        @Model.fecha_actualizacion.Value.ToString("HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span>No registrada</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="button-group">
                        <a href="@Url.Action("Edit", new { id = Model.id_tipo_permiso })" class="btn-primary-custom">
                            <i class="fas fa-edit"></i>
                            Editar Tipo de Permiso
                        </a>
                        <a href="@Url.Action("Index")" class="btn-secondary-custom">
                            <i class="fas fa-arrow-left"></i>
                            Volver al Listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>