                                <span>Control de Horas Extras</span>
                            </a>
                            <a href="/Vacaciones" class="menu-link">
                                <i class="fas fa-umbrella-beach menu-icon"></i>
                                <span>Gestión de Vacaciones</span>
                            </a>
                            <a href="/Incapacidades" class="menu-link">
                                <i class="fas fa-first-aid menu-icon"></i>
                                <span>Gestión de Incapacidades</span>
