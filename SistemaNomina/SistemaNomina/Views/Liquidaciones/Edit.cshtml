@model SistemaNomina.Models.Liquidaciones

@{
    ViewBag.Title = "Editar Liquidación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
    }

    .header-gradient {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
        color: white;
        padding: 2rem 0;
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid var(--neutral-color);
        margin-bottom: 1.5rem;
    }

    .card-header-edit {
        background: linear-gradient(135deg, var(--accent-color) 0%, rgba(250, 182, 27, 0.8) 100%);
        color: var(--primary-color);
        border-radius: 15px 15px 0 0;
        padding: 1.5rem;
        font-weight: 600;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

    .form-control-custom {
        border: 2px solid var(--neutral-color);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .form-control-custom:focus {
        border-color: var(--secondary-color);
        box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
        outline: none;
    }

    .form-select-custom {
        border: 2px solid var(--neutral-color);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        background-color: white;
    }

    .form-select-custom:focus {
        border-color: var(--secondary-color);
        box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
        outline: none;
    }

    .btn-save-custom {
        background: linear-gradient(135deg, var(--secondary-color) 0%, rgba(23, 136, 202, 0.8) 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }

    .btn-save-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
        color: white;
    }

    .btn-cancel-custom {
        background: transparent;
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-cancel-custom:hover {
        background: var(--primary-color);
        color: white;
        transform: translateY(-1px);
    }

    .icon-primary {
        color: var(--secondary-color);
        font-size: 1.2rem;
        margin-right: 0.5rem;
    }

    .input-group-custom {
        position: relative;
    }

    .input-group-custom .currency-symbol {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--secondary-color);
        font-weight: 600;
        z-index: 3;
    }

    .input-group-custom .form-control-custom {
        padding-left: 2rem;
    }

    .help-text {
        color: #6c757d;
        font-style: italic;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .validation-error {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .section-divider {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, var(--neutral-color) 0%, var(--secondary-color) 50%, var(--neutral-color) 100%);
        margin: 2rem 0;
    }

    @@media (max-width: 768px) {
        .header-gradient {
            padding: 1.5rem 0;
        }

        .btn-group-custom {
            flex-direction: column;
        }

        .btn-group-custom .btn {
            margin-bottom: 0.5rem;
            width: 100%;
        }
    }
</style>

<div class="container-fluid">
    <!-- ENCABEZADO -->
    <div class="header-gradient">
        <div class="container">
            <h1 class="mb-2">
                <i class="fas fa-edit fa-2x"></i>
                Editar Liquidación
            </h1>
            <p class="mb-0 fs-5">Modifica los datos de la liquidación seleccionada</p>
        </div>
    </div>

    <div class="container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <!-- INFORMACIÓN BÁSICA -->
            <div class="card-custom">
                <div class="card-header-edit">
                    <h5 class="mb-0">
                        <i class="fas fa-user"></i>
                        Información Básica
                    </h5>
                </div>
                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.id_liquidacion)

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-user icon-primary"></i>
                                    Empleado
                                </label>
                                @Html.DropDownList("id_empleado", null, "Seleccione un empleado", new { @class = "form-select form-select-custom" })
                                @Html.ValidationMessageFor(model => model.id_empleado, "", new { @class = "validation-error" })
                                <div class="help-text">Empleado que será liquidado</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-tags icon-primary"></i>
                                    Tipo de Liquidación
                                </label>
                                @Html.DropDownList("id_tipo", null, "Seleccione tipo", new { @class = "form-select form-select-custom" })
                                @Html.ValidationMessageFor(model => model.id_tipo, "", new { @class = "validation-error" })
                                <div class="help-text">Motivo de la liquidación</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-calendar-times icon-primary"></i>
                                    Fecha de Salida
                                </label>
                                @Html.EditorFor(model => model.fecha_salida, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "date" } })
                                @Html.ValidationMessageFor(model => model.fecha_salida, "", new { @class = "validation-error" })
                                <div class="help-text">Último día laborado</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MONTOS DE LIQUIDACIÓN -->
            <div class="card-custom">
                <div class="card-header-edit">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator"></i>
                        Montos de Liquidación
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-bell icon-primary"></i>
                                    Preaviso
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.preaviso, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.preaviso, "", new { @class = "validation-error" })
                                <div class="help-text">Monto por preaviso</div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-handshake icon-primary"></i>
                                    Cesantía
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.cesantia, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.cesantia, "", new { @class = "validation-error" })
                                <div class="help-text">Monto por cesantía</div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-umbrella-beach icon-primary"></i>
                                    Vacaciones Pendientes
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.vacaciones_pendientes, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.vacaciones_pendientes, "", new { @class = "validation-error" })
                                <div class="help-text">Dinero por vacaciones no disfrutadas</div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-calendar-day icon-primary"></i>
                                    Días de Vacaciones
                                </label>
                                @Html.EditorFor(model => model.dias_vacaciones_pendientes, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @min = "0" } })
                                @Html.ValidationMessageFor(model => model.dias_vacaciones_pendientes, "", new { @class = "validation-error" })
                                <div class="help-text">Cantidad de días pendientes</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-gift icon-primary"></i>
                                    Aguinaldo Proporcional
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.aguinaldo_proporcional, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.aguinaldo_proporcional, "", new { @class = "validation-error" })
                                <div class="help-text">Aguinaldo proporcional al tiempo laborado</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-money-check-alt icon-primary"></i>
                                    Total Liquidación
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.total_liquidacion, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.total_liquidacion, "", new { @class = "validation-error" })
                                <div class="help-text">Monto total antes de deducciones</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DEDUCCIONES -->
            <div class="card-custom">
                <div class="card-header-edit">
                    <h5 class="mb-0">
                        <i class="fas fa-minus-circle"></i>
                        Deducciones de Liquidación
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-receipt icon-primary"></i>
                                    ISR Liquidación
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.isr_liquidacion, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.isr_liquidacion, "", new { @class = "validation-error" })
                                <div class="help-text">Impuesto sobre la Renta de liquidación</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-shield-alt icon-primary"></i>
                                    CCSS Liquidación
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.css_liquidacion, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.css_liquidacion, "", new { @class = "validation-error" })
                                <div class="help-text">Caja Costarricense de Seguro Social</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group-custom">
                                <label class="form-label-custom">
                                    <i class="fas fa-piggy-bank icon-primary"></i>
                                    IVM Liquidación
                                </label>
                                <div class="input-group-custom">
                                    <span class="currency-symbol">₡</span>
                                    @Html.EditorFor(model => model.ivm_liquidacion, new { htmlAttributes = new { @class = "form-control form-control-custom", @type = "number", @step = "0.01", @min = "0" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.ivm_liquidacion, "", new { @class = "validation-error" })
                                <div class="help-text">Invalidez, Vejez y Muerte</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="section-divider">

            <!-- BOTONES DE ACCIÓN -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="btn-group-custom">
                    @Html.ActionLink("Ver Detalles", "Details", new { id = Model.id_liquidacion }, new { @class = "btn btn-outline-info" })
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-cancel-custom" })
                </div>
                <div>
                    <button type="submit" class="btn btn-save-custom">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<script>
   // Calcular total automáticamente
   document.addEventListener('DOMContentLoaded', function() {
       const campos = ['preaviso', 'cesantia', 'vacaciones_pendientes', 'aguinaldo_proporcional'];
       const deducciones = ['isr_liquidacion', 'css_liquidacion', 'ivm_liquidacion'];

       function calcularTotal() {
           let total = 0;

           // Sumar todos los conceptos de liquidación
           campos.forEach(function(campo) {
               const valor = parseFloat(document.querySelector(`input[name="${campo}"]`).value) || 0;
               total += valor;
           });

           // Restar deducciones
           deducciones.forEach(function(deduccion) {
               const valor = parseFloat(document.querySelector(`input[name="${deduccion}"]`).value) || 0;
               total -= valor;
           });

           // Actualizar el campo total
           document.querySelector('input[name="total_liquidacion"]').value = total.toFixed(2);
       }

       // Agregar event listeners a todos los campos
       [...campos, ...deducciones].forEach(function(campo) {
           const elemento = document.querySelector(`input[name="${campo}"]`);
           if (elemento) {
               elemento.addEventListener('input', calcularTotal);
           }
       });
   });
</script>
