@model IEnumerable<SistemaNomina.Models.Asistencia>

@{
    ViewBag.Title = "Gestión de Asistencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .header-asistencia {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin: -15px -15px 30px -15px;
        border-radius: 0 0 15px 15px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .main-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        border: 1px solid #e7e8eb;
        overflow: hidden;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
        margin-right: 10px;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-accent-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-accent-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(250, 182, 27, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-warning-custom {
        background: linear-gradient(135deg, #fab61b 0%, #fab61b 100%);
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        color: white;
        font-size: 12px;
        transition: all 0.3s ease;
    }

        .btn-warning-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(250, 182, 27, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-info-custom {
        background: linear-gradient(135deg, #1788ca 0%, #1788ca 100%);
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        color: white;
        font-size: 12px;
        transition: all 0.3s ease;
    }

        .btn-info-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(23, 136, 202, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-danger-custom {
        background: linear-gradient(135deg, #dc3545 0%, #dc3545 100%);
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        color: white;
        font-size: 12px;
        transition: all 0.3s ease;
    }

        .btn-danger-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
            color: white;
            text-decoration: none;
        }

    .table-custom {
        border-radius: 0;
        margin-bottom: 0;
    }

        .table-custom thead th {
            background: #221d42;
            color: white;
            border: none;
            padding: 15px 12px;
            font-weight: 600;
            font-size: 14px;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid #e7e8eb;
        }

            .table-custom tbody tr:hover {
                background: rgba(23, 136, 202, 0.05);
            }

        .table-custom tbody td {
            padding: 12px;
            vertical-align: middle;
            border-top: none;
        }

    .status-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-completo {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
    }

    .status-sin-salida {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
    }

    .status-feriado {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
    }

    .quick-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border: 2px solid #e7e8eb;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(23, 136, 202, 0.15);
            border-color: #1788ca;
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #1788ca;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 500;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .header-asistencia {
            padding: 1.5rem 0;
            margin: -15px -15px 20px -15px;
        }

            .header-asistencia h2 {
                font-size: 1.5rem;
            }

        .action-buttons {
            flex-direction: column;
            gap: 2px;
        }

        .quick-stats {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>

<div class="container" style="max-width: 1200px;">
    <div class="header-asistencia">
        <div class="container">
            <h2 class="mb-0">
                <i class="fa fa-clock" style="font-size: 2rem; margin-right: 15px;"></i>
                Gestión de Asistencias
            </h2>
            <p class="mb-0 mt-2" style="opacity: 0.9;">Control y seguimiento de horarios laborales</p>
        </div>
    </div>

    <div class="quick-stats">
        <div class="stat-card">
            <div class="stat-number">@Model.Count()</div>
            <div class="stat-label">
                <i class="fa fa-list" style="margin-right: 5px;"></i>
                Total Registros
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.Count(x => x.hora_entrada.HasValue && x.hora_salida.HasValue)</div>
            <div class="stat-label">
                <i class="fa fa-check-circle" style="margin-right: 5px;"></i>
                Asistencias Completas
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.Count(x => x.es_feriado == true)</div>
            <div class="stat-label">
                <i class="fa fa-calendar" style="margin-right: 5px;"></i>
                Días Feriados
            </div>
        </div>
    </div>

    <div class="main-card">
        <div style="padding: 25px 25px 15px 25px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: #221d42; font-weight: 600; margin: 0;">
                    <i class="fa fa-list" style="margin-right: 10px; color: #1788ca;"></i>
                    Registros de Asistencia
                </h4>
                <div>
                    @Html.ActionLink("Marcar Asistencia", "Marcar", null, new { @class = "btn-accent-custom", style = "text-decoration: none;" })
                    @Html.ActionLink("Nueva Asistencia", "Create", null, new { @class = "btn-primary-custom", style = "text-decoration: none;" })
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table-custom table">
                <thead>
                    <tr>
                        <th><i class="fa fa-calendar" style="margin-right: 8px;"></i>Fecha</th>
                        <th><i class="fa fa-user" style="margin-right: 8px;"></i>Empleado</th>
                        <th><i class="fa fa-sign-in" style="margin-right: 8px;"></i>Entrada</th>
                        <th><i class="fa fa-sign-out" style="margin-right: 8px;"></i>Salida</th>
                        <th><i class="fa fa-clock" style="margin-right: 8px;"></i>Horas</th>
                        <th><i class="fa fa-toggle-on" style="margin-right: 8px;"></i>Estado</th>
                        <th><i class="fa fa-calendar-check" style="margin-right: 8px;"></i>Feriado</th>
                        <th><i class="fa fa-cogs" style="margin-right: 8px;"></i>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 500; color: #221d42;">
                                @item.fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td style="color: #495057;">
                                @item.Empleados.nombre1 @item.Empleados.apellido1
                                <br><small style="color: #6c757d;">@item.Empleados.cedula</small>
                            </td>
                            <td>
                                @if (item.hora_entrada.HasValue)
                                {
                                    <span style="font-family: monospace; font-weight: 600; color: #28a745;">
                                        @item.hora_entrada.Value.ToString(@"hh\:mm")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6c757d; font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_salida.HasValue)
                                {
                                    <span style="font-family: monospace; font-weight: 600; color: #dc3545;">
                                        @item.hora_salida.Value.ToString(@"hh\:mm")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6c757d; font-style: italic;">Sin marcar</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada.HasValue && item.hora_salida.HasValue)
                                {
                                    var horas = (item.hora_salida.Value - item.hora_entrada.Value).TotalHours;
                                    <span style="font-weight: 600; color: #1788ca;">
                                        @Math.Round(horas, 2) hrs
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6c757d;">-</span>
                                }
                            </td>
                            <td>
                                @if (item.hora_entrada.HasValue && item.hora_salida.HasValue)
                                {
                                    <span class="status-badge status-completo">Completo</span>
                                }
                                else if (item.hora_entrada.HasValue)
                                {
                                    <span class="status-badge status-sin-salida">Sin Salida</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%); color: #721c24;">Sin Entrada</span>
                                }
                            </td>
                            <td>
                                @if (item.es_feriado == true)
                                {
                                    <span class="status-badge status-feriado">
                                        @(item.Feriados != null ? item.Feriados.nombre : "Feriado")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6c757d;">-</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @Html.ActionLink("Editar", "Edit", new { id = item.id_asistencia }, new { @class = "btn-warning-custom", style = "text-decoration: none;" })
                                    @Html.ActionLink("Detalles", "Details", new { id = item.id_asistencia }, new { @class = "btn-info-custom", style = "text-decoration: none;" })
                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.id_asistencia }, new { @class = "btn-danger-custom", style = "text-decoration: none;" })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="padding: 15px 25px;">
            <p style="color: #6c757d; font-style: italic; margin: 0; font-size: 14px;">
                <i class="fa fa-info-circle" style="margin-right: 5px;"></i>
                Total de registros de asistencia: @Model.Count()
            </p>
        </div>
    </div>
</div>