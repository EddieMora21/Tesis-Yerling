@model SistemaNomina.ISR
@{
    ViewBag.Title = "Eliminar Tramo ISR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #e74c3c;
        --danger-soft: #f8d7da;
        --warning-color: #fd7e14;
        --warning-soft: #fff3cd;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .page-header-custom {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        color: var(--white);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        box-shadow: var(--shadow-main);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .warning-card {
        background: linear-gradient(135deg, var(--warning-soft) 0%, #ffeaa7 100%);
        border-left: 4px solid var(--warning-color);
        border-radius: var(--border-radius);
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-main);
        border: 1px solid #ffc107;
    }

    .card-custom {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        border: 1px solid var(--neutral-color);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: flex-start;
        padding: 1rem 0;
        border-bottom: 1px solid var(--neutral-color);
        transition: var(--transition);
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background: rgba(23, 136, 202, 0.03);
            border-radius: var(--border-radius-sm);
            margin: 0 -1rem;
            padding-left: 2rem;
            padding-right: 2rem;
        }

    .detail-label {
        font-weight: 600;
        color: var(--primary-color);
        min-width: 220px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        flex: 1;
        color: var(--text-color);
        font-size: 1.1rem;
    }

        .detail-value strong {
            color: var(--primary-color);
        }

    .badge-year {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        color: var(--white);
        padding: 12px 20px;
        border-radius: 25px;
        font-size: 1.3rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .badge-percentage {
        background: linear-gradient(135deg, var(--success-color) 0%, #20a53a 100%);
        color: var(--white);
        padding: 10px 16px;
        border-radius: 25px;
        font-size: 1.2rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .currency-highlight {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        color: var(--secondary-color);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 1.1rem;
        font-weight: 600;
        border: 2px solid var(--secondary-color);
        display: inline-block;
    }

    .date-badge {
        background: linear-gradient(135deg, var(--neutral-color) 0%, #d6d8db 100%);
        color: var(--text-muted);
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-block;
    }

    .description-box {
        background: #f8f9fa;
        border-left: 4px solid var(--warning-color);
        padding: 1.5rem;
        border-radius: var(--border-radius-sm);
        font-style: italic;
        line-height: 1.6;
        margin-top: 1rem;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, var(--danger-color) 0%, #c0392b 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 14px 28px;
        font-weight: 600;
        color: var(--white);
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 1rem;
        font-size: 1rem;
    }

        .btn-danger-custom:hover {
            background: linear-gradient(135deg, #c0392b 0%, #a93226 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(231, 76, 60, 0.3);
            color: var(--white);
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 14px 28px;
        font-weight: 600;
        color: var(--white);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 1rem;
    }

        .btn-secondary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 117, 125, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .warning-icon {
        font-size: 3.5rem;
        color: var(--warning-color);
        text-align: center;
        margin-bottom: 1.5rem;
        animation: gentle-pulse 3s infinite;
    }

    @@keyframes gentle-pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.02);
            opacity: 0.9;
        }
    }

    .confirmation-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: var(--border-radius);
        padding: 2rem;
        border: 2px dashed var(--danger-color);
        margin-top: 1.5rem;
    }

    .alert-danger-soft {
        background: linear-gradient(135deg, var(--danger-soft) 0%, #f5c6cb 100%);
        border-left: 4px solid var(--danger-color);
        padding: 1.5rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 2rem;
    }

    .alert-info-soft {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        border-left: 4px solid var(--secondary-color);
        padding: 1.5rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .page-header-custom {
            padding: 1.5rem 0;
        }

            .page-header-custom h1 {
                font-size: 1.8rem;
            }

        .warning-card,
        .card-custom {
            padding: 1.5rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            min-width: auto;
            margin-bottom: 0.5rem;
        }

        .btn-danger-custom,
        .btn-secondary-custom {
            width: 100%;
            margin-bottom: 0.5rem;
            justify-content: center;
            margin-right: 0;
        }
    }
</style>

<!-- Header de la página -->
<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-exclamation-triangle" style="font-size: 2rem; margin-right: 15px;"></i>
                    Eliminar Tramo ISR
                </h1>
                <p class="mb-0" style="opacity: 0.9; margin-top: 0.5rem;">
                    Confirme la eliminación del tramo fiscal seleccionado
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Contenido principal -->
<div class="container" style="max-width: 1000px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Advertencia principal -->
            <div class="warning-card">
                <div class="warning-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h4 class="text-center" style="color: var(--primary-color); font-weight: 600; margin-bottom: 1rem;">
                    Confirmación de Eliminación Requerida
                </h4>
                <p class="mb-0 text-center" style="color: var(--text-color); font-size: 1.1rem; line-height: 1.6;">
                    Está a punto de eliminar permanentemente este tramo de ISR. Esta acción no se puede deshacer y podría afectar los cálculos de nómina existentes.
                </p>
            </div>

            <!-- Información del registro a eliminar -->
            <div class="card-custom">
                <h4 style="color: var(--primary-color); margin-bottom: 1.5rem; font-weight: 600;">
                    <i class="fas fa-info-circle"></i>
                    Información del Tramo ISR a Eliminar
                </h4>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-alt"></i>
                        Año Fiscal
                    </div>
                    <div class="detail-value">
                        <span class="badge-year">
                            <i class="fas fa-calendar"></i>
                            @Html.DisplayFor(model => model.anio)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-arrows-alt-h"></i>
                        Rango Salarial
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.limite_inferior) - ¢@Html.DisplayFor(model => model.limite_superior)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-percentage"></i>
                        Porcentaje de Impuesto
                    </div>
                    <div class="detail-value">
                        <span class="badge-percentage">
                            <i class="fas fa-calculator"></i>
                            @Html.DisplayFor(model => model.porcentaje)%
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-plus-circle"></i>
                        Exceso Base
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.exceso)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-child"></i>
                        Crédito por Hijo
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.credito_hijo)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-heart"></i>
                        Crédito por Cónyuge
                    </div>
                    <div class="detail-value">
                        <span class="currency-highlight">
                            ¢@Html.DisplayFor(model => model.credito_conyuge)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-plus"></i>
                        Fecha de Creación
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_creacion)
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">
                        <i class="fas fa-calendar-edit"></i>
                        Última Actualización
                    </div>
                    <div class="detail-value">
                        <span class="date-badge">
                            @Html.DisplayFor(model => model.fecha_actualizacion)
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.descripcion))
                {
                    <div class="description-box">
                        <strong>Descripción:</strong><br>
                        @Html.DisplayFor(model => model.descripcion)
                    </div>
                }

                <!-- Formulario de confirmación -->
                <div class="confirmation-section">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="text-center">
                            <h5 style="color: var(--danger-color); margin-bottom: 1.5rem; font-weight: 600;">
                                <i class="fas fa-question-circle"></i>
                                ¿Confirma que desea proceder con la eliminación?
                            </h5>

                            <button type="submit" class="btn btn-danger-custom">
                                <i class="fas fa-trash"></i>
                                Confirmar Eliminación
                            </button>

                            @Html.ActionLink("Cancelar Operación", "Index", null, new
                            {
                                @class = "btn-secondary-custom"
                            })
                        </div>
                    }
                </div>
            </div>

            <!-- Información sobre las consecuencias -->
            <div class="alert-danger-soft">
                <h6 style="color: #721c24; margin-bottom: 1rem; font-weight: 600;">
                    <i class="fas fa-exclamation-circle"></i>
                    Impacto de la Eliminación
                </h6>
                <ul class="mb-0" style="font-size: 0.9rem; color: #721c24; line-height: 1.6;">
                    <li><strong>Cálculos de nómina:</strong> Los empleados en este rango salarial se verán afectados</li>
                    <li><strong>Reportes fiscales:</strong> Los reportes históricos pueden mostrar inconsistencias</li>
                    <li><strong>Cumplimiento legal:</strong> Verifique que este tramo ya no sea requerido por ley</li>
                    <li><strong>Acción permanente:</strong> Esta operación no se puede revertir</li>
                </ul>
            </div>

            <!-- Información de ayuda -->
            <div class="alert-info-soft">
                <h6 style="color: var(--primary-color); margin-bottom: 1rem; font-weight: 600;">
                    <i class="fas fa-lightbulb"></i>
                    Recomendaciones Antes de Eliminar
                </h6>
                <ul class="mb-0" style="font-size: 0.9rem; color: var(--text-color); line-height: 1.6;">
                    <li>Verifique que no hay empleados activos en este rango salarial</li>
                    <li>Consulte con el departamento contable antes de proceder</li>
                    <li>Considere crear un nuevo tramo si este quedó obsoleto</li>
                    <li>Mantenga un respaldo de los datos fiscales importantes</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Confirmación adicional más suave
            $('form').on('submit', function(e) {
                var confirmText = '¿Está seguro de que desea eliminar este tramo de ISR?\n\n';
                confirmText += 'Tramo: Año @Html.DisplayFor(model => model.anio)\n';
                confirmText += 'Rango: ¢@Html.DisplayFor(model => model.limite_inferior) - ¢@Html.DisplayFor(model => model.limite_superior)\n';
                confirmText += 'Porcentaje: @Html.DisplayFor(model => model.porcentaje)%\n\n';
                confirmText += 'Esta acción no se puede deshacer.';

                if (!confirm(confirmText)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}