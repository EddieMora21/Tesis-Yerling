@model IEnumerable<SistemaNomina.Models.TipoLiquidacion>

@{
    ViewBag.Title = "Tipos de Liquidación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-file-contract me-2"></i>
                            Gestión de Tipos de Liquidación
                        </h4>
                        <a href="@Url.Action("Create")" class="btn btn-light btn-sm">
                            <i class="fas fa-plus me-1"></i>
                            Nuevo Tipo
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-hover table-striped table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>
                                            <i class="fas fa-tag me-1"></i>
                                            @Html.DisplayNameFor(model => model.nombre)
                                        </th>
                                        <th>
                                            <i class="fas fa-info-circle me-1"></i>
                                            @Html.DisplayNameFor(model => model.descripcion)
                                        </th>
                                        <th>
                                            <i class="fas fa-calendar-plus me-1"></i>
                                            @Html.DisplayNameFor(model => model.fecha_creacion)
                                        </th>
                                        <th>
                                            <i class="fas fa-calendar-edit me-1"></i>
                                            @Html.DisplayNameFor(model => model.fecha_actualizacion)
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-cogs"></i>
                                            Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.nombre)</strong>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.descripcion)
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @Html.DisplayFor(modelItem => item.fecha_creacion)
                                                </small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @Html.DisplayFor(modelItem => item.fecha_actualizacion)
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = item.id_tipo })"
                                                       class="btn btn-info btn-sm" title="Ver Detalles">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = item.id_tipo })"
                                                       class="btn btn-warning btn-sm" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", new { id = item.id_tipo })"
                                                       class="btn btn-danger btn-sm" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No hay tipos de liquidación registrados</h5>
                            <p class="text-muted">Comienza creando el primer tipo de liquidación</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>
                                Crear Primer Tipo
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>