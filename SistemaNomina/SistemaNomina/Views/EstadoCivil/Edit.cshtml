@model SistemaNomina.EstadoCivil

@{
    ViewBag.Title = "Editar Estado Civil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 15px 15px;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .form-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(34, 29, 66, 0.1);
        overflow: hidden;
        border: 1px solid #e7e8eb;
    }

    .form-header {
        background: linear-gradient(135deg, #fab61b 0%, #e09f15 100%);
        padding: 1.5rem;
        border-bottom: 1px solid #e7e8eb;
        color: #221d42;
    }

        .form-header h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
        }

    .form-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: #221d42;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control-custom {
        border: 2px solid #e7e8eb;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: white;
    }

        .form-control-custom:focus {
            border-color: #fab61b;
            box-shadow: 0 0 0 0.2rem rgba(250, 182, 27, 0.25);
            outline: none;
            background: white;
        }

    .btn-warning-custom {
        background: linear-gradient(135deg, #fab61b 0%, #e09f15 100%);
        border: none;
        color: #221d42;
        font-weight: 600;
        padding: 12px 30px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-warning-custom:hover {
            background: linear-gradient(135deg, #e09f15 0%, #c8890f 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(250, 182, 27, 0.4);
            color: #221d42;
        }

    .btn-secondary-custom {
        background: #e7e8eb;
        border: 2px solid #e7e8eb;
        color: #221d42;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-custom:hover {
            background: #d6d8db;
            border-color: #d6d8db;
            color: #221d42;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .text-danger-custom {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        font-weight: 500;
    }

    .button-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e7e8eb;
    }

    .help-text {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.25rem;
        font-style: italic;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem 0;
        }

        .page-title {
            font-size: 1.6rem;
        }

        .form-body {
            padding: 1.5rem;
        }

        .button-group {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-warning-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-edit me-3"></i>
            Editar Estado Civil
        </h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card">
                <div class="form-header">
                    <h4>
                        <i class="fas fa-heart me-2"></i>
                        Actualizar Estado Civil
                    </h4>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-body">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        @Html.HiddenFor(model => model.id_estado_civil)

                        <div class="form-group">
                            @Html.LabelFor(model => model.nombre, "Nombre del Estado Civil", new { @class = "form-label" })
                            @Html.EditorFor(model => model.nombre, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Ej: Soltero, Casado, Divorciado, Viudo" } })
                            <div class="help-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Modifique el nombre del estado civil según sea necesario
                            </div>
                            @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger-custom" })
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn-warning-custom">
                                <i class="fas fa-save"></i>
                                Guardar Cambios
                            </button>
                            <a href="@Url.Action("Index")" class="btn-secondary-custom">
                                <i class="fas fa-arrow-left"></i>
                                Cancelar
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}