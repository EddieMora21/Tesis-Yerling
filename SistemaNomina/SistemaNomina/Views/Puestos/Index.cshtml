@model IEnumerable<SistemaNomina.Puestos>

@{
    ViewBag.Title = "Puestos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #221d42;
        --secondary-color: #1788ca;
        --accent-color: #fab61b;
        --neutral-color: #e7e8eb;
        --white: #ffffff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #fd7e14;
        --text-color: #495057;
        --text-muted: #6c757d;
        --border-radius: 15px;
        --border-radius-sm: 8px;
        --shadow-main: 0 8px 32px rgba(34, 29, 66, 0.1);
        --transition: all 0.3s ease;
    }

    .page-header-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: var(--white);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        box-shadow: var(--shadow-main);
    }

        .page-header-custom h1 {
            margin: 0;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    .card-custom {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-main);
        border: 1px solid var(--neutral-color);
        overflow: hidden;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.1);
        border-left: 4px solid var(--success-color);
        color: #155724;
        padding: 1rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-error {
        background: rgba(220, 53, 69, 0.1);
        border-left: 4px solid var(--danger-color);
        color: #721c24;
        padding: 1rem;
        border-radius: var(--border-radius-sm);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--secondary-color) 0%, #0f6da3 100%);
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        font-weight: 600;
        color: var(--white);
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(23, 136, 202, 0.4);
            color: var(--white);
            text-decoration: none;
        }

    .search-container {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 250px;
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid var(--neutral-color);
        border-radius: var(--border-radius-sm);
        font-size: 1rem;
        transition: var(--transition);
    }

        .search-input:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 0.2rem rgba(23, 136, 202, 0.25);
            outline: none;
        }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1rem;
    }

    .counter-badge {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        color: var(--white);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .table-custom {
        margin: 0;
    }

        .table-custom thead {
            background: var(--primary-color);
            color: var(--white);
        }

            .table-custom thead th {
                border: none;
                padding: 1rem;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.875rem;
                letter-spacing: 0.5px;
                white-space: nowrap;
            }

        .table-custom tbody tr {
            transition: var(--transition);
        }

            .table-custom tbody tr:hover {
                background-color: rgba(23, 136, 202, 0.05);
            }

        .table-custom td {
            padding: 1rem;
            border-color: var(--neutral-color);
            vertical-align: middle;
        }

    .job-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .job-avatar {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--primary-color) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        font-size: 1rem;
        font-weight: 600;
    }

    .job-details h6 {
        margin: 0;
        font-weight: 600;
        color: var(--primary-color);
    }

    .job-dept {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin: 0;
    }

    .salary-badge {
        background: linear-gradient(135deg, var(--success-color) 0%, #20a53a 100%);
        color: var(--white);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .hours-badge {
        background: rgba(23, 136, 202, 0.1);
        color: var(--secondary-color);
        padding: 0.25rem 0.75rem;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .boss-badge {
        background: linear-gradient(135deg, var(--accent-color) 0%, #e09f15 100%);
        color: var(--white);
        padding: 0.25rem 0.75rem;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .employee-badge {
        background: rgba(108, 117, 125, 0.1);
        color: var(--text-muted);
        padding: 0.25rem 0.75rem;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--neutral-color);
        }

    /* === BOTONES DE ACCIONES (ESTÁNDAR) === */
    .action-buttons {
        display: flex;
        gap: 4px;
        justify-content: center;
        flex-wrap: nowrap;
        min-width: 210px;
    }

    .btn-action {
        padding: 8px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        border: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-width: 65px;
        justify-content: center;
        white-space: nowrap;
    }

    .btn-view {
        background: linear-gradient(135deg, var(--secondary-color), #0f6da3);
        color: var(--white);
    }

    .btn-view:hover {
        background: linear-gradient(135deg, #0f6da3, #0c5a87);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(23, 136, 202, 0.3);
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--accent-color), #e09f15);
        color: var(--primary-color);
    }

    .btn-edit:hover {
        background: linear-gradient(135deg, #e09f15, #d18c00);
        color: var(--primary-color);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(250, 182, 27, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--danger-color), #c82333);
        color: var(--white);
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, #c82333, #bd2130);
        color: var(--white);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

    /* === RESPONSIVE DESIGN === */
    @@media (max-width: 1200px) {
        .action-buttons {
            min-width: 190px;
        }

        .btn-action {
            min-width: 60px;
            padding: 6px 10px;
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 992px) {
        .table-custom thead th {
            padding: 1rem 0.7rem;
            font-size: 0.85rem;
        }

        .table-custom tbody td {
            padding: 0.8rem 0.7rem;
        }

        .action-buttons {
            min-width: 170px;
            gap: 3px;
        }

        .btn-action {
            min-width: 55px;
            padding: 6px 8px;
            font-size: 0.7rem;
        }

        .btn-action .btn-text {
            display: none; /* Oculta el texto, solo muestra iconos */
        }
    }

    @@media (max-width: 768px) {
        .btn-primary-custom {
            padding: 10px 20px;
            font-size: 0.875rem;
        }

        .page-header-custom {
            padding: 1.5rem 0;
        }

        .search-container {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            min-width: auto;
        }

        .job-info {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
        }

        .action-buttons {
            min-width: 160px;
            gap: 2px;
        }

        .btn-action {
            min-width: 50px;
            padding: 5px 6px;
            font-size: 0.7rem;
        }

        .btn-action i {
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .hidden-mobile {
            display: none;
        }

        .action-buttons {
            flex-direction: column;
            min-width: 80px;
            gap: 2px;
        }

        .btn-action {
            width: 100%;
            min-width: auto;
            padding: 4px;
            font-size: 0.65rem;
        }
    }

    /* Scroll horizontal personalizado */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--secondary-color);
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: var(--primary-color);
    }
</style>

<!-- Mensajes de alerta -->
@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="page-header-custom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 style="color:white"><i class="fas fa-briefcase"></i> Gestión de Puestos</h1>
                <p class="mb-0">Administra los puestos de trabajo de la organización</p>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1400px;">
    <div class="row justify-content-center">
        <div class="col-12">
            <!-- Barra de búsqueda y acciones -->
            <div class="search-container">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Buscar puestos por nombre, departamento o descripción...">
                </div>
                <div class="counter-badge">
                    <i class="fas fa-hashtag"></i>
                    Total: <span id="totalCount">@(Model?.Count() ?? 0)</span>
                </div>
                @Html.ActionLink("Nuevo Puesto", "Create", null, new { @class = "btn-primary-custom" })
            </div>

            <div class="card-custom">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center p-4 border-bottom" style="border-color: var(--neutral-color) !important;">
                        <h4 class="mb-0" style="color: var(--primary-color); font-weight: 600;">
                            <i class="fas fa-list-alt"></i> Lista de Puestos
                        </h4>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-custom table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-briefcase mr-2"></i>Puesto</th>
                                        <th>Salario</th>
                                        <th class="hidden-mobile"><i class="fas fa-align-left mr-2"></i>Descripción</th>
                                        <th class="hidden-mobile"><i class="fas fa-clock mr-2"></i>Horas</th>
                                        <th><i class="fas fa-crown mr-2"></i>Jefatura</th>
                                        <th class="text-center"><i class="fas fa-cogs mr-2"></i>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="puestosTableBody">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="puesto-row">
                                            <td>
                                                <div class="job-info">
                                                    <div class="job-avatar">
                                                        <i class="fas fa-briefcase"></i>
                                                    </div>
                                                    <div class="job-details">
                                                        <h6 class="job-name">@Html.DisplayFor(modelItem => item.nombre_puesto)</h6>
                                                        <p class="job-dept">@Html.DisplayFor(modelItem => item.Departamentos.nombre)</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="salary-badge">
                                                    ₡@Html.DisplayFor(modelItem => item.salario_base)
                                                </div>
                                            </td>
                                            <td class="hidden-mobile">
                                                @if (!string.IsNullOrEmpty(item.descripcion))
                                                {
                                                    <span title="@item.descripcion">
                                                        @(item.descripcion.Length > 50 ? item.descripcion.Substring(0, 50) + "..." : item.descripcion)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--text-muted); font-style: italic;">Sin descripción</span>
                                                }
                                            </td>
                                            <td class="hidden-mobile">
                                                <div class="hours-badge">
                                                    <i class="fas fa-clock"></i>
                                                    @Html.DisplayFor(modelItem => item.horas_jornada) hrs
                                                </div>
                                            </td>
                                            <td>
                                                @if (item.es_jefe == true)
                                                {
                                                    <span class="boss-badge">
                                                        <i class="fas fa-crown"></i> Jefe
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="employee-badge">
                                                        <i class="fas fa-user"></i> Empleado
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="@Url.Action("Details", new { id = item.id_puesto })"
                                                       class="btn-action btn-view"
                                                       title="Ver detalles">
                                                        <i class="fas fa-eye"></i>
                                                        <span class="btn-text">Ver</span>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = item.id_puesto })"
                                                       class="btn-action btn-edit"
                                                       title="Editar puesto">
                                                        <i class="fas fa-edit"></i>
                                                        <span class="btn-text">Editar</span>
                                                    </a>
                                                    <a href="@Url.Action("Delete", new { id = item.id_puesto })"
                                                       class="btn-action btn-delete"
                                                       title="Eliminar puesto"
                                                       onclick="return confirm('¿Está seguro de que desea eliminar este puesto?');">
                                                        <i class="fas fa-trash"></i>
                                                        <span class="btn-text">Eliminar</span>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-briefcase"></i>
                            <h5 style="color: var(--primary-color); margin-bottom: 1rem;">No hay puestos registrados</h5>
                            <p style="margin-bottom: 2rem;">Comienza creando el primer puesto de trabajo para la organización.</p>
                            @Html.ActionLink("Crear Primer Puesto", "Create", null, new { @class = "btn-primary-custom" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Búsqueda en tiempo real
            $('#searchInput').on('keyup', function () {
                var searchTerm = $(this).val().toLowerCase();
                var visibleCount = 0;

                $('.puesto-row').each(function () {
                    var jobName = $(this).find('.job-name').text().toLowerCase();
                    var deptName = $(this).find('.job-dept').text().toLowerCase();
                    var description = $(this).find('td:nth-child(3)').text().toLowerCase();

                    if (jobName.includes(searchTerm) || deptName.includes(searchTerm) || description.includes(searchTerm)) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });

                // Actualizar contador
                $('#totalCount').text(visibleCount);

                // Mostrar mensaje si no hay resultados
                if (visibleCount === 0 && searchTerm !== '') {
                    if ($('#noResults').length === 0) {
                        $('#puestosTableBody').append(`
                                <tr id="noResults">
                                    <td colspan="6" class="empty-state">
                                        <i class="fas fa-search"></i>
                                        <h5 style="color: var(--primary-color); margin-bottom: 1rem;">No se encontraron resultados</h5>
                                        <p>Intenta con otro término de búsqueda</p>
                                    </td>
                                </tr>
                            `);
                    }
                } else {
                    $('#noResults').remove();
                }
            });

            // Animación de entrada para las filas
            $('.puesto-row').each(function (index) {
                $(this).css({
                    'opacity': '0',
                    'transform': 'translateY(20px)'
                });

                setTimeout(() => {
                    $(this).css({
                        'transition': 'all 0.3s ease',
                        'opacity': '1',
                        'transform': 'translateY(0)'
                    });
                }, index * 100);
            });

            // Confirmación para eliminar
            $('.btn-delete').on('click', function (e) {
                var jobName = $(this).closest('tr').find('.job-name').text();
                if (!confirm(`¿Estás seguro de que deseas eliminar el puesto "${jobName}"?\n\nEsta acción no se puede deshacer.`)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}