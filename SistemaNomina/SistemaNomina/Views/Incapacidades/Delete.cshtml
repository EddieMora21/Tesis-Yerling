    border-left-color: #ffc107;
    color: #856404;
}

.alert-custom i {
    font-size: 1.2rem;
    margin-right: 0.75rem;
    margin-top: 0.1rem;
}

.alert-content {
    flex: 1;
}

/* Card de eliminación */
.delete-card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(220, 53, 69, 0.15);
    border: 2px solid #f8d7da;
    overflow: hidden;
    margin-bottom: 2rem;
}

.delete-card-header {
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    padding: 1.5rem 2rem;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.delete-card-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
}

.record-id {
    background: rgba(255,255,255,0.2);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
}

.delete-card-body {
    padding: 2rem;
}

/* Secciones */
.employee-section,
.details-section,
.description-section,
.consequences-section {
    margin-bottom: 2.5rem;
}

.employee-section h4,
.details-section h4,
.description-section h4,
.consequences-section h4 {
    color: #221d42;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e7e8eb;
}

/* Tarjeta del empleado */
.employee-card {
    display: flex;
    align-items: center;
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 12px;
    border-left: 4px solid #dc3545;
}

.employee-avatar {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 600;
    margin-right: 1.5rem;
    flex-shrink: 0;
}

.employee-info h5 {
    color: #dc3545;
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 600;
}

.employee-info p {
    margin: 0.25rem 0;
    color: #6c757d;
    font-size: 0.9rem;
}

/* Grid de detalles */
.details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
}

.detail-item {
    background: #f8f9fa;
    border: 1px solid #e7e8eb;
    border-radius: 8px;
    padding: 1rem;
    border-left: 4px solid #dc3545;
}

.detail-label {
    font-weight: 600;
    color: #495057;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.detail-value {
    color: #221d42;
    font-weight: 500;
    font-size: 0.95rem;
}

/* Badges personalizados */
.badge-info {
    background: linear-gradient(135deg, #1788ca 0%, #0d6efd 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

.badge-success {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

.badge-warning {
    background: linear-gradient(135deg, #fab61b 0%, #e69500 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

.badge-danger {
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

.badge-primary {
    background: linear-gradient(135deg, #221d42 0%, #1788ca 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

.badge-secondary {
    background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.8rem;
}

/* Caja de descripción */
.description-box {
    background: #f8f9fa;
    border: 1px solid #e7e8eb;
    border-left: 4px solid #1788ca;
    border-radius: 8px;
    padding: 1.5rem;
    font-style: italic;
    color: #495057;
    font-size: 1rem;
}

/* Sección de consecuencias */
.consequences-section h4 {
    color: #dc3545;
    border-bottom-color: #f8d7da;
}

.consequences-list {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 8px;
    padding: 1.5rem;
}

.consequence-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: white;
    border-radius: 6px;
    border-left: 3px solid #dc3545;
}

.consequence-item:last-child {
    margin-bottom: 0;
}

.consequence-item.warning {
    border-left-color: #ffc107;
    background: #fff3cd;
}

.consequence-item i {
    font-size: 1.1rem;
    margin-top: 0.1rem;
}

.consequence-item span {
    font-size: 0.9rem;
    color: #495057;
    line-height: 1.4;
}

.text-danger {
    color: #dc3545 !important;
}

.text-warning {
    color: #ffc107 !important;
}

.text-muted {
    color: #6c757d !important;
}

/* Sección de confirmación */
.confirmation-section {
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}

/* Checkbox personalizado */
.checkbox-container {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
}

.checkbox-container input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
}

.checkmark {
    position: relative;
    height: 20px;
    width: 20px;
    background-color: #fff;
    border: 2px solid #dc3545;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 2px;
}

.checkbox-container:hover input ~ .checkmark {
    background-color: #f8f9fa;
}

.checkbox-container input:checked ~ .checkmark {
    background-color: #dc3545;
    border-color: #dc3545;
}

.checkmark:after {
    content: "";
    position: absolute;
    display: none;
}

.checkbox-container input:checked ~ .checkmark:after {
    display: block;
}

.checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 6px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}

.checkbox-text {
    color: #495057;
    font-weight: 500;
}

/* Acciones del formulario */
.form-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e7e8eb;
    flex-wrap: wrap;
}

/* Botones personalizados */
.btn-danger-custom {
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 180px;
    justify-content: center;
}

.btn-danger-custom:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
    text-decoration: none;
    color: white;
}

.btn-danger-custom:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.btn-info-custom {
    background: linear-gradient(135deg, #1788ca 0%, #0d6efd 100%);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 150px;
    justify-content: center;
}

.btn-info-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(23, 136, 202, 0.3);
    text-decoration: none;
    color: white;
}

.btn-secondary-custom {
    background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 150px;
    justify-content: center;
}

.btn-secondary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
    text-decoration: none;
    color: white;
}

/* Responsive */
@@media (max-width: 768px) {
    .page-header-gradient {
        padding: 1.5rem 0;
    }

    .page-header-gradient h1 {
        font-size: 1.5rem;
    }

    .header-subtitle {
        font-size: 1rem;
    }

    .main-container {
        padding: 0 10px;
    }

    .delete-card-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }

    .employee-card {
        flex-direction: column;
        text-align: center;
    }

    .employee-avatar {
        margin-right: 0;
        margin-bottom: 1rem;
    }

    .details-grid {
        grid-template-columns: 1fr;
    }

    .form-actions {
        flex-direction: column;
        align-items: center;
    }

    .btn-danger-custom,
    .btn-info-custom,
    .btn-secondary-custom {
        width: 100%;
        max-width: 250px;
        margin-bottom: 0.5rem;
    }

    .consequence-item {
        flex-direction: column;
        gap: 0.5rem;
    }

    .checkbox-container {
        flex-direction: row;
        align-items: flex-start;
    }
}

@@media (max-width: 576px) {
    .delete-card-body {
        padding: 1.5rem;
    }

    .detail-item {
        padding: 0.75rem;
    }

    .consequences-list {
        padding: 1rem;
    }

    .consequence-item {
        padding: 0.5rem;
    }

    .confirmation-section {
        padding: 1rem;
    }
}
</style>

<script>
    // JavaScript CORREGIDO - SIN CONFLICTOS
    document.addEventListener('DOMContentLoaded', function () {
        const checkbox = document.getElementById('confirmarEliminacion');
        const btnEliminar = document.getElementById('btnEliminar');
        const formulario = document.getElementById('formEliminar');

        // Habilitar/deshabilitar botón según checkbox
        checkbox.addEventListener('change', function () {
            btnEliminar.disabled = !this.checked;
        });

        // Manejar envío del formulario
        formulario.addEventListener('submit', function (e) {
            // Verificar checkbox
            if (!checkbox.checked) {
                e.preventDefault();
                alert('❌ Debe confirmar que entiende las consecuencias antes de eliminar.');
                return false;
            }

            // Confirmación final
            const confirmacion = confirm(
                '⚠️ CONFIRMACIÓN FINAL\n\n' +
                'Está a punto de eliminar permanentemente este registro de incapacidad.\n\n' +
                '¿Está completamente seguro de continuar?\n\n' +
                'Esta acción NO se puede deshacer.'
            );

            if (!confirmacion) {
                e.preventDefault();
                return false;
            }

            // Mostrar indicador de carga SOLO si se confirma
            btnEliminar.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Eliminando...';
            btnEliminar.disabled = true;

            // Permitir que el formulario se envíe normalmente
            return true;
        });
    });
</script>